package components

import (
	"ztatic-go-framework/fullstack"
	"github.com/labstack/echo/v5"
)

templ Dashboard(c *echo.Context) {
	if fullstack.IsTurboFrame(c) {
		@DashboardContent()
	} else {
		@Layout("Dashboard Storage") {
			@DashboardContent()
		}
	}
}

templ DashboardContent() {
	<div id="dashboard-content" class="h-full flex flex-col" x-data>
		
		<!-- ACTION BAR & BREADCRUMBS -->
		<div class="h-14 border-b border-white/[0.08] px-6 flex items-center justify-between hornetz-glass shrink-0 relative z-20">
			<!-- Breadcrumbs Path -->
			<div class="flex items-center gap-2 text-xs font-mono">
				<span class="text-[#F5CE0D] font-bold cursor-pointer hover:underline" @click="$store.drive.setTab('storage')">Penyimpanan Saya</span>
				<span class="text-[#86898B]/60">\</span>
				<span 
					:class="[
						$store.drive.currentFolderId ? 'text-[#F5CE0D] cursor-pointer font-semibold hover:underline' : 'text-white font-semibold',
						$store.drive.dragTargetFolderId === 'root' ? 'bg-[#F5CE0D]/20 px-2 py-0.5 rounded border border-[#F5CE0D] text-white font-bold' : ''
					]"
					@click="if ($store.drive.currentFolderId) $store.drive.clearFolder()"
					@dragover.prevent.stop="$store.drive.handleFolderDragOver($event, { id: 'root', name: 'Utama' })"
					@dragleave.prevent.stop="$store.drive.handleFolderDragLeave($event, { id: 'root' })"
					@drop.prevent.stop="$store.drive.handleFolderDrop($event, { id: 'root', name: 'Utama' })"
					x-text="
						$store.drive.activeTab === 'storage' ? 'Penyimpanan Utama' : 
						($store.drive.activeTab === 'vault' ? 'Vault Terenkripsi' : 
						($store.drive.activeTab === 'recent' ? 'Berkas Terbaru' : 
						($store.drive.activeTab === 'starred' ? 'Berbintang' : 'Sampah')))
					"
				>Utama</span>
				<template x-for="(crumb, idx) in $store.drive.folderHistory" :key="crumb.id">
					<span class="flex items-center gap-2">
						<span class="text-[#86898B]/60">\</span>
						<span 
							:class="[
								idx === $store.drive.folderHistory.length - 1 ? 'text-white font-bold' : 'text-[#F5CE0D] cursor-pointer hover:underline font-semibold',
								$store.drive.dragTargetFolderId === crumb.id ? 'bg-[#F5CE0D]/20 px-2 py-0.5 rounded border border-[#F5CE0D] text-white font-bold' : ''
							]" 
							@click="if (idx < $store.drive.folderHistory.length - 1) $store.drive.navigateToBreadcrumb(idx)" 
							@dragover.prevent.stop="$store.drive.handleFolderDragOver($event, crumb)"
							@dragleave.prevent.stop="$store.drive.handleFolderDragLeave($event, crumb)"
							@drop.prevent.stop="$store.drive.handleFolderDrop($event, crumb)"
							x-text="crumb.name"
						></span>
					</span>
				</template>
			</div>

			<!-- View Switcher & Action Controls -->
			<div class="flex items-center gap-3">
				<!-- Empty Trash Button -->
				<button 
					x-show="$store.drive.activeTab === 'trash' && $store.drive.files.length > 0" 
					@click="$store.drive.emptyTrash()" 
					class="text-xs bg-red-500/15 hover:bg-red-500/25 text-red-400 border border-red-500/30 px-3 py-1.5 rounded-xl font-bold flex items-center gap-1.5 transition-all backdrop-blur-md"
				>
					@IconTrash("w-3.5 h-3.5")
					<span>Kosongkan Sampah</span>
				</button>

				<!-- Vault Lock Button -->
				<button 
					x-show="$store.drive.activeTab === 'vault' && $store.drive.isVaultUnlocked" 
					@click="$store.drive.lockVault()" 
					class="text-xs bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/25 px-3 py-1.5 rounded-xl font-bold flex items-center gap-2 transition-all backdrop-blur-md"
				>
					@IconLock("w-3.5 h-3.5")
					<span>Kunci Vault</span>
				</button>
				
				<!-- Sort Controls -->
				<div class="relative z-30" x-data="{ sortOpen: false }">
					<button @click="sortOpen = !sortOpen" class="text-xs bg-[#2E3137]/30 border border-[#3F4247]/50 hover:border-[#3F4247] text-[#86898B] hover:text-white px-3 py-1.5 rounded-xl flex items-center gap-1.5 font-mono backdrop-blur-md transition-all">
						@IconArrowUpDown("w-3.5 h-3.5")
						<span>Urutkan</span>
					</button>
					<div x-show="sortOpen" @click.away="sortOpen = false" x-cloak style="display: none;" class="absolute right-0 mt-2 w-48 bg-[#121519]/90 backdrop-blur-2xl border border-[#3F4247]/60 rounded-2xl shadow-2xl py-2 z-50 font-mono text-xs divide-y divide-[#3F4247]/30">
						<button @click="$store.drive.setSort('name', 'asc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-[#2E3137]/60 text-[#86898B] hover:text-[#F5CE0D] transition-colors">Nama (A-Z)</button>
						<button @click="$store.drive.setSort('name', 'desc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-[#2E3137]/60 text-[#86898B] hover:text-[#F5CE0D] transition-colors">Nama (Z-A)</button>
						<button @click="$store.drive.setSort('size', 'desc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-[#2E3137]/60 text-[#86898B] hover:text-[#F5CE0D] transition-colors">Ukuran (Terbesar)</button>
						<button @click="$store.drive.setSort('size', 'asc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-[#2E3137]/60 text-[#86898B] hover:text-[#F5CE0D] transition-colors">Ukuran (Terkecil)</button>
						<button @click="$store.drive.setSort('created_at', 'desc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-[#2E3137]/60 text-[#86898B] hover:text-[#F5CE0D] transition-colors">Waktu (Terbaru)</button>
						<button @click="$store.drive.setSort('created_at', 'asc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-[#2E3137]/60 text-[#86898B] hover:text-[#F5CE0D] transition-colors">Waktu (Terlama)</button>
					</div>
				</div>

				<!-- View Mode Segmented Pill Switcher (Board/List Glass Style) -->
				<div class="flex bg-[#2E3137]/30 border border-[#3F4247]/50 p-1 rounded-xl backdrop-blur-md">
					<button 
						@click="$store.drive.setViewMode('grid')" 
						:class="$store.drive.viewMode === 'grid' ? 'bg-gradient-to-r from-[#F5CE0D] to-[#DDAC0D] text-[#121519] font-bold shadow-md' : 'text-[#86898B] hover:text-white'" 
						class="px-3 py-1 text-xs rounded-lg transition-all flex items-center gap-1.5 font-medium"
					>
						@IconGrid("w-3.5 h-3.5")
						<span>Tampilan Grid</span>
					</button>
					<button 
						@click="$store.drive.setViewMode('list')" 
						:class="$store.drive.viewMode === 'list' ? 'bg-gradient-to-r from-[#F5CE0D] to-[#DDAC0D] text-[#121519] font-bold shadow-md' : 'text-[#86898B] hover:text-white'" 
						class="px-3 py-1 text-xs rounded-lg transition-all flex items-center gap-1.5 font-medium"
					>
						@IconList("w-3.5 h-3.5")
						<span>Tampilan Daftar</span>
					</button>
				</div>
			</div>
		</div>

		<!-- WORKSPACE CONTENT AREA -->
		<div class="flex-1 overflow-y-auto p-6 space-y-8 relative z-10">

			<!-- SECTION 1: FOLDERS / CELLS -->
			<div x-show="($store.drive.activeTab === 'storage' || $store.drive.activeTab === 'vault') && ($store.drive.folders.length > 0 || !$store.drive.currentFolderId)" class="space-y-4">
				<div class="flex justify-between items-center">
					<h3 class="text-xs font-mono text-[#F5CE0D] uppercase tracking-wider font-bold flex items-center gap-2">
						<template x-if="$store.drive.activeTab === 'vault'">
							@IconShieldCheck("w-4 h-4")
						</template>
						<template x-if="$store.drive.activeTab !== 'vault'">
							@IconFolder("w-4 h-4")
						</template>
						<span x-text="$store.drive.currentFolderId ? 'SUBFOLDER' : ($store.drive.activeTab === 'vault' ? 'VAULT CELLS TERENKRIPSI' : 'FOLDER UTAMA')"></span>
					</h3>
					<div class="flex items-center gap-2">
						<button 
							@click="$store.drive.openAddDownloadModal()" 
							class="text-xs bg-[#F5CE0D]/10 hover:bg-[#F5CE0D]/20 text-[#F5CE0D] border border-[#F5CE0D]/30 px-3.5 py-1.5 rounded-xl font-bold flex items-center gap-1.5 transition-all backdrop-blur-md shadow-sm cursor-pointer"
							title="Unduh berkas dari tautan web atau magnet"
						>
							@IconDownload("w-3.5 h-3.5")
							<span>Unduh dari Tautan</span>
						</button>
						<button 
							@click="$store.drive.showCreateFolderModal = true" 
							class="text-xs bg-[#2E3137]/30 hover:bg-[#2E3137]/60 text-[#F5CE0D] border border-[#F5CE0D]/30 px-3.5 py-1.5 rounded-xl font-bold flex items-center gap-1.5 transition-all backdrop-blur-md shadow-sm cursor-pointer"
						>
							@IconPlus("w-3.5 h-3.5")
							<span>Buat Folder Baru</span>
						</button>
					</div>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
					<template x-for="folder in $store.drive.folders" :key="folder.id">
						<div 
							@click="$store.drive.openFolder(folder)" 
							@dragover.prevent.stop="$store.drive.handleFolderDragOver($event, folder)"
							@dragleave.prevent.stop="$store.drive.handleFolderDragLeave($event, folder)"
							@drop.prevent.stop="$store.drive.handleFolderDrop($event, folder)"
							:class="[
								$store.drive.dragTargetFolderId === folder.id 
									? 'border-[#F5CE0D] ring-2 ring-[#F5CE0D]/60 scale-[1.02] bg-[#2E3137]/80 shadow-2xl' 
									: 'border-[#3F4247]/60 hover:border-[#F5CE0D]/50 bg-[#2E3137]/30 hover:bg-[#2E3137]/50'
							]"
							class="p-4 rounded-2xl cursor-pointer group transition-all shadow-sm hover:shadow-xl hover:-translate-y-0.5 relative backdrop-blur-md"
						>
							<div class="flex justify-between items-start mb-3">
								<div class="w-10 h-10 rounded-xl bg-[#2E3137] border border-[#3F4247]/60 text-[#F5CE0D] flex items-center justify-center group-hover:bg-gradient-to-br group-hover:from-[#F5CE0D] group-hover:to-[#DDAC0D] group-hover:text-[#121519] transition-all shadow-sm">
									<template x-if="$store.drive.activeTab === 'vault'">
										@IconShieldCheck("w-5 h-5")
									</template>
									<template x-if="$store.drive.activeTab !== 'vault'">
										@IconFolder("w-5 h-5")
									</template>
								</div>
								<div class="flex items-center gap-1">
									<template x-if="$store.drive.activeTab === 'vault'">
										<span class="text-[9px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20 font-bold">TERENKRIPSI</span>
									</template>
									<template x-if="$store.drive.activeTab === 'storage'">
										<span class="text-[9px] font-mono text-[#F5CE0D] bg-[#F5CE0D]/10 px-2 py-0.5 rounded-md border border-[#F5CE0D]/20 font-bold">STANDAR</span>
									</template>
									<button 
										@click.stop="$store.drive.renameFolder(folder)" 
										title="Ubah Nama Folder"
										class="opacity-0 group-hover:opacity-100 text-[#86898B] hover:text-[#F5CE0D] p-1.5 rounded-lg hover:bg-[#2E3137]/60 transition-all"
									>
										@IconEdit("w-3.5 h-3.5")
									</button>
									<button 
										@click.stop="$store.drive.deleteFolder(folder)" 
										title="Hapus Folder" 
										class="opacity-0 group-hover:opacity-100 text-[#86898B] hover:text-red-400 p-1.5 rounded-lg hover:bg-red-500/10 transition-all"
									>
										@IconTrash("w-3.5 h-3.5")
									</button>
								</div>
							</div>
							<div class="font-bold text-sm text-white group-hover:text-[#F5CE0D] transition-colors truncate" x-text="folder.name"></div>
							<div class="text-[11px] text-[#86898B] font-mono mt-1" x-text="$store.drive.activeTab === 'vault' ? `${folder.file_count || 0} Berkas • AES-256-GCM` : `${folder.file_count || 0} Berkas • Standar`"></div>
						</div>
					</template>
				</div>
			</div>

			<!-- SECTION 2: FILES LIST / GRID -->
			<div class="space-y-4">
				<div class="flex justify-between items-center">
					<h3 class="text-xs font-mono text-[#86898B] uppercase tracking-wider font-bold flex items-center gap-2">
						<template x-if="$store.drive.activeTab === 'vault'">
							@IconShield("w-4 h-4 text-emerald-400")
						</template>
						<template x-if="$store.drive.activeTab === 'trash'">
							@IconTrash("w-4 h-4 text-red-400")
						</template>
						<template x-if="$store.drive.activeTab === 'starred'">
							@IconStar("w-4 h-4 text-[#F5CE0D]", true)
						</template>
						<template x-if="$store.drive.activeTab === 'recent'">
							@IconClock("w-4 h-4 text-blue-400")
						</template>
						<template x-if="$store.drive.activeTab === 'storage'">
							@IconHardDrive("w-4 h-4 text-[#F5CE0D]")
						</template>
						<span x-text="$store.drive.searchQuery ? `HASIL PENCARIAN BERKAS (${$store.drive.files.length})` : ($store.drive.activeTab === 'vault' ? 'DAFTAR BERKAS TERENKRIPSI VAULT' : ($store.drive.activeTab === 'trash' ? 'DAFTAR BERKAS DI SAMPAH' : ($store.drive.activeTab === 'starred' ? 'DAFTAR BERKAS BERBINTANG' : ($store.drive.activeTab === 'recent' ? 'DAFTAR BERKAS TERBARU' : 'DAFTAR BERKAS TERSINKRON'))))"></span>
					</h3>
					<span class="text-xs text-[#86898B]/70 font-mono" x-text="`Menampilkan ${$store.drive.files.length} berkas`"></span>
				</div>

				<div x-show="$store.drive.files.length === 0" class="text-center py-16 border border-dashed border-[#3F4247]/60 rounded-2xl text-[#86898B] font-mono text-sm bg-[#2E3137]/20 backdrop-blur-md flex flex-col items-center justify-center space-y-3">
					<template x-if="$store.drive.searchQuery && $store.drive.searchQuery.trim().length > 0">
						<div class="flex flex-col items-center space-y-2">
							<div class="w-12 h-12 rounded-full bg-[#2E3137] text-[#86898B] flex items-center justify-center border border-[#3F4247]/40">
								@IconSearch("w-6 h-6")
							</div>
							<span class="text-white">Tidak ditemukan berkas yang cocok dengan <span class="text-[#F5CE0D] font-bold" x-text="'“' + $store.drive.searchQuery + '”'"></span></span>
							<button 
								type="button" 
								@click="$store.drive.clearSearch()" 
								class="text-xs text-[#F5CE0D] hover:underline font-mono mt-1"
							>
								Bersihkan Pencarian
							</button>
						</div>
					</template>
					<template x-if="!$store.drive.searchQuery && $store.drive.activeTab === 'trash'">
						<div class="flex flex-col items-center space-y-2">
							<div class="w-12 h-12 rounded-full bg-red-500/10 text-red-400 flex items-center justify-center">
								@IconTrash("w-6 h-6")
							</div>
							<span>Tempat sampah kosong. Tidak ada berkas yang dihapus.</span>
						</div>
					</template>
					<template x-if="!$store.drive.searchQuery && $store.drive.activeTab === 'starred'">
						<div class="flex flex-col items-center space-y-2">
							<div class="w-12 h-12 rounded-full bg-[#F5CE0D]/10 text-[#F5CE0D] flex items-center justify-center">
								@IconStar("w-6 h-6", false)
							</div>
							<span>Belum ada berkas berbintang. Tandai berkas favorit Anda dengan bintang.</span>
						</div>
					</template>
					<template x-if="!$store.drive.searchQuery && $store.drive.activeTab === 'recent'">
						<div class="flex flex-col items-center space-y-2">
							<div class="w-12 h-12 rounded-full bg-blue-500/10 text-blue-400 flex items-center justify-center">
								@IconClock("w-6 h-6")
							</div>
							<span>Belum ada riwayat berkas terbaru.</span>
						</div>
					</template>
					<template x-if="!$store.drive.searchQuery && $store.drive.activeTab !== 'trash' && $store.drive.activeTab !== 'starred' && $store.drive.activeTab !== 'recent'">
						<div class="flex flex-col items-center space-y-2">
							<div class="w-12 h-12 rounded-full bg-[#2E3137] text-[#86898B] flex items-center justify-center border border-[#3F4247]/40">
								@IconFolder("w-6 h-6")
							</div>
							<span>Belum ada berkas di kategori ini. Klik "+ Unggah Berkas" untuk mengunggah berkas baru.</span>
						</div>
					</template>
				</div>

				<!-- GRID VIEW -->
				<div x-show="$store.drive.viewMode === 'grid' && $store.drive.files.length > 0" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
					<template x-for="file in $store.drive.files" :key="file.id">
						<div 
							@click="$store.drive.selectFile(file)" 
							draggable="true"
							@dragstart="$store.drive.handleFileDragStart($event, file)"
							@dragend="$store.drive.handleFileDragEnd($event)"
							:class="$store.drive.draggedFile && $store.drive.draggedFile.id === file.id ? 'opacity-40 scale-95 border-[#F5CE0D]' : ''"
							class="bg-[#2E3137]/30 hover:bg-[#2E3137]/50 border border-[#3F4247]/60 hover:border-[#F5CE0D]/50 p-3 rounded-2xl cursor-pointer group transition-all flex flex-col justify-between h-52 shadow-sm hover:shadow-xl hover:-translate-y-0.5 relative backdrop-blur-md select-none"
						>
							<div class="h-28 bg-[#121519]/70 border border-[#3F4247]/40 rounded-xl flex items-center justify-center text-[#F5CE0D] relative overflow-hidden group-hover:border-[#F5CE0D]/30 transition-all backdrop-blur-sm">
								<!-- Preview for readable files (PDFs, images, documents, text) -->
								<template x-if="file.has_preview">
									<div class="w-full h-full flex items-center justify-center relative overflow-hidden bg-[#0F1215]/80 p-1.5">
										<template x-if="file.mime_type && file.mime_type.startsWith('image/')">
											<img 
												:src="'/api/files/' + file.id + '/thumbnail'" 
												class="w-full h-full object-cover rounded-lg" 
												alt="" 
												loading="lazy" 
											/>
										</template>
										<template x-if="!file.mime_type || !file.mime_type.startsWith('image/')">
											<img 
												:src="'/api/files/' + file.id + '/thumbnail'" 
												class="h-[96px] w-auto max-w-[85%] object-contain rounded shadow-lg transition-transform group-hover:scale-105" 
												alt="Preview" 
												loading="lazy" 
											/>
										</template>
										<div class="absolute bottom-1.5 right-1.5 text-[9px] bg-[#121519]/90 border border-[#3F4247]/60 text-[#EDEBE8] font-mono px-1.5 py-0.5 rounded-md font-bold uppercase truncate max-w-[55px] shadow-sm backdrop-blur-sm" x-text="(file.ext || 'FILE').slice(0, 4)"></div>
									</div>
								</template>

								<!-- No preview for archives / binaries (.zip, .iso, etc.) as in Google Drive -->
								<template x-if="!file.has_preview">
									<div class="w-full h-full flex items-center justify-center relative">
										<div x-html="$store.drive.getFileIconSvg(file.icon, 'w-10 h-10')"></div>
										<div class="absolute bottom-1.5 right-1.5 text-[9px] bg-gradient-to-r from-[#F5CE0D] to-[#DDAC0D] text-[#121519] font-mono px-2 py-0.5 rounded-md font-bold uppercase truncate max-w-[55px] shadow-sm" x-text="(file.ext || 'FILE').slice(0, 4)"></div>
									</div>
								</template>
							</div>
							<div class="mt-2">
								<div class="font-semibold text-xs text-white truncate group-hover:text-[#F5CE0D] transition-colors" :title="file.name" x-text="file.name"></div>
								<div class="flex justify-between items-center text-[10px] text-[#86898B] font-mono mt-1">
									<span x-text="(file.size >= 1073741824) ? (file.size / 1073741824).toFixed(2) + ' GB' : (file.size >= 1048576) ? (file.size / 1048576).toFixed(1) + ' MB' : (file.size >= 1024) ? (file.size / 1024).toFixed(1) + ' KB' : file.size + ' B'"></span>
									<span :class="file.is_deleted ? 'text-red-400' : 'text-emerald-400'" class="flex items-center gap-1 font-semibold text-[9px]">
										<span class="w-1.5 h-1.5 rounded-full" :class="file.is_deleted ? 'bg-red-400' : 'bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.6)]'"></span>
										<span x-text="file.is_deleted ? 'DI SAMPAH' : 'TERSINKRON'"></span>
									</span>
								</div>
								<div class="text-[9px] text-[#86898B]/60 font-mono truncate mt-0.5" x-text="file.created_at ? new Date(file.created_at).toLocaleDateString('id-ID') : ''"></div>
							</div>
						</div>
					</template>
				</div>

				<!-- DENSE LIST VIEW -->
				<div 
					x-show="$store.drive.viewMode === 'list' && $store.drive.files.length > 0" 
					class="border border-[#3F4247]/60 rounded-2xl overflow-hidden bg-[#2E3137]/20 backdrop-blur-xl divide-y divide-[#3F4247]/40"
				>
					<template x-for="file in $store.drive.files" :key="file.id">
						<div 
							@click="$store.drive.selectFile(file)" 
							draggable="true"
							@dragstart="$store.drive.handleFileDragStart($event, file)"
							@dragend="$store.drive.handleFileDragEnd($event)"
							:class="$store.drive.draggedFile && $store.drive.draggedFile.id === file.id ? 'opacity-40 border-[#F5CE0D] bg-[#2E3137]/60' : ''"
							class="flex items-center justify-between px-4 py-3 hover:bg-[#2E3137]/40 cursor-pointer transition-colors group select-none"
						>
							<div class="flex items-center gap-3">
								<div class="w-8 h-8 rounded-lg bg-[#2E3137] border border-[#3F4247]/60 flex items-center justify-center text-[#F5CE0D] shrink-0" x-html="$store.drive.getFileIconSvg(file.icon, 'w-4 h-4')"></div>
								<div>
									<div class="font-bold text-sm text-white group-hover:text-[#F5CE0D] transition-colors" :title="file.name" x-text="file.name"></div>
									<div class="text-[11px] text-[#86898B] font-mono" x-text="`SHA-256: ${file.cas_hash}`"></div>
								</div>
							</div>
							<div class="flex items-center gap-6 text-xs font-mono">
								<span class="text-[#86898B]/60 text-[11px] hidden sm:inline" x-text="file.created_at ? new Date(file.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : ''"></span>
								<span class="text-[#86898B]" x-text="(file.size >= 1073741824) ? (file.size / 1073741824).toFixed(2) + ' GB' : (file.size >= 1048576) ? (file.size / 1048576).toFixed(1) + ' MB' : (file.size >= 1024) ? (file.size / 1024).toFixed(1) + ' KB' : file.size + ' B'"></span>
								<span :class="file.is_deleted ? 'bg-red-500/10 text-red-400 border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'" class="px-2.5 py-0.5 border rounded-md font-semibold text-[10px] flex items-center gap-1">
									<span class="w-1.5 h-1.5 rounded-full" :class="file.is_deleted ? 'bg-red-400' : 'bg-emerald-400'"></span>
									<span x-text="file.is_deleted ? 'DI SAMPAH' : 'TERSINKRON'"></span>
								</span>
								<button class="text-[#F5CE0D] hover:underline font-bold">Detail →</button>
							</div>
						</div>
					</template>
				</div>
			</div>

		</div>

		<!-- FILE DETAILS & ACTIONS MODAL -->
		<div 
			x-show="$store.drive && $store.drive.selectedFile" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/80 backdrop-blur-xl flex items-center justify-center z-50 p-4"
		>
			<div 
				@click.away="$store.drive.closeFileModal()" 
				class="bg-[#121519]/95 backdrop-blur-2xl border border-[#3F4247]/60 w-full max-w-2xl max-h-[90vh] flex flex-col rounded-2xl p-6 shadow-2xl space-y-4 overflow-hidden"
			>
				<div class="flex justify-between items-start border-b border-[#3F4247]/60 pb-3 shrink-0">
					<div class="flex items-center gap-3 min-w-0">
						<div class="w-10 h-10 rounded-xl bg-[#2E3137] border border-[#F5CE0D]/40 flex items-center justify-center text-[#F5CE0D] shrink-0" x-html="$store.drive.selectedFile ? $store.drive.getFileIconSvg($store.drive.selectedFile.icon, 'w-5 h-5') : ''">
						</div>
						<div class="min-w-0">
							<h3 class="font-bold text-sm sm:text-base text-white truncate" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.name : ''"></h3>
							<p class="text-xs text-[#86898B] font-mono" x-text="$store.drive.selectedFile ? 'Ukuran: ' + ($store.drive.selectedFile.size >= 1073741824 ? ($store.drive.selectedFile.size / 1073741824).toFixed(2) + ' GB' : $store.drive.selectedFile.size >= 1048576 ? ($store.drive.selectedFile.size / 1048576).toFixed(1) + ' MB' : $store.drive.selectedFile.size >= 1024 ? ($store.drive.selectedFile.size / 1024).toFixed(1) + ' KB' : $store.drive.selectedFile.size + ' B') : ''"></p>
						</div>
					</div>
					<button @click="$store.drive.closeFileModal()" class="text-[#86898B] hover:text-white transition-colors shrink-0 ml-2">
						@IconX("w-5 h-5")
					</button>
				</div>

				<!-- SCROLLABLE BODY (Preview + Cryptographic Details) -->
				<div class="flex-1 overflow-y-auto space-y-4 pr-1">
					<!-- FILE PREVIEW CONTAINER -->
					<div class="w-full bg-[#0D0F12] border border-[#3F4247]/50 rounded-xl overflow-hidden flex flex-col items-center justify-center relative min-h-[160px]">
						<!-- Image Preview -->
						<template x-if="$store.drive.selectedFile && $store.drive.selectedFile.mime_type && $store.drive.selectedFile.mime_type.startsWith('image/')">
							<div class="w-full flex items-center justify-center p-3">
								<img 
									:src="'/api/files/' + $store.drive.selectedFile.id + '/preview'" 
									class="max-h-80 w-auto object-contain rounded-lg shadow-lg" 
									alt="Image Preview" 
								/>
							</div>
						</template>

						<!-- PDF Preview (Embedded Viewer) -->
						<template x-if="$store.drive.selectedFile && ($store.drive.selectedFile.ext === 'pdf' || $store.drive.selectedFile.mime_type === 'application/pdf')">
							<div class="w-full h-80 flex flex-col bg-white">
								<iframe 
									:src="'/api/files/' + $store.drive.selectedFile.id + '/preview#toolbar=0'" 
									class="w-full h-full border-0"
									title="PDF Viewer"
								></iframe>
							</div>
						</template>

						<!-- Office Document / Presentation Preview -->
						<template x-if="$store.drive.selectedFile && $store.drive.isOfficeFile($store.drive.selectedFile)">
							<div class="w-full flex items-center justify-center p-4 bg-black/40">
								<img 
									:src="'/api/files/' + $store.drive.selectedFile.id + '/thumbnail'" 
									class="max-h-80 w-auto object-contain rounded-lg shadow-xl" 
									alt="Presentation Preview" 
								/>
							</div>
						</template>

						<!-- Text / Code Preview -->
						<template x-if="$store.drive.selectedFile && $store.drive.isTextOrCodeFile($store.drive.selectedFile)">
							<div class="w-full p-4 font-mono text-xs text-[#EDEBE8]/90 max-h-72 overflow-y-auto whitespace-pre-wrap select-text leading-relaxed bg-[#121519]/60">
								<template x-if="$store.drive.filePreviewLoading">
									<div class="flex items-center justify-center py-8 text-[#86898B]">
										<span class="animate-pulse">Memuat pratinjau berkas...</span>
									</div>
								</template>
								<template x-if="!$store.drive.filePreviewLoading">
									<div x-text="$store.drive.filePreviewText"></div>
								</template>
							</div>
						</template>

						<!-- Video Preview -->
						<template x-if="$store.drive.selectedFile && $store.drive.selectedFile.mime_type && $store.drive.selectedFile.mime_type.startsWith('video/')">
							<video 
								controls 
								class="max-h-80 w-full rounded-lg" 
								:src="'/api/files/' + $store.drive.selectedFile.id + '/preview'"
							></video>
						</template>

						<!-- Audio Preview -->
						<template x-if="$store.drive.selectedFile && $store.drive.selectedFile.mime_type && $store.drive.selectedFile.mime_type.startsWith('audio/')">
							<div class="p-6 w-full flex justify-center">
								<audio 
									controls 
									class="w-full max-w-md" 
									:src="'/api/files/' + $store.drive.selectedFile.id + '/preview'"
								></audio>
							</div>
						</template>

						<!-- Non-previewable Notice (For .zip, .iso, .rar, binaries, etc.) -->
						<template x-if="$store.drive.selectedFile && !$store.drive.selectedFile.has_preview">
							<div class="py-10 px-4 flex flex-col items-center justify-center text-center space-y-2.5">
								<div class="w-14 h-14 rounded-2xl bg-[#2E3137]/80 border border-[#3F4247]/60 flex items-center justify-center text-[#86898B] shadow-inner">
									<div x-html="$store.drive.getFileIconSvg($store.drive.selectedFile.icon, 'w-7 h-7')"></div>
								</div>
								<div>
									<h4 class="text-xs font-bold text-white font-mono uppercase tracking-wider">Pratinjau Tidak Tersedia</h4>
									<p class="text-[11px] text-[#86898B] mt-1 max-w-sm">Berkas jenis ini tidak dapat dipratinjau langsung di peramban. Silakan unduh berkas untuk membukanya.</p>
								</div>
								<button 
									@click="$store.drive.downloadFile($store.drive.selectedFile)" 
									class="hornetz-btn py-1.5 px-4 rounded-xl text-xs font-bold flex items-center gap-1.5 mt-2"
								>
									@IconDownload("w-3.5 h-3.5")
									<span>Unduh Sekarang</span>
								</button>
							</div>
						</template>
					</div>

					<!-- Security & Cryptographic Details -->
					<div class="bg-[#2E3137]/30 border border-[#3F4247]/60 rounded-xl p-3.5 space-y-2 font-mono text-xs backdrop-blur-md">
						<div class="flex justify-between text-[#86898B]">
							<span>Status Enkripsi:</span>
							<strong 
								:class="($store.drive.selectedFile && $store.drive.selectedFile.is_vault) ? 'text-emerald-400' : 'text-[#F5CE0D]'"
								x-text="($store.drive.selectedFile && $store.drive.selectedFile.is_vault) ? 'AES-256-GCM (Swarm Vault)' : 'Penyimpanan Standar'"
							></strong>
						</div>
						<div class="flex justify-between text-[#86898B]">
							<span>Content Address (CAS):</span>
							<strong class="text-[#F5CE0D] truncate max-w-[200px]" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.cas_hash : ''"></strong>
						</div>
						<div class="flex justify-between text-[#86898B]">
							<span>MIME Type:</span>
							<strong class="text-white" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.mime_type : ''"></strong>
						</div>
						<div class="flex justify-between text-[#86898B]">
							<span>Waktu Dibuat:</span>
							<strong class="text-white" x-text="$store.drive.selectedFile && $store.drive.selectedFile.created_at ? new Date($store.drive.selectedFile.created_at).toLocaleString('id-ID') : '-'"></strong>
						</div>
					</div>
				</div>

				<!-- Action Buttons -->
				<div class="flex gap-3 pt-2 border-t border-[#3F4247]/60 shrink-0">
					<template x-if="$store.drive.activeTab === 'trash'">
						<div class="flex gap-3 w-full">
							<button 
								@click="$store.drive.restoreFile($store.drive.selectedFile)" 
								class="flex-1 hornetz-btn py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 text-xs font-bold"
							>
								@IconRefresh("w-4 h-4")
								<span>Pulihkan Berkas</span>
							</button>
							<button 
								@click="$store.drive.deleteFile($store.drive.selectedFile, true)" 
								class="bg-red-500/20 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/40 py-2.5 px-4 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition-colors"
							>
								@IconTrash("w-4 h-4")
								<span>Hapus Permanen</span>
							</button>
						</div>
					</template>

					<template x-if="$store.drive.activeTab !== 'trash'">
						<div class="flex gap-3 w-full">
							<button 
								@click="$store.drive.toggleStar($store.drive.selectedFile)" 
								class="bg-[#2E3137]/40 hover:bg-[#2E3137]/80 text-[#F5CE0D] border border-[#F5CE0D]/40 py-2.5 px-3 rounded-xl text-xs font-semibold transition-all backdrop-blur-md flex items-center gap-1.5"
							>
								<template x-if="$store.drive.selectedFile && $store.drive.selectedFile.is_starred">
									<span class="flex items-center gap-1.5">
										@IconStar("w-4 h-4", true)
										<span>Berbintang</span>
									</span>
								</template>
								<template x-if="!$store.drive.selectedFile || !$store.drive.selectedFile.is_starred">
									<span class="flex items-center gap-1.5">
										@IconStar("w-4 h-4", false)
										<span>Beri Bintang</span>
									</span>
								</template>
							</button>
							<button 
								@click="$store.drive.downloadFile($store.drive.selectedFile)" 
								class="flex-1 hornetz-btn py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 text-xs font-bold"
							>
								@IconDownload("w-4 h-4")
								<span x-text="$store.drive.activeTab === 'vault' ? 'Dekripsi & Unduh' : 'Unduh Berkas'"></span>
							</button>
							<button 
								@click="$store.drive.openMoveModal($store.drive.selectedFile)" 
								class="bg-white/[0.04] hover:bg-white/[0.08] text-[#EDEBE8] hover:text-[#F5CE0D] border border-[#3F4247]/60 py-2.5 px-3 rounded-xl text-xs font-semibold transition-all backdrop-blur-md flex items-center gap-1.5"
								title="Pindahkan berkas ke folder lain"
							>
								@IconFolderInput("w-4 h-4")
								<span>Pindahkan</span>
							</button>
							<button 
								@click="$store.drive.renameFile($store.drive.selectedFile)" 
								class="bg-white/[0.04] hover:bg-white/[0.08] text-[#EDEBE8] border border-[#3F4247]/60 py-2.5 px-3 rounded-xl text-xs font-semibold transition-all backdrop-blur-md flex items-center gap-1.5"
							>
								@IconEdit("w-4 h-4")
								<span>Ubah Nama</span>
							</button>
							<button 
								@click="$store.drive.deleteFile($store.drive.selectedFile, false)" 
								class="bg-red-500/10 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/30 py-2.5 px-4 rounded-xl text-xs font-semibold transition-colors backdrop-blur-md flex items-center gap-1.5"
							>
								@IconTrash("w-4 h-4")
								<span>Ke Sampah</span>
							</button>
						</div>
					</template>
				</div>
			</div>
		</div>

		<!-- MOVE FILE MODAL -->
		<div 
			x-show="$store.drive && $store.drive.showMoveModal" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/80 backdrop-blur-xl flex items-center justify-center z-[110] p-4"
		>
			<div 
				@click.away="$store.drive.showMoveModal = false" 
				class="bg-[#121519]/95 backdrop-blur-2xl border border-[#3F4247]/60 w-full max-w-md rounded-2xl p-6 shadow-2xl space-y-4"
			>
				<div class="flex justify-between items-center border-b border-[#3F4247]/60 pb-3">
					<div class="flex items-center gap-2">
						<div class="w-8 h-8 rounded-lg bg-[#2E3137] border border-[#F5CE0D]/40 text-[#F5CE0D] flex items-center justify-center">
							@IconFolderInput("w-4 h-4")
						</div>
						<h3 class="font-bold text-sm text-white">Pindahkan Berkas</h3>
					</div>
					<button @click="$store.drive.showMoveModal = false" class="text-[#86898B] hover:text-white transition-colors">
						@IconX("w-4 h-4")
					</button>
				</div>

				<div class="space-y-1 bg-[#2E3137]/30 border border-[#3F4247]/50 p-3 rounded-xl">
					<div class="flex items-center justify-between text-xs">
						<span class="text-[#86898B]">Berkas yang dipindah:</span>
						<span class="font-bold text-white truncate max-w-[200px] font-mono" x-text="$store.drive.fileToMove ? $store.drive.fileToMove.name : ''"></span>
					</div>
					<div class="flex items-center justify-between text-xs pt-2 border-t border-white/[0.04]">
						<span class="text-[#86898B]">Lokasi Tujuan:</span>
						<span class="font-bold text-[#F5CE0D] truncate max-w-[220px] font-mono text-right" x-text="$store.drive.getMoveTargetFolderPath()"></span>
					</div>
				</div>

				<!-- Target Folder Selection Directory Tree -->
				<div class="space-y-1.5 max-h-64 overflow-y-auto pr-1 select-none">
					<!-- Root Folder Option -->
					<div 
						@click="$store.drive.targetMoveFolderId = ''" 
						:class="$store.drive.targetMoveFolderId === '' ? 'border-[#F5CE0D] bg-[#F5CE0D]/10 text-white font-bold shadow-sm' : 'border-[#3F4247]/50 hover:bg-[#2E3137]/40 text-[#86898B] hover:text-white'"
						class="p-2.5 rounded-xl border flex items-center justify-between cursor-pointer transition-all"
					>
						<div class="flex items-center gap-2">
							<span class="w-5 h-5 flex items-center justify-center text-[#86898B]/50 shrink-0">
								<span class="w-1.5 h-1.5 rounded-full bg-[#86898B]/60"></span>
							</span>
							<div class="text-[#F5CE0D] shrink-0">
								@IconHardDrive("w-4 h-4")
							</div>
							<span class="text-xs font-semibold">Penyimpanan Utama (Root)</span>
							<template x-if="$store.drive.fileToMove && (!$store.drive.fileToMove.folder_id || $store.drive.fileToMove.folder_id === '')">
								<span class="text-[9px] text-[#86898B] font-mono bg-white/5 px-1.5 py-0.5 rounded border border-white/10 shrink-0">(Saat Ini)</span>
							</template>
						</div>
						<span x-show="$store.drive.targetMoveFolderId === ''" class="text-[#F5CE0D] text-[11px] font-bold font-mono shrink-0">Pilihan</span>
					</div>

					<!-- Directory Tree Nodes -->
					<template x-for="node in $store.drive.getMoveTreeNodes()" :key="node.id">
						<div 
							@click="$store.drive.targetMoveFolderId = node.id" 
							:style="'padding-left: ' + (10 + node.level * 22) + 'px'"
							:class="[
								$store.drive.targetMoveFolderId === node.id ? 'border-[#F5CE0D] bg-[#F5CE0D]/10 text-white font-bold shadow-sm' : 'border-[#3F4247]/40 hover:bg-[#2E3137]/40 text-[#86898B] hover:text-white',
							]"
							class="p-2 rounded-xl border flex items-center justify-between cursor-pointer transition-all relative group"
						>
							<div class="flex items-center gap-2 min-w-0">
								<!-- Expand / Collapse chevron toggle -->
								<button 
									type="button"
									x-show="node.hasChildren"
									@click.stop="$store.drive.toggleMoveFolderExpand(node.id, $event)"
									class="w-5 h-5 flex items-center justify-center rounded hover:bg-white/10 text-[#86898B] hover:text-[#F5CE0D] transition-colors shrink-0"
								>
									<template x-if="node.isExpanded">
										@IconChevronDown("w-3.5 h-3.5 text-[#F5CE0D]")
									</template>
									<template x-if="!node.isExpanded">
										@IconChevronRight("w-3.5 h-3.5")
									</template>
								</button>
								<span x-show="!node.hasChildren" class="w-5 h-5 flex items-center justify-center text-[#86898B]/40 shrink-0">
									<span class="text-xs font-mono">└</span>
								</span>

								<!-- Folder Icon -->
								<div class="text-[#F5CE0D] shrink-0">
									@IconFolder("w-4 h-4")
								</div>

								<!-- Name & count -->
								<div class="min-w-0 flex items-center gap-1.5">
									<span class="text-xs font-semibold truncate" x-text="node.name"></span>
									<span class="text-[10px] text-[#86898B] font-mono shrink-0" x-text="'(' + (node.file_count || 0) + ')'"></span>
									<template x-if="$store.drive.fileToMove && $store.drive.fileToMove.folder_id === node.id">
										<span class="text-[9px] text-[#86898B] font-mono bg-white/5 px-1.5 py-0.5 rounded border border-white/10 shrink-0">(Saat Ini)</span>
									</template>
								</div>
							</div>

							<span x-show="$store.drive.targetMoveFolderId === node.id" class="text-[#F5CE0D] text-[11px] font-bold font-mono shrink-0 ml-2">Pilihan</span>
						</div>
					</template>
				</div>

				<div class="flex gap-3 pt-2 border-t border-[#3F4247]/60">
					<button 
						type="button" 
						@click="$store.drive.showMoveModal = false" 
						class="flex-1 py-2.5 bg-white/[0.04] border border-[#3F4247]/60 text-[#86898B] hover:text-white rounded-xl text-xs font-bold transition-all"
					>
						Batal
					</button>
					<button 
						type="button" 
						@click="$store.drive.executeMoveFile()" 
						class="flex-1 hornetz-btn py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5"
					>
						@IconFolderInput("w-4 h-4")
						<span>Pindahkan ke Sini</span>
					</button>
				</div>
			</div>
		</div>

	</div>
}
