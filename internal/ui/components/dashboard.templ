package components

import (
	"ztatic-go-framework/fullstack"
	"github.com/labstack/echo/v5"
)

templ Dashboard(c *echo.Context) {
	if fullstack.IsTurboFrame(c) {
		@DashboardContent()
	} else {
		@Layout("Dashboard Storage") {
			@DashboardContent()
		}
	}
}

templ DashboardContent() {
	<div id="dashboard-content" class="h-full flex flex-col" x-data>
		
		<!-- ACTION BAR & BREADCRUMBS -->
		<div class="h-14 border-b border-[#2A2723] px-6 flex items-center justify-between bg-[#171614] shrink-0">
			<!-- Breadcrumbs Path -->
			<div class="flex items-center gap-2 text-xs font-mono">
				<span class="text-[#FACC15] font-bold cursor-pointer" @click="$store.drive.setTab('storage')">Penyimpanan Saya</span>
				<span class="text-[#6E675E]">\</span>
				<span 
					:class="$store.drive.currentFolderId ? 'text-[#FACC15] cursor-pointer font-semibold' : 'text-white font-semibold'"
					@click="if ($store.drive.currentFolderId) $store.drive.clearFolder()"
					x-text="
						$store.drive.activeTab === 'storage' ? 'Penyimpanan Utama' : 
						($store.drive.activeTab === 'vault' ? 'Vault Terenkripsi' : 
						($store.drive.activeTab === 'recent' ? 'Berkas Terbaru' : 
						($store.drive.activeTab === 'starred' ? 'Berbintang' : 'Sampah')))
					"
				>Utama</span>
				<template x-if="$store.drive.currentFolderId">
					<span class="flex items-center gap-2">
						<span class="text-[#6E675E]">\</span>
						<span class="text-white font-bold" x-text="$store.drive.currentFolderName"></span>
					</span>
				</template>
			</div>

			<!-- View Switcher & Action Controls -->
			<div class="flex items-center gap-3">
				<!-- Vault Lock Button -->
				<button 
					x-show="$store.drive.activeTab === 'vault' && $store.drive.isVaultUnlocked" 
					@click="$store.drive.setTab('storage')" 
					class="text-xs bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 px-3 py-1.5 rounded-lg font-bold flex items-center gap-2 transition-colors"
				>
					<span>🔒</span> Kunci Vault
				</button>
				
				<div class="flex bg-[#0F0E0D] border border-[#2A2723] p-1 rounded-lg">
					<button 
						@click="$store.drive.viewMode = 'grid'" 
						:class="$store.drive.viewMode === 'grid' ? 'bg-[#FACC15] text-[#0F0E0D] font-bold shadow' : 'text-[#A19A8F] hover:text-white'" 
						class="px-3 py-1 text-xs rounded transition-all flex items-center gap-1 font-medium"
					>
						<span>田</span> Tampilan Grid
					</button>
					<button 
						@click="$store.drive.viewMode = 'list'" 
						:class="$store.drive.viewMode === 'list' ? 'bg-[#FACC15] text-[#0F0E0D] font-bold shadow' : 'text-[#A19A8F] hover:text-white'" 
						class="px-3 py-1 text-xs rounded transition-all flex items-center gap-1 font-medium"
					>
						<span>≡</span> Tampilan Daftar
					</button>
				</div>
			</div>
		</div>

		<!-- WORKSPACE CONTENT AREA -->
		<div class="flex-1 overflow-y-auto p-6 space-y-8">

			<!-- SECTION 1: FOLDERS / CELLS (Only shown on Storage / Vault tab when no folder selected) -->
			<div x-show="!$store.drive.currentFolderId && ($store.drive.activeTab === 'storage' || $store.drive.activeTab === 'vault')" class="space-y-4">
				<h3 class="text-xs font-mono text-[#FACC15] uppercase tracking-wider font-bold flex items-center gap-2">
					<span x-text="$store.drive.activeTab === 'vault' ? '🛡️' : '📁'"></span>
					<span x-text="$store.drive.activeTab === 'vault' ? 'VAULT CELLS TERENKRIPSI' : 'FOLDER UTAMA'"></span>
				</h3>
				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
					<template x-for="folder in $store.drive.folders" :key="folder.id">
						<div 
							@click="$store.drive.openFolder(folder)"
							class="bg-[#171614] border border-[#2A2723] hover:border-[#FACC15] p-4 rounded-xl cursor-pointer group transition-all shadow-sm hover:shadow-lg hover:-translate-y-0.5"
						>
							<div class="flex justify-between items-start mb-3">
								<div class="w-10 h-10 rounded-lg bg-[#FACC15]/10 border border-[#FACC15]/30 text-[#FACC15] flex items-center justify-center text-xl group-hover:bg-[#FACC15] group-hover:text-[#0F0E0D] transition-colors">
									<span x-text="$store.drive.activeTab === 'vault' ? '🛡️' : '📁'"></span>
								</div>
								<template x-if="$store.drive.activeTab === 'vault'">
									<span class="text-[9px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 font-bold">TERENKRIPSI</span>
								</template>
								<template x-if="$store.drive.activeTab === 'storage'">
									<span class="text-[9px] font-mono text-amber-400/80 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20 font-bold">STANDAR</span>
								</template>
							</div>
							<div class="font-bold text-sm text-white group-hover:text-[#FACC15] transition-colors" x-text="folder.name"></div>
							<div class="text-[11px] text-[#A19A8F] font-mono mt-1" x-text="$store.drive.activeTab === 'vault' ? `${folder.file_count || 0} Berkas • AES-256-GCM` : `${folder.file_count || 0} Berkas • Standar`"></div>
						</div>
					</template>
				</div>
			</div>

			<!-- SECTION 2: FILES LIST / GRID -->
			<div class="space-y-4">
				<div class="flex justify-between items-center">
					<h3 class="text-xs font-mono text-[#A19A8F] uppercase tracking-wider font-bold flex items-center gap-2">
						<span x-text="$store.drive.activeTab === 'vault' ? '🛡️' : '⚡'"></span>
						<span x-text="$store.drive.activeTab === 'vault' ? 'DAFTAR BERKAS TERENKRIPSI VAULT (DATABASE SQLITE / POSTGRES)' : 'DAFTAR BERKAS (DATABASE SQLITE / POSTGRES)'"></span>
					</h3>
					<span class="text-xs text-[#6E675E] font-mono" x-text="`Menampilkan ${$store.drive.files.length} berkas asli`"></span>
				</div>

				<!-- Empty State if no files -->
				<div x-show="$store.drive.files.length === 0" class="text-center py-16 border border-dashed border-[#2A2723] rounded-xl text-[#A19A8F] font-mono text-sm">
					📭 Belum ada berkas di kategori ini. Klik "+ Unggah Berkas" untuk mengunggah berkas baru.
				</div>

				<!-- GRID VIEW -->
				<div x-show="$store.drive.viewMode === 'grid' && $store.drive.files.length > 0" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
					<template x-for="file in $store.drive.files" :key="file.id">
						<div 
							@click="$store.drive.selectedFile = file" 
							class="bg-[#171614] border border-[#2A2723] hover:border-[#FACC15] p-3 rounded-xl cursor-pointer group transition-all flex flex-col justify-between h-48 shadow-sm hover:shadow-lg hover:-translate-y-0.5 relative"
						>
							<div class="h-28 bg-[#0F0E0D] border border-[#2A2723] rounded-lg flex items-center justify-center text-4xl text-[#FACC15] relative overflow-hidden group-hover:border-[#FACC15]/50 transition-colors">
								<span x-text="file.icon || '📄'"></span>
								<div class="absolute bottom-1.5 right-1.5 text-[9px] bg-[#FACC15] text-[#0F0E0D] font-mono px-1.5 py-0.5 rounded font-bold uppercase" x-text="file.ext || 'FILE'"></div>
							</div>
							<div class="mt-2">
								<div class="font-semibold text-xs text-white truncate group-hover:text-[#FACC15] transition-colors" x-text="file.name"></div>
								<div class="flex justify-between text-[10px] text-[#A19A8F] font-mono mt-1">
									<span x-text="(file.size / 1024 > 1024) ? (file.size / (1024*1024)).toFixed(1) + ' MB' : (file.size / 1024).toFixed(1) + ' KB'"></span>
									<span class="text-emerald-400 font-semibold">DATABASE</span>
								</div>
							</div>
						</div>
					</template>
				</div>

				<!-- DENSE LIST VIEW -->
				<div 
					x-show="$store.drive.viewMode === 'list' && $store.drive.files.length > 0" 
					class="border border-[#2A2723] rounded-xl overflow-hidden bg-[#171614] divide-y divide-[#2A2723]"
				>
					<template x-for="file in $store.drive.files" :key="file.id">
						<div 
							@click="$store.drive.selectedFile = file" 
							class="flex items-center justify-between px-4 py-3 hover:bg-[#201E1B] cursor-pointer transition-colors group"
						>
							<div class="flex items-center gap-3">
								<span class="text-2xl" x-text="file.icon || '📄'"></span>
								<div>
									<div class="font-bold text-sm text-white group-hover:text-[#FACC15] transition-colors" x-text="file.name"></div>
									<div class="text-[11px] text-[#A19A8F] font-mono" x-text="`SHA-256: ${file.cas_hash}`"></div>
								</div>
							</div>
							<div class="flex items-center gap-6 text-xs font-mono">
								<span class="text-[#A19A8F]" x-text="(file.size / 1024 > 1024) ? (file.size / (1024*1024)).toFixed(1) + ' MB' : (file.size / 1024).toFixed(1) + ' KB'"></span>
								<span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded font-semibold text-[10px]">DATABASE</span>
								<button class="text-[#FACC15] hover:underline font-bold">Detail →</button>
							</div>
						</div>
					</template>
				</div>
			</div>

		</div>

		<!-- FILE DETAILS & ACTIONS MODAL -->
		<div 
			x-show="$store.drive && $store.drive.selectedFile" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50 p-4"
		>
			<div 
				@click.away="$store.drive.selectedFile = null" 
				class="bg-[#171614] border border-[#FACC15] w-full max-w-lg rounded-2xl p-6 shadow-2xl space-y-5"
			>
				<div class="flex justify-between items-start border-b border-[#2A2723] pb-4">
					<div class="flex items-center gap-3">
						<div class="w-12 h-12 rounded-xl bg-[#0F0E0D] border border-[#FACC15]/40 flex items-center justify-center text-3xl">
							<span x-text="$store.drive.selectedFile ? $store.drive.selectedFile.icon : '📄'"></span>
						</div>
						<div>
							<h3 class="font-bold text-base text-white" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.name : ''"></h3>
							<p class="text-xs text-[#A19A8F] font-mono" x-text="$store.drive.selectedFile ? `Ukuran: ${($store.drive.selectedFile.size / 1024).toFixed(1)} KB` : ''"></p>
						</div>
					</div>
					<button @click="$store.drive.selectedFile = null" class="text-[#A19A8F] hover:text-white text-lg">✕</button>
				</div>

				<!-- Security & Cryptographic Details -->
				<div class="bg-[#0F0E0D] border border-[#2A2723] rounded-xl p-4 space-y-2 font-mono text-xs">
					<div class="flex justify-between text-[#A19A8F]">
						<span>Status Enkripsi:</span>
						<strong 
							:class="$store.drive.activeTab === 'vault' ? 'text-emerald-400' : 'text-amber-400'"
							x-text="$store.drive.activeTab === 'vault' ? 'AES-256-GCM (Swarm Vault)' : 'Penyimpanan Standar'"
						></strong>
					</div>
					<div class="flex justify-between text-[#A19A8F]">
						<span>Content Address (CAS):</span>
						<strong class="text-[#FACC15] truncate max-w-[200px]" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.cas_hash : ''"></strong>
					</div>
					<div class="flex justify-between text-[#A19A8F]">
						<span>MIME Type:</span>
						<strong class="text-white" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.mime_type : ''"></strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div class="flex gap-3 pt-2">
					<button 
						@click="$store.drive.downloadFile($store.drive.selectedFile)" 
						class="flex-1 hornetz-btn py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 text-xs font-bold"
					>
						<span>📥</span> <span x-text="$store.drive.activeTab === 'vault' ? 'Dekripsi & Unduh' : 'Unduh Berkas'"></span>
					</button>
					<button 
						@click="$store.drive.deleteFile($store.drive.selectedFile)" 
						class="bg-red-500/10 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/30 py-2.5 px-4 rounded-xl text-xs font-semibold transition-colors"
					>
						Hapus Berkas
					</button>
				</div>
			</div>
		</div>

	</div>
}
