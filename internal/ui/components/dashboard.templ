package components

import (
	"ztatic-go-framework/fullstack"
	"github.com/labstack/echo/v5"
)

templ Dashboard(c *echo.Context) {
	if fullstack.IsTurboFrame(c) {
		@DashboardContent()
	} else {
		@Layout("Dashboard Storage") {
			@DashboardContent()
		}
	}
}

templ DashboardContent() {
	<div id="dashboard-content" class="h-full flex flex-col" x-data>
		
		<!-- ACTION BAR & BREADCRUMBS -->
		<div class="h-14 border-b border-[#2A2723] px-6 flex items-center justify-between bg-[#171614] shrink-0">
			<!-- Breadcrumbs Path -->
			<div class="flex items-center gap-2 text-xs font-mono">
				<span class="text-[#FACC15] font-bold cursor-pointer" @click="$store.drive.setTab('storage')">Penyimpanan Saya</span>
				<span class="text-[#6E675E]">\</span>
				<span 
					:class="$store.drive.currentFolderId ? 'text-[#FACC15] cursor-pointer font-semibold' : 'text-white font-semibold'"
					@click="if ($store.drive.currentFolderId) $store.drive.clearFolder()"
					x-text="
						$store.drive.activeTab === 'storage' ? 'Penyimpanan Utama' : 
						($store.drive.activeTab === 'vault' ? 'Vault Terenkripsi' : 
						($store.drive.activeTab === 'recent' ? 'Berkas Terbaru' : 
						($store.drive.activeTab === 'starred' ? 'Berbintang' : 'Sampah')))
					"
				>Utama</span>
				<template x-for="(crumb, idx) in $store.drive.folderHistory" :key="crumb.id">
					<span class="flex items-center gap-2">
						<span class="text-[#6E675E]">\</span>
						<span 
							:class="idx === $store.drive.folderHistory.length - 1 ? 'text-white font-bold' : 'text-[#FACC15] cursor-pointer hover:underline font-semibold'" 
							@click="if (idx < $store.drive.folderHistory.length - 1) $store.drive.navigateToBreadcrumb(idx)" 
							x-text="crumb.name"
						></span>
					</span>
				</template>
			</div>

			<!-- View Switcher & Action Controls -->
			<div class="flex items-center gap-3">
				<!-- Empty Trash Button -->
				<button 
					x-show="$store.drive.activeTab === 'trash' && $store.drive.files.length > 0" 
					@click="$store.drive.emptyTrash()" 
					class="text-xs bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/40 px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-colors"
				>
					@IconTrash("w-3.5 h-3.5")
					<span>Kosongkan Sampah</span>
				</button>

				<!-- Vault Lock Button -->
				<button 
					x-show="$store.drive.activeTab === 'vault' && $store.drive.isVaultUnlocked" 
					@click="$store.drive.lockVault()" 
					class="text-xs bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 px-3 py-1.5 rounded-lg font-bold flex items-center gap-2 transition-colors"
				>
					@IconLock("w-3.5 h-3.5")
					<span>Kunci Vault</span>
				</button>
				
				<!-- Sort Controls -->
				<div class="relative" x-data="{ sortOpen: false }">
					<button @click="sortOpen = !sortOpen" class="text-xs bg-[#0F0E0D] border border-[#2A2723] text-[#A19A8F] hover:text-white px-3 py-1.5 rounded-lg flex items-center gap-1.5 font-mono">
						@IconArrowUpDown("w-3.5 h-3.5")
						<span>Urutkan</span>
					</button>
					<div x-show="sortOpen" @click.away="sortOpen = false" x-cloak style="display: none;" class="absolute right-0 mt-1 w-44 bg-[#171614] border border-[#2A2723] rounded-lg shadow-xl py-1 z-30 font-mono text-xs">
						<button @click="$store.drive.setSort('name', 'asc'); sortOpen = false" class="w-full text-left px-3 py-1.5 hover:bg-[#201E1B] text-[#A19A8F] hover:text-[#FACC15]">Nama (A-Z)</button>
						<button @click="$store.drive.setSort('name', 'desc'); sortOpen = false" class="w-full text-left px-3 py-1.5 hover:bg-[#201E1B] text-[#A19A8F] hover:text-[#FACC15]">Nama (Z-A)</button>
						<button @click="$store.drive.setSort('size', 'desc'); sortOpen = false" class="w-full text-left px-3 py-1.5 hover:bg-[#201E1B] text-[#A19A8F] hover:text-[#FACC15]">Ukuran (Terbesar)</button>
						<button @click="$store.drive.setSort('size', 'asc'); sortOpen = false" class="w-full text-left px-3 py-1.5 hover:bg-[#201E1B] text-[#A19A8F] hover:text-[#FACC15]">Ukuran (Terkecil)</button>
						<button @click="$store.drive.setSort('created_at', 'desc'); sortOpen = false" class="w-full text-left px-3 py-1.5 hover:bg-[#201E1B] text-[#A19A8F] hover:text-[#FACC15]">Waktu (Terbaru)</button>
						<button @click="$store.drive.setSort('created_at', 'asc'); sortOpen = false" class="w-full text-left px-3 py-1.5 hover:bg-[#201E1B] text-[#A19A8F] hover:text-[#FACC15]">Waktu (Terlama)</button>
					</div>
				</div>

				<div class="flex bg-[#0F0E0D] border border-[#2A2723] p-1 rounded-lg">
					<button 
						@click="$store.drive.setViewMode('grid')" 
						:class="$store.drive.viewMode === 'grid' ? 'bg-[#FACC15] text-[#0F0E0D] font-bold shadow' : 'text-[#A19A8F] hover:text-white'" 
						class="px-3 py-1 text-xs rounded transition-all flex items-center gap-1.5 font-medium"
					>
						@IconGrid("w-3.5 h-3.5")
						<span>Tampilan Grid</span>
					</button>
					<button 
						@click="$store.drive.setViewMode('list')" 
						:class="$store.drive.viewMode === 'list' ? 'bg-[#FACC15] text-[#0F0E0D] font-bold shadow' : 'text-[#A19A8F] hover:text-white'" 
						class="px-3 py-1 text-xs rounded transition-all flex items-center gap-1.5 font-medium"
					>
						@IconList("w-3.5 h-3.5")
						<span>Tampilan Daftar</span>
					</button>
				</div>
			</div>
		</div>

		<!-- WORKSPACE CONTENT AREA -->
		<div class="flex-1 overflow-y-auto p-6 space-y-8">

			<!-- SECTION 1: FOLDERS / CELLS -->
			<div x-show="($store.drive.activeTab === 'storage' || $store.drive.activeTab === 'vault') && ($store.drive.folders.length > 0 || !$store.drive.currentFolderId)" class="space-y-4">
				<div class="flex justify-between items-center">
					<h3 class="text-xs font-mono text-[#FACC15] uppercase tracking-wider font-bold flex items-center gap-2">
						<template x-if="$store.drive.activeTab === 'vault'">
							@IconShieldCheck("w-4 h-4")
						</template>
						<template x-if="$store.drive.activeTab !== 'vault'">
							@IconFolder("w-4 h-4")
						</template>
						<span x-text="$store.drive.currentFolderId ? 'SUBFOLDER' : ($store.drive.activeTab === 'vault' ? 'VAULT CELLS TERENKRIPSI' : 'FOLDER UTAMA')"></span>
					</h3>
					<button 
						@click="$store.drive.showCreateFolderModal = true" 
						class="text-xs bg-[#201E1B] hover:bg-[#2A2723] text-[#FACC15] border border-[#FACC15]/30 px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-colors"
					>
						@IconPlus("w-3.5 h-3.5")
						<span>Buat Folder Baru</span>
					</button>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
					<template x-for="folder in $store.drive.folders" :key="folder.id">
						<div 
							@click="$store.drive.openFolder(folder)" 
							class="bg-[#171614] border border-[#2A2723] hover:border-[#FACC15] p-4 rounded-xl cursor-pointer group transition-all shadow-sm hover:shadow-lg hover:-translate-y-0.5 relative"
						>
							<div class="flex justify-between items-start mb-3">
								<div class="w-10 h-10 rounded-lg bg-[#FACC15]/10 border border-[#FACC15]/30 text-[#FACC15] flex items-center justify-center group-hover:bg-[#FACC15] group-hover:text-[#0F0E0D] transition-colors">
									<template x-if="$store.drive.activeTab === 'vault'">
										@IconShieldCheck("w-5 h-5")
									</template>
									<template x-if="$store.drive.activeTab !== 'vault'">
										@IconFolder("w-5 h-5")
									</template>
								</div>
								<div class="flex items-center gap-1">
									<template x-if="$store.drive.activeTab === 'vault'">
										<span class="text-[9px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 font-bold">TERENKRIPSI</span>
									</template>
									<template x-if="$store.drive.activeTab === 'storage'">
										<span class="text-[9px] font-mono text-amber-400/80 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20 font-bold">STANDAR</span>
									</template>
									<button 
										@click.stop="$store.drive.renameFolder(folder)" 
										title="Ubah Nama Folder"
										class="opacity-0 group-hover:opacity-100 text-[#A19A8F] hover:text-[#FACC15] p-1.5 rounded hover:bg-[#201E1B] transition-all"
									>
										@IconEdit("w-3.5 h-3.5")
									</button>
									<button 
										@click.stop="$store.drive.deleteFolder(folder)" 
										title="Hapus Folder"
										class="opacity-0 group-hover:opacity-100 text-[#A19A8F] hover:text-red-400 p-1.5 rounded hover:bg-red-500/10 transition-all"
									>
										@IconTrash("w-3.5 h-3.5")
									</button>
								</div>
							</div>
							<div class="font-bold text-sm text-white group-hover:text-[#FACC15] transition-colors truncate" x-text="folder.name"></div>
							<div class="text-[11px] text-[#A19A8F] font-mono mt-1" x-text="$store.drive.activeTab === 'vault' ? `${folder.file_count || 0} Berkas • AES-256-GCM` : `${folder.file_count || 0} Berkas • Standar`"></div>
						</div>
					</template>
				</div>
			</div>

			<!-- SECTION 2: FILES LIST / GRID -->
			<div class="space-y-4">
				<div class="flex justify-between items-center">
					<h3 class="text-xs font-mono text-[#A19A8F] uppercase tracking-wider font-bold flex items-center gap-2">
						<template x-if="$store.drive.activeTab === 'vault'">
							@IconShield("w-4 h-4 text-emerald-400")
						</template>
						<template x-if="$store.drive.activeTab === 'trash'">
							@IconTrash("w-4 h-4 text-red-400")
						</template>
						<template x-if="$store.drive.activeTab === 'starred'">
							@IconStar("w-4 h-4 text-[#FACC15]", true)
						</template>
						<template x-if="$store.drive.activeTab === 'recent'">
							@IconClock("w-4 h-4 text-blue-400")
						</template>
						<template x-if="$store.drive.activeTab === 'storage'">
							@IconHardDrive("w-4 h-4 text-[#FACC15]")
						</template>
						<span x-text="$store.drive.activeTab === 'vault' ? 'DAFTAR BERKAS TERENKRIPSI VAULT' : ($store.drive.activeTab === 'trash' ? 'DAFTAR BERKAS DI SAMPAH' : ($store.drive.activeTab === 'starred' ? 'DAFTAR BERKAS BERBINTANG' : ($store.drive.activeTab === 'recent' ? 'DAFTAR BERKAS TERBARU' : 'DAFTAR BERKAS TERSINKRON')))"></span>
					</h3>
					<span class="text-xs text-[#6E675E] font-mono" x-text="`Menampilkan ${$store.drive.files.length} berkas`"></span>
				</div>

				<!-- Empty State if no files -->
				<div x-show="$store.drive.files.length === 0" class="text-center py-16 border border-dashed border-[#2A2723] rounded-xl text-[#A19A8F] font-mono text-sm flex flex-col items-center justify-center space-y-3">
					<template x-if="$store.drive.activeTab === 'trash'">
						<div class="flex flex-col items-center space-y-2">
							<div class="w-12 h-12 rounded-full bg-red-500/10 text-red-400 flex items-center justify-center">
								@IconTrash("w-6 h-6")
							</div>
							<span>Tempat sampah kosong. Tidak ada berkas yang dihapus.</span>
						</div>
					</template>
					<template x-if="$store.drive.activeTab === 'starred'">
						<div class="flex flex-col items-center space-y-2">
							<div class="w-12 h-12 rounded-full bg-[#FACC15]/10 text-[#FACC15] flex items-center justify-center">
								@IconStar("w-6 h-6", false)
							</div>
							<span>Belum ada berkas berbintang. Tandai berkas favorit Anda dengan bintang.</span>
						</div>
					</template>
					<template x-if="$store.drive.activeTab === 'recent'">
						<div class="flex flex-col items-center space-y-2">
							<div class="w-12 h-12 rounded-full bg-blue-500/10 text-blue-400 flex items-center justify-center">
								@IconClock("w-6 h-6")
							</div>
							<span>Belum ada riwayat berkas terbaru.</span>
						</div>
					</template>
					<template x-if="$store.drive.activeTab !== 'trash' && $store.drive.activeTab !== 'starred' && $store.drive.activeTab !== 'recent'">
						<div class="flex flex-col items-center space-y-2">
							<div class="w-12 h-12 rounded-full bg-[#201E1B] text-[#A19A8F] flex items-center justify-center">
								@IconFolder("w-6 h-6")
							</div>
							<span>Belum ada berkas di kategori ini. Klik "+ Unggah Berkas" untuk mengunggah berkas baru.</span>
						</div>
					</template>
				</div>

				<!-- GRID VIEW -->
				<div x-show="$store.drive.viewMode === 'grid' && $store.drive.files.length > 0" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
					<template x-for="file in $store.drive.files" :key="file.id">
						<div 
							@click="$store.drive.selectedFile = file" 
							class="bg-[#171614] border border-[#2A2723] hover:border-[#FACC15] p-3 rounded-xl cursor-pointer group transition-all flex flex-col justify-between h-48 shadow-sm hover:shadow-lg hover:-translate-y-0.5 relative"
						>
							<div class="h-28 bg-[#0F0E0D] border border-[#2A2723] rounded-lg flex items-center justify-center text-[#FACC15] relative overflow-hidden group-hover:border-[#FACC15]/50 transition-colors">
								<div x-html="$store.drive.getFileIconSvg(file.icon, 'w-10 h-10')"></div>
								<div class="absolute bottom-1.5 right-1.5 text-[9px] bg-[#FACC15] text-[#0F0E0D] font-mono px-1.5 py-0.5 rounded font-bold uppercase truncate max-w-[50px]" x-text="(file.ext || 'FILE').slice(0, 4)"></div>
							</div>
							<div class="mt-2">
								<div class="font-semibold text-xs text-white truncate group-hover:text-[#FACC15] transition-colors" x-text="file.name"></div>
								<div class="flex justify-between items-center text-[10px] text-[#A19A8F] font-mono mt-1">
									<span x-text="(file.size >= 1073741824) ? (file.size / 1073741824).toFixed(2) + ' GB' : (file.size >= 1048576) ? (file.size / 1048576).toFixed(1) + ' MB' : (file.size >= 1024) ? (file.size / 1024).toFixed(1) + ' KB' : file.size + ' B'"></span>
									<span :class="file.is_deleted ? 'text-red-400 font-semibold text-[9px]' : 'text-emerald-400 font-semibold text-[9px]'" x-text="file.is_deleted ? 'DI SAMPAH' : 'TERSINKRON'"></span>
								</div>
								<div class="text-[9px] text-[#6E675E] font-mono truncate mt-0.5" x-text="file.created_at ? new Date(file.created_at).toLocaleDateString('id-ID') : ''"></div>
							</div>
						</div>
					</template>
				</div>

				<!-- DENSE LIST VIEW -->
				<div 
					x-show="$store.drive.viewMode === 'list' && $store.drive.files.length > 0" 
					class="border border-[#2A2723] rounded-xl overflow-hidden bg-[#171614] divide-y divide-[#2A2723]"
				>
					<template x-for="file in $store.drive.files" :key="file.id">
						<div 
							@click="$store.drive.selectedFile = file" 
							class="flex items-center justify-between px-4 py-3 hover:bg-[#201E1B] cursor-pointer transition-colors group"
						>
							<div class="flex items-center gap-3">
								<div class="w-8 h-8 rounded-lg bg-[#0F0E0D] border border-[#2A2723] flex items-center justify-center text-[#FACC15] shrink-0" x-html="$store.drive.getFileIconSvg(file.icon, 'w-4 h-4')"></div>
								<div>
									<div class="font-bold text-sm text-white group-hover:text-[#FACC15] transition-colors" x-text="file.name"></div>
									<div class="text-[11px] text-[#A19A8F] font-mono" x-text="`SHA-256: ${file.cas_hash}`"></div>
								</div>
							</div>
							<div class="flex items-center gap-6 text-xs font-mono">
								<span class="text-[#6E675E] text-[11px] hidden sm:inline" x-text="file.created_at ? new Date(file.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : ''"></span>
								<span class="text-[#A19A8F]" x-text="(file.size >= 1073741824) ? (file.size / 1073741824).toFixed(2) + ' GB' : (file.size >= 1048576) ? (file.size / 1048576).toFixed(1) + ' MB' : (file.size >= 1024) ? (file.size / 1024).toFixed(1) + ' KB' : file.size + ' B'"></span>
								<span :class="file.is_deleted ? 'bg-red-500/10 text-red-400 border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'" class="px-2 py-0.5 border rounded font-semibold text-[10px]" x-text="file.is_deleted ? 'DI SAMPAH' : 'TERSINKRON'"></span>
								<button class="text-[#FACC15] hover:underline font-bold">Detail →</button>
							</div>
						</div>
					</template>
				</div>
			</div>

		</div>

		<!-- FILE DETAILS & ACTIONS MODAL -->
		<div 
			x-show="$store.drive && $store.drive.selectedFile" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50 p-4"
		>
			<div 
				@click.away="$store.drive.selectedFile = null" 
				class="bg-[#171614] border border-[#FACC15] w-full max-w-lg rounded-2xl p-6 shadow-2xl space-y-5"
			>
				<div class="flex justify-between items-start border-b border-[#2A2723] pb-4">
					<div class="flex items-center gap-3">
						<div class="w-12 h-12 rounded-xl bg-[#0F0E0D] border border-[#FACC15]/40 flex items-center justify-center text-[#FACC15]" x-html="$store.drive.selectedFile ? $store.drive.getFileIconSvg($store.drive.selectedFile.icon, 'w-6 h-6') : ''">
						</div>
						<div>
							<h3 class="font-bold text-base text-white" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.name : ''"></h3>
							<p class="text-xs text-[#A19A8F] font-mono" x-text="$store.drive.selectedFile ? 'Ukuran: ' + ($store.drive.selectedFile.size >= 1073741824 ? ($store.drive.selectedFile.size / 1073741824).toFixed(2) + ' GB' : $store.drive.selectedFile.size >= 1048576 ? ($store.drive.selectedFile.size / 1048576).toFixed(1) + ' MB' : $store.drive.selectedFile.size >= 1024 ? ($store.drive.selectedFile.size / 1024).toFixed(1) + ' KB' : $store.drive.selectedFile.size + ' B') : ''"></p>
						</div>
					</div>
					<button @click="$store.drive.selectedFile = null" class="text-[#A19A8F] hover:text-white transition-colors">
						@IconX("w-5 h-5")
					</button>
				</div>

				<!-- Security & Cryptographic Details -->
				<div class="bg-[#0F0E0D] border border-[#2A2723] rounded-xl p-4 space-y-2 font-mono text-xs">
					<div class="flex justify-between text-[#A19A8F]">
						<span>Status Enkripsi:</span>
						<strong 
							:class="($store.drive.selectedFile && $store.drive.selectedFile.is_vault) ? 'text-emerald-400' : 'text-amber-400'"
							x-text="($store.drive.selectedFile && $store.drive.selectedFile.is_vault) ? 'AES-256-GCM (Swarm Vault)' : 'Penyimpanan Standar'"
						></strong>
					</div>
					<div class="flex justify-between text-[#A19A8F]">
						<span>Content Address (CAS):</span>
						<strong class="text-[#FACC15] truncate max-w-[200px]" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.cas_hash : ''"></strong>
					</div>
					<div class="flex justify-between text-[#A19A8F]">
						<span>MIME Type:</span>
						<strong class="text-white" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.mime_type : ''"></strong>
					</div>
					<div class="flex justify-between text-[#A19A8F]">
						<span>Waktu Dibuat:</span>
						<strong class="text-white" x-text="$store.drive.selectedFile && $store.drive.selectedFile.created_at ? new Date($store.drive.selectedFile.created_at).toLocaleString('id-ID') : '-'"></strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div class="flex gap-3 pt-2">
					<template x-if="$store.drive.activeTab === 'trash'">
						<div class="flex gap-3 w-full">
							<button 
								@click="$store.drive.restoreFile($store.drive.selectedFile)" 
								class="flex-1 hornetz-btn py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 text-xs font-bold"
							>
								@IconRefresh("w-4 h-4")
								<span>Pulihkan Berkas</span>
							</button>
							<button 
								@click="$store.drive.deleteFile($store.drive.selectedFile, true)" 
								class="bg-red-500/20 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/40 py-2.5 px-4 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition-colors"
							>
								@IconTrash("w-4 h-4")
								<span>Hapus Permanen</span>
							</button>
						</div>
					</template>

					<template x-if="$store.drive.activeTab !== 'trash'">
						<div class="flex gap-3 w-full">
							<button 
								@click="$store.drive.toggleStar($store.drive.selectedFile)" 
								class="bg-[#201E1B] hover:bg-[#2E2B26] text-[#FACC15] border border-[#FACC15]/30 py-2.5 px-3 rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5"
							>
								<template x-if="$store.drive.selectedFile && $store.drive.selectedFile.is_starred">
									<span class="flex items-center gap-1.5">
										@IconStar("w-4 h-4", true)
										<span>Berbintang</span>
									</span>
								</template>
								<template x-if="!$store.drive.selectedFile || !$store.drive.selectedFile.is_starred">
									<span class="flex items-center gap-1.5">
										@IconStar("w-4 h-4", false)
										<span>Beri Bintang</span>
									</span>
								</template>
							</button>
							<button 
								@click="$store.drive.downloadFile($store.drive.selectedFile)" 
								class="flex-1 hornetz-btn py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 text-xs font-bold"
							>
								@IconDownload("w-4 h-4")
								<span x-text="$store.drive.activeTab === 'vault' ? 'Dekripsi & Unduh' : 'Unduh Berkas'"></span>
							</button>
							<button 
								@click="$store.drive.renameFile($store.drive.selectedFile)" 
								class="bg-[#201E1B] hover:bg-[#2E2B26] text-amber-200 border border-white/10 py-2.5 px-3 rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5"
							>
								@IconEdit("w-4 h-4")
								<span>Ubah Nama</span>
							</button>
							<button 
								@click="$store.drive.deleteFile($store.drive.selectedFile, false)" 
								class="bg-red-500/10 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/30 py-2.5 px-4 rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5"
							>
								@IconTrash("w-4 h-4")
								<span>Ke Sampah</span>
							</button>
						</div>
					</template>
				</div>
			</div>
		</div>

	</div>
}
