package components

import (
	"ztatic-go-framework/fullstack"
	"github.com/labstack/echo/v5"
)

templ Dashboard(c *echo.Context) {
	if fullstack.IsTurboFrame(c) {
		@DashboardContent()
	} else {
		@Layout("Dashboard Storage") {
			@DashboardContent()
		}
	}
}

templ DashboardContent() {
	<div id="dashboard-content" class="h-full flex flex-col" x-data>
		
		<!-- ACTION BAR & BREADCRUMBS -->
		<div class="h-14 border-b border-white/[0.08] px-6 flex items-center justify-between hornetz-glass shrink-0 relative z-10">
			<!-- Breadcrumbs Path -->
			<div class="flex items-center gap-2 text-xs font-mono">
				<span class="text-[#D59D80] font-bold cursor-pointer hover:underline" @click="$store.drive.setTab('storage')">Penyimpanan Saya</span>
				<span class="text-[#8F9CA3]/60">\</span>
				<span 
					:class="$store.drive.currentFolderId ? 'text-[#D59D80] cursor-pointer font-semibold hover:underline' : 'text-white font-semibold'"
					@click="if ($store.drive.currentFolderId) $store.drive.clearFolder()"
					x-text="
						$store.drive.activeTab === 'storage' ? 'Penyimpanan Utama' : 
						($store.drive.activeTab === 'vault' ? 'Vault Terenkripsi' : 
						($store.drive.activeTab === 'recent' ? 'Berkas Terbaru' : 
						($store.drive.activeTab === 'starred' ? 'Berbintang' : 'Sampah')))
					"
				>Utama</span>
				<template x-for="(crumb, idx) in $store.drive.folderHistory" :key="crumb.id">
					<span class="flex items-center gap-2">
						<span class="text-[#8F9CA3]/60">\</span>
						<span 
							:class="idx === $store.drive.folderHistory.length - 1 ? 'text-white font-bold' : 'text-[#D59D80] cursor-pointer hover:underline font-semibold'" 
							@click="if (idx < $store.drive.folderHistory.length - 1) $store.drive.navigateToBreadcrumb(idx)" 
							x-text="crumb.name"
						></span>
					</span>
				</template>
			</div>

			<!-- View Switcher & Action Controls -->
			<div class="flex items-center gap-3">
				<!-- Empty Trash Button -->
				<button 
					x-show="$store.drive.activeTab === 'trash' && $store.drive.files.length > 0" 
					@click="$store.drive.emptyTrash()" 
					class="text-xs bg-red-500/15 hover:bg-red-500/25 text-red-400 border border-red-500/30 px-3 py-1.5 rounded-xl font-bold flex items-center gap-1.5 transition-all backdrop-blur-md"
				>
					<span>🗑️</span> Kosongkan Sampah
				</button>

				<!-- Vault Lock Button -->
				<button 
					x-show="$store.drive.activeTab === 'vault' && $store.drive.isVaultUnlocked" 
					@click="$store.drive.lockVault()" 
					class="text-xs bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/25 px-3 py-1.5 rounded-xl font-bold flex items-center gap-2 transition-all backdrop-blur-md"
				>
					<span>🔒</span> Kunci Vault
				</button>
				
				<!-- Sort Controls -->
				<div class="relative" x-data="{ sortOpen: false }">
					<button @click="sortOpen = !sortOpen" class="text-xs bg-white/[0.04] border border-white/[0.08] hover:border-white/20 text-[#C6C6D0] hover:text-white px-3 py-1.5 rounded-xl flex items-center gap-1.5 font-mono backdrop-blur-md transition-all">
						<span>⇅</span> Urutkan
					</button>
					<div x-show="sortOpen" @click.away="sortOpen = false" x-cloak style="display: none;" class="absolute right-0 mt-2 w-48 bg-[#0D1D25]/90 backdrop-blur-2xl border border-white/10 rounded-2xl shadow-2xl py-2 z-30 font-mono text-xs divide-y divide-white/[0.04]">
						<button @click="$store.drive.setSort('name', 'asc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-white/[0.06] text-[#C6C6D0] hover:text-[#D59D80] transition-colors">Nama (A-Z)</button>
						<button @click="$store.drive.setSort('name', 'desc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-white/[0.06] text-[#C6C6D0] hover:text-[#D59D80] transition-colors">Nama (Z-A)</button>
						<button @click="$store.drive.setSort('size', 'desc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-white/[0.06] text-[#C6C6D0] hover:text-[#D59D80] transition-colors">Ukuran (Terbesar)</button>
						<button @click="$store.drive.setSort('size', 'asc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-white/[0.06] text-[#C6C6D0] hover:text-[#D59D80] transition-colors">Ukuran (Terkecil)</button>
						<button @click="$store.drive.setSort('created_at', 'desc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-white/[0.06] text-[#C6C6D0] hover:text-[#D59D80] transition-colors">Waktu (Terbaru)</button>
						<button @click="$store.drive.setSort('created_at', 'asc'); sortOpen = false" class="w-full text-left px-3.5 py-2 hover:bg-white/[0.06] text-[#C6C6D0] hover:text-[#D59D80] transition-colors">Waktu (Terlama)</button>
					</div>
				</div>

				<!-- View Mode Segmented Pill Switcher (Board/List Glass Style) -->
				<div class="flex bg-white/[0.04] border border-white/[0.08] p-1 rounded-xl backdrop-blur-md">
					<button 
						@click="$store.drive.setViewMode('grid')" 
						:class="$store.drive.viewMode === 'grid' ? 'bg-gradient-to-r from-[#B6410F] to-[#D59D80] text-white font-bold shadow-md' : 'text-[#C6C6D0] hover:text-white'" 
						class="px-3 py-1 text-xs rounded-lg transition-all flex items-center gap-1 font-medium"
					>
						<span>田</span> Tampilan Grid
					</button>
					<button 
						@click="$store.drive.setViewMode('list')" 
						:class="$store.drive.viewMode === 'list' ? 'bg-gradient-to-r from-[#B6410F] to-[#D59D80] text-white font-bold shadow-md' : 'text-[#C6C6D0] hover:text-white'" 
						class="px-3 py-1 text-xs rounded-lg transition-all flex items-center gap-1 font-medium"
					>
						<span>≡</span> Tampilan Daftar
					</button>
				</div>
			</div>
		</div>

		<!-- WORKSPACE CONTENT AREA -->
		<div class="flex-1 overflow-y-auto p-6 space-y-8 relative z-10">

			<!-- SECTION 1: FOLDERS / CELLS -->
			<div x-show="($store.drive.activeTab === 'storage' || $store.drive.activeTab === 'vault') && ($store.drive.folders.length > 0 || !$store.drive.currentFolderId)" class="space-y-4">
				<div class="flex justify-between items-center">
					<h3 class="text-xs font-mono text-[#D59D80] uppercase tracking-wider font-bold flex items-center gap-2">
						<span x-text="$store.drive.activeTab === 'vault' ? '🛡️' : '📁'"></span>
						<span x-text="$store.drive.currentFolderId ? 'SUBFOLDER' : ($store.drive.activeTab === 'vault' ? 'VAULT CELLS TERENKRIPSI' : 'FOLDER UTAMA')"></span>
					</h3>
					<button 
						@click="$store.drive.showCreateFolderModal = true" 
						class="text-xs bg-white/[0.04] hover:bg-white/[0.08] text-[#D59D80] border border-[#D59D80]/30 px-3.5 py-1.5 rounded-xl font-bold flex items-center gap-1.5 transition-all backdrop-blur-md shadow-sm"
					>
						<span>+</span> Buat Folder Baru
					</button>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
					<template x-for="folder in $store.drive.folders" :key="folder.id">
						<div 
							@click="$store.drive.openFolder(folder)" 
							class="bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.08] hover:border-[#D59D80]/40 p-4 rounded-2xl cursor-pointer group transition-all shadow-sm hover:shadow-xl hover:-translate-y-0.5 relative backdrop-blur-md"
						>
							<div class="flex justify-between items-start mb-3">
								<div class="w-10 h-10 rounded-xl bg-[#104C64]/30 border border-[#104C64]/50 text-[#D59D80] flex items-center justify-center text-xl group-hover:bg-gradient-to-br group-hover:from-[#B6410F] group-hover:to-[#D59D80] group-hover:text-white transition-all shadow-sm">
									<span x-text="$store.drive.activeTab === 'vault' ? '🛡️' : '📁'"></span>
								</div>
								<div class="flex items-center gap-1">
									<template x-if="$store.drive.activeTab === 'vault'">
										<span class="text-[9px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20 font-bold">TERENKRIPSI</span>
									</template>
									<template x-if="$store.drive.activeTab === 'storage'">
										<span class="text-[9px] font-mono text-[#D59D80] bg-[#D59D80]/10 px-2 py-0.5 rounded-md border border-[#D59D80]/20 font-bold">STANDAR</span>
									</template>
									<button 
										@click.stop="$store.drive.renameFolder(folder)" 
										title="Ubah Nama Folder" 
										class="opacity-0 group-hover:opacity-100 text-[#8F9CA3] hover:text-[#D59D80] p-1 text-xs transition-opacity"
									>✏️</button>
									<button 
										@click.stop="$store.drive.deleteFolder(folder)" 
										title="Hapus Folder" 
										class="opacity-0 group-hover:opacity-100 text-[#8F9CA3] hover:text-red-400 p-1 text-xs transition-opacity"
									>🗑️</button>
								</div>
							</div>
							<div class="font-bold text-sm text-white group-hover:text-[#D59D80] transition-colors truncate" x-text="folder.name"></div>
							<div class="text-[11px] text-[#8F9CA3] font-mono mt-1" x-text="$store.drive.activeTab === 'vault' ? `${folder.file_count || 0} Berkas • AES-256-GCM` : `${folder.file_count || 0} Berkas • Standar`"></div>
						</div>
					</template>
				</div>
			</div>

			<!-- SECTION 2: FILES LIST / GRID -->
			<div class="space-y-4">
				<div class="flex justify-between items-center">
					<h3 class="text-xs font-mono text-[#8F9CA3] uppercase tracking-wider font-bold flex items-center gap-2">
						<span x-text="$store.drive.activeTab === 'vault' ? '🛡️' : ($store.drive.activeTab === 'trash' ? '🗑️' : ($store.drive.activeTab === 'starred' ? '⭐' : '⚡'))"></span>
						<span x-text="$store.drive.activeTab === 'vault' ? 'DAFTAR BERKAS TERENKRIPSI VAULT' : ($store.drive.activeTab === 'trash' ? 'DAFTAR BERKAS DI SAMPAH' : ($store.drive.activeTab === 'starred' ? 'DAFTAR BERKAS BERBINTANG' : ($store.drive.activeTab === 'recent' ? 'DAFTAR BERKAS TERBARU' : 'DAFTAR BERKAS TERSINKRON')))"></span>
					</h3>
					<span class="text-xs text-[#8F9CA3]/70 font-mono" x-text="`Menampilkan ${$store.drive.files.length} berkas`"></span>
				</div>

				<!-- Empty State if no files -->
				<div x-show="$store.drive.files.length === 0" class="text-center py-16 border border-dashed border-white/[0.08] rounded-2xl text-[#8F9CA3] font-mono text-sm bg-white/[0.02] backdrop-blur-md">
					<template x-if="$store.drive.activeTab === 'trash'">
						<span>🗑️ Tempat sampah kosong. Tidak ada berkas yang dihapus.</span>
					</template>
					<template x-if="$store.drive.activeTab === 'starred'">
						<span>⭐ Belum ada berkas berbintang. Tandai berkas favorit Anda dengan bintang.</span>
					</template>
					<template x-if="$store.drive.activeTab === 'recent'">
						<span>🕒 Belum ada riwayat berkas terbaru.</span>
					</template>
					<template x-if="$store.drive.activeTab !== 'trash' && $store.drive.activeTab !== 'starred' && $store.drive.activeTab !== 'recent'">
						<span>📭 Belum ada berkas di kategori ini. Klik "+ Berkas" untuk mengunggah berkas baru.</span>
					</template>
				</div>

				<!-- GRID VIEW -->
				<div x-show="$store.drive.viewMode === 'grid' && $store.drive.files.length > 0" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
					<template x-for="file in $store.drive.files" :key="file.id">
						<div 
							@click="$store.drive.selectedFile = file" 
							class="bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.08] hover:border-[#D59D80]/40 p-3 rounded-2xl cursor-pointer group transition-all flex flex-col justify-between h-52 shadow-sm hover:shadow-xl hover:-translate-y-0.5 relative backdrop-blur-md"
						>
							<div class="h-28 bg-[#0D1D25]/50 border border-white/[0.06] rounded-xl flex items-center justify-center text-4xl text-[#D59D80] relative overflow-hidden group-hover:border-[#D59D80]/30 transition-all backdrop-blur-sm">
								<span x-text="file.icon || '📄'"></span>
								<div class="absolute bottom-1.5 right-1.5 text-[9px] bg-gradient-to-r from-[#B6410F] to-[#D59D80] text-white font-mono px-2 py-0.5 rounded-md font-bold uppercase truncate max-w-[55px] shadow-sm" x-text="(file.ext || 'FILE').slice(0, 4)"></div>
							</div>
							<div class="mt-2">
								<div class="font-semibold text-xs text-white truncate group-hover:text-[#D59D80] transition-colors" x-text="file.name"></div>
								<div class="flex justify-between items-center text-[10px] text-[#8F9CA3] font-mono mt-1">
									<span x-text="(file.size >= 1073741824) ? (file.size / 1073741824).toFixed(2) + ' GB' : (file.size >= 1048576) ? (file.size / 1048576).toFixed(1) + ' MB' : (file.size >= 1024) ? (file.size / 1024).toFixed(1) + ' KB' : file.size + ' B'"></span>
									<span :class="file.is_deleted ? 'text-red-400' : 'text-emerald-400'" class="flex items-center gap-1 font-semibold text-[9px]">
										<span class="w-1.5 h-1.5 rounded-full" :class="file.is_deleted ? 'bg-red-400' : 'bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.6)]'"></span>
										<span x-text="file.is_deleted ? 'DI SAMPAH' : 'TERSINKRON'"></span>
									</span>
								</div>
								<div class="text-[9px] text-[#8F9CA3]/60 font-mono truncate mt-0.5" x-text="file.created_at ? new Date(file.created_at).toLocaleDateString('id-ID') : ''"></div>
							</div>
						</div>
					</template>
				</div>

				<!-- DENSE LIST VIEW -->
				<div 
					x-show="$store.drive.viewMode === 'list' && $store.drive.files.length > 0" 
					class="border border-white/[0.08] rounded-2xl overflow-hidden bg-white/[0.02] backdrop-blur-xl divide-y divide-white/[0.06]"
				>
					<template x-for="file in $store.drive.files" :key="file.id">
						<div 
							@click="$store.drive.selectedFile = file" 
							class="flex items-center justify-between px-4 py-3 hover:bg-white/[0.05] cursor-pointer transition-colors group"
						>
							<div class="flex items-center gap-3">
								<span class="text-2xl" x-text="file.icon || '📄'"></span>
								<div>
									<div class="font-bold text-sm text-white group-hover:text-[#D59D80] transition-colors" x-text="file.name"></div>
									<div class="text-[11px] text-[#8F9CA3] font-mono" x-text="`SHA-256: ${file.cas_hash}`"></div>
								</div>
							</div>
							<div class="flex items-center gap-6 text-xs font-mono">
								<span class="text-[#8F9CA3]/60 text-[11px] hidden sm:inline" x-text="file.created_at ? new Date(file.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : ''"></span>
								<span class="text-[#8F9CA3]" x-text="(file.size >= 1073741824) ? (file.size / 1073741824).toFixed(2) + ' GB' : (file.size >= 1048576) ? (file.size / 1048576).toFixed(1) + ' MB' : (file.size >= 1024) ? (file.size / 1024).toFixed(1) + ' KB' : file.size + ' B'"></span>
								<span :class="file.is_deleted ? 'bg-red-500/10 text-red-400 border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'" class="px-2.5 py-0.5 border rounded-md font-semibold text-[10px] flex items-center gap-1">
									<span class="w-1.5 h-1.5 rounded-full" :class="file.is_deleted ? 'bg-red-400' : 'bg-emerald-400'"></span>
									<span x-text="file.is_deleted ? 'DI SAMPAH' : 'TERSINKRON'"></span>
								</span>
								<button class="text-[#D59D80] hover:underline font-bold">Detail →</button>
							</div>
						</div>
					</template>
				</div>
			</div>

		</div>

		<!-- FILE DETAILS & ACTIONS MODAL -->
		<div 
			x-show="$store.drive && $store.drive.selectedFile" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/75 backdrop-blur-xl flex items-center justify-center z-50 p-4"
		>
			<div 
				@click.away="$store.drive.selectedFile = null" 
				class="bg-[#0D1D25]/90 backdrop-blur-2xl border border-white/10 w-full max-w-lg rounded-2xl p-6 shadow-2xl space-y-5"
			>
				<div class="flex justify-between items-start border-b border-white/[0.08] pb-4">
					<div class="flex items-center gap-3">
						<div class="w-12 h-12 rounded-xl bg-white/[0.04] border border-[#D59D80]/40 flex items-center justify-center text-3xl">
							<span x-text="$store.drive.selectedFile ? $store.drive.selectedFile.icon : '📄'"></span>
						</div>
						<div>
							<h3 class="font-bold text-base text-white" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.name : ''"></h3>
							<p class="text-xs text-[#8F9CA3] font-mono" x-text="$store.drive.selectedFile ? 'Ukuran: ' + ($store.drive.selectedFile.size >= 1073741824 ? ($store.drive.selectedFile.size / 1073741824).toFixed(2) + ' GB' : $store.drive.selectedFile.size >= 1048576 ? ($store.drive.selectedFile.size / 1048576).toFixed(1) + ' MB' : $store.drive.selectedFile.size >= 1024 ? ($store.drive.selectedFile.size / 1024).toFixed(1) + ' KB' : $store.drive.selectedFile.size + ' B') : ''"></p>
						</div>
					</div>
					<button @click="$store.drive.selectedFile = null" class="text-[#8F9CA3] hover:text-white text-lg">✕</button>
				</div>

				<!-- Security & Cryptographic Details -->
				<div class="bg-white/[0.03] border border-white/[0.08] rounded-xl p-4 space-y-2 font-mono text-xs backdrop-blur-md">
					<div class="flex justify-between text-[#8F9CA3]">
						<span>Status Enkripsi:</span>
						<strong 
							:class="($store.drive.selectedFile && $store.drive.selectedFile.is_vault) ? 'text-emerald-400' : 'text-[#D59D80]'"
							x-text="($store.drive.selectedFile && $store.drive.selectedFile.is_vault) ? 'AES-256-GCM (Swarm Vault)' : 'Penyimpanan Standar'"
						></strong>
					</div>
					<div class="flex justify-between text-[#8F9CA3]">
						<span>Content Address (CAS):</span>
						<strong class="text-[#D59D80] truncate max-w-[200px]" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.cas_hash : ''"></strong>
					</div>
					<div class="flex justify-between text-[#8F9CA3]">
						<span>MIME Type:</span>
						<strong class="text-white" x-text="$store.drive.selectedFile ? $store.drive.selectedFile.mime_type : ''"></strong>
					</div>
					<div class="flex justify-between text-[#8F9CA3]">
						<span>Waktu Dibuat:</span>
						<strong class="text-white" x-text="$store.drive.selectedFile && $store.drive.selectedFile.created_at ? new Date($store.drive.selectedFile.created_at).toLocaleString('id-ID') : '-'"></strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div class="flex gap-3 pt-2">
					<template x-if="$store.drive.activeTab === 'trash'">
						<div class="flex gap-3 w-full">
							<button 
								@click="$store.drive.restoreFile($store.drive.selectedFile)" 
								class="flex-1 hornetz-btn py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 text-xs font-bold"
							>
								<span>♻️</span> Pulihkan Berkas
							</button>
							<button 
								@click="$store.drive.deleteFile($store.drive.selectedFile, true)" 
								class="bg-red-500/20 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/40 py-2.5 px-4 rounded-xl text-xs font-semibold transition-colors"
							>
								Hapus Permanen
							</button>
						</div>
					</template>

					<template x-if="$store.drive.activeTab !== 'trash'">
						<div class="flex gap-3 w-full">
							<button 
								@click="$store.drive.toggleStar($store.drive.selectedFile)" 
								class="bg-white/[0.04] hover:bg-white/[0.08] text-[#D59D80] border border-[#D59D80]/30 py-2.5 px-3 rounded-xl text-xs font-semibold transition-all backdrop-blur-md"
							>
								<span x-text="$store.drive.selectedFile && $store.drive.selectedFile.is_starred ? '★ Berbintang' : '☆ Beri Bintang'"></span>
							</button>
							<button 
								@click="$store.drive.downloadFile($store.drive.selectedFile)" 
								class="flex-1 hornetz-btn py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 text-xs font-bold"
							>
								<span>📥</span> <span x-text="$store.drive.activeTab === 'vault' ? 'Dekripsi & Unduh' : 'Unduh Berkas'"></span>
							</button>
							<button 
								@click="$store.drive.renameFile($store.drive.selectedFile)" 
								class="bg-white/[0.04] hover:bg-white/[0.08] text-[#EDEBE8] border border-white/10 py-2.5 px-3 rounded-xl text-xs font-semibold transition-all backdrop-blur-md"
							>
								<span>✏️</span> Ubah Nama
							</button>
							<button 
								@click="$store.drive.deleteFile($store.drive.selectedFile, false)" 
								class="bg-red-500/10 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/30 py-2.5 px-4 rounded-xl text-xs font-semibold transition-colors backdrop-blur-md"
							>
								Ke Sampah
							</button>
						</div>
					</template>
				</div>
			</div>
		</div>

	</div>
}
