package components

import (
	"github.com/labstack/echo/v5"
)

templ LandingPage(c *echo.Context) {
	<!DOCTYPE html>
	<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Hornetz Drive - Zero-Trust Encrypted Cloud Storage & HOTW Architecture</title>
		<meta name="description" content="Penyimpanan awan terenkripsi berstandar enterprise dengan AES-256-GCM streaming, 0-second deduplikasi CAS, pertahanan anti-forensik Chitin Shuffler, dan protokol Stinger Panic Purge."/>
		
		<!-- OpenGraph / Social Meta -->
		<meta property="og:title" content="Hornetz Drive - Zero-Trust Encrypted Cloud Storage"/>
		<meta property="og:description" content="Penyimpanan awan berkecepatan tinggi dengan enkripsi streaming AES-256-GCM, deduplikasi instan, dan arsitektur HOTW."/>
		<meta property="og:type" content="website"/>
		
		<!-- Styles & Frameworks -->
		<script src="https://cdn.tailwindcss.com"></script>
		<script type="module" src="https://cdn.skypack.dev/@hotwired/turbo"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"/>
		
		<style>
			[x-cloak] { display: none !important; }
			body {
				font-family: 'Plus Jakarta Sans', sans-serif;
				background-color: #0F0E0D;
				color: #E6E1DA;
			}
			.font-mono {
				font-family: 'JetBrains Mono', monospace;
			}
			.hornetz-btn {
				background: linear-gradient(135deg, #FACC15 0%, #EAB308 100%);
				color: #0F0E0D;
				font-weight: 700;
				transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.hornetz-btn:hover {
				background: linear-gradient(135deg, #FDE047 0%, #CA8A04 100%);
				transform: translateY(-2px);
				box-shadow: 0 6px 20px rgba(250, 204, 21, 0.3);
			}
			.hornetz-card {
				background: #171614;
				border: 1px solid #2A2723;
				transition: all 0.25s ease;
			}
			.hornetz-card:hover {
				border-color: #3D3831;
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
			}
			.hornetz-card-glow:hover {
				border-color: rgba(250, 204, 21, 0.4);
				box-shadow: 0 0 25px rgba(250, 204, 21, 0.12);
			}
			.glow-mesh {
				background: radial-gradient(circle at 50% -20%, rgba(250, 204, 21, 0.12), transparent 70%);
			}
			.grid-pattern {
				background-size: 32px 32px;
				background-image: linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				                  linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
			}
			::-webkit-scrollbar { width: 8px; }
			::-webkit-scrollbar-track { background: #0F0E0D; }
			::-webkit-scrollbar-thumb { background: #2A2723; border-radius: 4px; }
			::-webkit-scrollbar-thumb:hover { background: #FACC15; }
		</style>
	</head>
	<body class="min-h-screen flex flex-col bg-[#0F0E0D] text-[#E6E1DA] relative selection:bg-[#FACC15] selection:text-[#0F0E0D]" x-data="landingApp()">

		<!-- AMBIENT BACKGROUND GLOW -->
		<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
			<div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[550px] bg-[#FACC15]/10 rounded-full blur-[140px]"></div>
			<div class="absolute top-[800px] -left-40 w-[600px] h-[600px] bg-emerald-500/5 rounded-full blur-[160px]"></div>
			<div class="absolute top-[1800px] -right-40 w-[600px] h-[600px] bg-amber-500/5 rounded-full blur-[160px]"></div>
			<div class="absolute inset-0 grid-pattern opacity-60"></div>
		</div>

		<!-- STICKY NAVBAR -->
		<header class="sticky top-0 z-50 backdrop-blur-md bg-[#0F0E0D]/85 border-b border-[#2A2723] transition-all">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
				<!-- Brand Logo -->
				<a href="/" class="flex items-center gap-3 group">
					<div class="w-10 h-10 rounded-xl bg-[#FACC15] text-[#0F0E0D] flex items-center justify-center font-black text-2xl shadow-[0_0_15px_rgba(250,204,21,0.35)] group-hover:scale-105 transition-transform">
						🐝
					</div>
					<div>
						<div class="flex items-center gap-2">
							<span class="font-extrabold text-lg tracking-tight text-white">Hornetz <span class="text-[#FACC15]">Drive</span></span>
							<span class="text-[10px] px-2 py-0.5 bg-[#201E1B] text-[#FACC15] border border-[#3A3630] rounded-full font-mono font-semibold">v2.0 HOTW</span>
						</div>
						<p class="text-[11px] text-[#A19A8F] hidden sm:block">Zero-Trust Encrypted Cloud Engine</p>
					</div>
				</a>

				<!-- Desktop Nav Links -->
				<nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[#A19A8F]">
					<a href="#fitur" class="hover:text-[#FACC15] transition-colors">Fitur Utama</a>
					<a href="#arsitektur" class="hover:text-[#FACC15] transition-colors">Arsitektur</a>
					<a href="#demo" class="hover:text-[#FACC15] transition-colors flex items-center gap-1.5">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						Demo Interaktif
					</a>
					<a href="#kalkulator" class="hover:text-[#FACC15] transition-colors">Kalkulator CAS</a>
					<a href="#spesifikasi" class="hover:text-[#FACC15] transition-colors">Spesifikasi</a>
					<a href="#faq" class="hover:text-[#FACC15] transition-colors">FAQ</a>
				</nav>

				<!-- Header Action Buttons -->
				<div class="flex items-center gap-3">
					<!-- Telemetry Status Pill -->
					<div class="hidden lg:flex items-center gap-2 bg-[#171614] border border-[#2A2723] px-3 py-1.5 rounded-full text-xs font-mono">
						<span class="w-2 h-2 rounded-full bg-emerald-400"></span>
						<span class="text-[#A19A8F]">CAS Engine:</span>
						<span class="text-white font-bold" x-text="serverStatusText">Online</span>
					</div>

					<!-- Launch Drive App CTA -->
					<a 
						href="/app" 
						data-turbo="false"
						class="hornetz-btn px-5 py-2.5 rounded-xl text-sm font-bold flex items-center gap-2 shadow-lg"
					>
						<span>Buka Web Drive</span>
						<span class="text-base">→</span>
					</a>

					<!-- Mobile Menu Toggle Button -->
					<button 
						@click="mobileNavOpen = !mobileNavOpen" 
						class="md:hidden p-2 text-[#A19A8F] hover:text-white focus:outline-none"
						aria-label="Toggle navigation menu"
					>
						<svg x-show="!mobileNavOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
						<svg x-show="mobileNavOpen" x-cloak class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
					</button>
				</div>
			</div>

			<!-- Mobile Nav Drawer -->
			<div 
				x-show="mobileNavOpen" 
				x-cloak 
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0 -translate-y-4"
				x-transition:enter-end="opacity-100 translate-y-0"
				x-transition:leave="transition ease-in duration-150"
				x-transition:leave-start="opacity-100 translate-y-0"
				x-transition:leave-end="opacity-0 -translate-y-4"
				class="md:hidden bg-[#171614] border-b border-[#2A2723] px-6 py-5 space-y-4 font-medium text-sm"
			>
				<a @click="mobileNavOpen = false" href="#fitur" class="block text-[#E6E1DA] hover:text-[#FACC15]">Fitur Utama</a>
				<a @click="mobileNavOpen = false" href="#arsitektur" class="block text-[#E6E1DA] hover:text-[#FACC15]">Arsitektur HOTW</a>
				<a @click="mobileNavOpen = false" href="#demo" class="block text-[#E6E1DA] hover:text-[#FACC15]">Demo Interaktif</a>
				<a @click="mobileNavOpen = false" href="#kalkulator" class="block text-[#E6E1DA] hover:text-[#FACC15]">Kalkulator CAS</a>
				<a @click="mobileNavOpen = false" href="#spesifikasi" class="block text-[#E6E1DA] hover:text-[#FACC15]">Spesifikasi</a>
				<a @click="mobileNavOpen = false" href="#faq" class="block text-[#E6E1DA] hover:text-[#FACC15]">FAQ</a>
				<div class="pt-2 border-t border-[#2A2723]">
					<a href="/app" class="hornetz-btn w-full py-2.5 rounded-lg text-center block font-bold">Buka Web Drive →</a>
				</div>
			</div>
		</header>

		<!-- MAIN CONTENT WRAPPER -->
		<main class="flex-1 z-10">

			<!-- ========================================== -->
			<!-- SECTION 1: HERO SECTION                    -->
			<!-- ========================================== -->
			<section class="relative pt-16 pb-20 md:pt-24 md:pb-28 overflow-hidden">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
						
						<!-- Hero Copy -->
						<div class="lg:col-span-7 space-y-6 text-center lg:text-left">
							<!-- Security Pill Badge -->
							<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#1A1916] border border-[#3A3630] text-xs font-mono text-[#FACC15] shadow-inner">
								<span class="w-2 h-2 rounded-full bg-[#FACC15] animate-ping"></span>
								<span>Zero-Trust Enterprise Cloud • Go 1.26 + HOTW</span>
							</div>

							<!-- Main Title -->
							<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.12]">
								Benteng Awan Terenkripsi.<br/>
								<span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FACC15] via-[#FDE047] to-[#EAB308]">
									Nol Pengetahuan.
								</span><br/>
								Nol Latensi.
							</h1>

							<!-- Description -->
							<p class="text-base sm:text-lg text-[#A19A8F] max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
								Simpan, sinkronkan, dan streaming berkas enterprise dengan enkripsi streaming <strong class="text-white">AES-256-GCM</strong>, deduplikasi instan <strong class="text-white">Content-Addressable Storage (CAS)</strong>, dan pertahanan anti-forensik <strong class="text-white">Chitin Shuffler</strong>—semua dikemas dalam satu biner Go mandiri tanpa dependensi runtime.
							</p>

							<!-- Primary CTA Buttons -->
							<div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
								<a 
									href="/app" 
									data-turbo="false"
									class="hornetz-btn w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold flex items-center justify-center gap-2 shadow-xl shadow-yellow-500/20"
								>
									<span>Buka Web Drive Sekarang</span>
									<span>🚀</span>
								</a>

								<a 
									href="#demo" 
									class="w-full sm:w-auto px-7 py-4 rounded-xl text-base font-bold bg-[#171614] hover:bg-[#201E1B] text-white border border-[#2A2723] hover:border-[#FACC15]/50 flex items-center justify-center gap-2 transition-all"
								>
									<span>⚡ Coba Simulasi Enkripsi</span>
								</a>
							</div>

							<!-- Quickstart CLI One-Liner -->
							<div class="pt-4 max-w-lg mx-auto lg:mx-0">
								<div class="flex items-center justify-between bg-[#141311] border border-[#2A2723] rounded-xl px-4 py-3 font-mono text-xs text-[#A19A8F]">
									<div class="flex items-center gap-2 overflow-hidden truncate">
										<span class="text-[#FACC15] select-none font-bold">$</span>
										<span class="text-[#E6E1DA] truncate">docker run -d -p 8071:8071 opeteer/hornetzdrive:latest</span>
									</div>
									<button 
										@click="copyQuickstart()" 
										class="ml-3 shrink-0 px-2.5 py-1 bg-[#201E1B] hover:bg-[#2E2B26] text-white rounded text-[11px] font-semibold transition-colors flex items-center gap-1"
									>
										<span x-text="copiedQuickstart ? '✓ Tersalin' : 'Salin'">Salin</span>
									</button>
								</div>
							</div>

							<!-- Feature Badges -->
							<div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-[#A19A8F] font-medium">
								<div class="flex items-center gap-2">
									<span class="text-emerald-400 text-sm">✔</span>
									<span>0-Second CAS Deduplikasi</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="text-emerald-400 text-sm">✔</span>
									<span>Single Static Binary Go</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="text-emerald-400 text-sm">✔</span>
									<span>Stinger Panic Purge</span>
								</div>
							</div>
						</div>

						<!-- Hero Interactive Live Preview Card -->
						<div class="lg:col-span-5">
							<div class="hornetz-card rounded-2xl p-6 shadow-2xl relative border border-[#3A3630]/70 bg-gradient-to-b from-[#1C1A17] to-[#121110]">
								
								<!-- Window Top Bar -->
								<div class="flex items-center justify-between pb-4 border-b border-[#2A2723]">
									<div class="flex items-center gap-2">
										<span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
										<span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
										<span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
										<span class="ml-2 font-mono text-xs text-[#A19A8F]">hornetz-console: active</span>
									</div>
									<span class="text-[10px] font-mono px-2 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded">AES-256 STREAM</span>
								</div>

								<!-- Live Simulated Telemetry Widget -->
								<div class="mt-4 grid grid-cols-2 gap-3 font-mono text-xs">
									<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-xl">
										<div class="text-[#6E675E] text-[10px]">THROUGHPUT REAL-TIME</div>
										<div class="text-[#FACC15] font-bold text-base mt-0.5 flex items-center justify-between">
											<span x-text="simulatedSpeed">84.2 MB/s</span>
											<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
										</div>
									</div>
									<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-xl">
										<div class="text-[#6E675E] text-[10px]">DEDUPLIKASI EFISIENSI</div>
										<div class="text-emerald-400 font-bold text-base mt-0.5 flex items-center justify-between">
											<span x-text="simulatedRatio">68.4%</span>
											<span class="text-[10px] text-[#A19A8F]">0s Hit</span>
										</div>
									</div>
								</div>

								<!-- Interactive Mock File Stream -->
								<div class="mt-4 space-y-2.5">
									<div class="text-[11px] font-mono text-[#A19A8F] flex justify-between items-center px-1">
										<span>STREAM BUFFER INGESTION</span>
										<span class="text-[#FACC15]">3 Berkas Terenkripsi</span>
									</div>

									<!-- Mock File Item 1 -->
									<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-xl flex items-center justify-between text-xs">
										<div class="flex items-center gap-2.5 min-w-0">
											<div class="w-8 h-8 rounded-lg bg-[#201E1B] border border-[#3A3630] flex items-center justify-center text-sm shrink-0">
												🔐
											</div>
											<div class="min-w-0">
												<div class="text-white font-semibold truncate font-mono text-xs">financial_q4_audit.tar.enc</div>
												<div class="text-[10px] text-[#A19A8F] font-mono">CAS: 3a9f8c...4b1e • 42.8 MB</div>
											</div>
										</div>
										<span class="text-[10px] px-2 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded font-mono shrink-0">Lengkap</span>
									</div>

									<!-- Mock File Item 2 (Live Dedup Hit) -->
									<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-xl flex items-center justify-between text-xs">
										<div class="flex items-center gap-2.5 min-w-0">
											<div class="w-8 h-8 rounded-lg bg-[#201E1B] border border-[#3A3630] flex items-center justify-center text-sm shrink-0">
												📄
											</div>
											<div class="min-w-0">
												<div class="text-white font-semibold truncate font-mono text-xs">core_architecture_spec.pdf</div>
												<div class="text-[10px] text-[#A19A8F] font-mono">CAS: d7e291...0a33 • 5.1 MB</div>
											</div>
										</div>
										<span class="text-[10px] px-2 py-0.5 bg-[#FACC15]/10 text-[#FACC15] border border-[#FACC15]/30 rounded font-mono shrink-0">0s Dedup</span>
									</div>

									<!-- Mock File Item 3 -->
									<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-xl flex items-center justify-between text-xs">
										<div class="flex items-center gap-2.5 min-w-0">
											<div class="w-8 h-8 rounded-lg bg-[#201E1B] border border-[#3A3630] flex items-center justify-center text-sm shrink-0">
												🗄️
											</div>
											<div class="min-w-0">
												<div class="text-white font-semibold truncate font-mono text-xs">production_db_dump.sql.enc</div>
												<div class="text-[10px] text-[#A19A8F] font-mono">CAS: 8f441c...9972 • 280 MB</div>
											</div>
										</div>
										<span class="text-[10px] px-2 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded font-mono shrink-0">Terenkripsi</span>
									</div>
								</div>

								<!-- Live CAS Shuffler Banner -->
								<div class="mt-4 p-2.5 rounded-lg bg-[#141311] border border-[#2A2723] flex items-center justify-between text-[11px] font-mono">
									<div class="flex items-center gap-2">
										<span class="text-amber-400">🛡️</span>
										<span class="text-[#A19A8F]">Chitin Shuffler:</span>
										<span class="text-white">Rotasi Shard Aktif</span>
									</div>
									<span class="text-[#FACC15]">interval: 6h</span>
								</div>

							</div>
						</div>

					</div>
				</div>
			</section>

			<!-- ========================================== -->
			<!-- SECTION 2: LIVE REACTIVE CRYPTO & CAS DEMO -->
			<!-- ========================================== -->
			<section id="demo" class="py-20 border-t border-[#2A2723] bg-[#121110] relative">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					
					<!-- Section Header -->
					<div class="text-center max-w-3xl mx-auto space-y-4">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1F1D19] border border-[#3A3630] text-xs font-mono text-[#FACC15]">
							<span>⚡ Interaktif Browser Playground</span>
						</div>
						<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
							Coba Enkripsi & Deduplikasi CAS Secara Langsung
						</h2>
						<p class="text-base text-[#A19A8F]">
							Ketikkan teks atau pilih contoh payload di bawah. Engine Web Crypto di peramban Anda akan menghitung hash SHA-256, jalur sharding CAS, dan mendeteksi deduplikasi 0-detik secara real-time.
						</p>
					</div>

					<!-- Interactive Demo Box -->
					<div class="mt-12 hornetz-card rounded-2xl p-6 sm:p-8 border border-[#3A3630] shadow-2xl space-y-8">
						
						<!-- Payload Preset Buttons -->
						<div class="flex flex-wrap items-center gap-2 sm:gap-3">
							<span class="text-xs font-mono text-[#A19A8F] mr-2">Pilih Sampel Data:</span>
							<button 
								@click="loadPreset('secret')" 
								:class="currentPreset === 'secret' ? 'bg-[#FACC15] text-[#0F0E0D] font-bold' : 'bg-[#0F0E0D] text-[#A19A8F] hover:text-white border border-[#2A2723]'"
								class="px-3 py-1.5 rounded-lg text-xs font-mono transition-all"
							>
								🔒 Dokumen Rahasia
							</button>
							<button 
								@click="loadPreset('database')" 
								:class="currentPreset === 'database' ? 'bg-[#FACC15] text-[#0F0E0D] font-bold' : 'bg-[#0F0E0D] text-[#A19A8F] hover:text-white border border-[#2A2723]'"
								class="px-3 py-1.5 rounded-lg text-xs font-mono transition-all"
							>
								🗄️ Backup Database
							</button>
							<button 
								@click="loadPreset('code')" 
								:class="currentPreset === 'code' ? 'bg-[#FACC15] text-[#0F0E0D] font-bold' : 'bg-[#0F0E0D] text-[#A19A8F] hover:text-white border border-[#2A2723]'"
								class="px-3 py-1.5 rounded-lg text-xs font-mono transition-all"
							>
								💻 Kode Sumber Go
							</button>
						</div>

						<!-- Input Plaintext Area -->
						<div class="space-y-2">
							<div class="flex items-center justify-between text-xs font-mono">
								<label for="demo-input" class="text-white font-semibold flex items-center gap-2">
									<span>1. Masukkan Konten Data (Plaintext Payload)</span>
								</label>
								<span class="text-[#A19A8F]" x-text="'Panjang: ' + inputPayload.length + ' karakter • ' + byteSize + ' bytes'"></span>
							</div>
							<textarea 
								id="demo-input"
								x-model="inputPayload" 
								@input="computeCrypto()" 
								rows="3" 
								class="w-full bg-[#0F0E0D] border border-[#2A2723] rounded-xl p-4 text-sm font-mono text-white focus:outline-none focus:border-[#FACC15] transition-colors resize-none placeholder-[#6E675E]"
								placeholder="Ketik teks rahasia di sini untuk melihat enkripsi dan CAS sharding langsung..."
							></textarea>
						</div>

						<!-- Real-Time Computed Outputs Grid -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							
							<!-- Output Card 1: CAS Content Address (SHA-256) -->
							<div class="bg-[#0F0E0D] border border-[#2A2723] rounded-xl p-4 space-y-3">
								<div class="flex items-center justify-between">
									<span class="text-xs font-mono font-bold text-[#FACC15] flex items-center gap-1.5">
										<span>#️⃣</span> Hash Konten CAS (SHA-256)
									</span>
									<span class="text-[10px] font-mono px-2 py-0.5 bg-[#201E1B] text-[#A19A8F] rounded">32 Bytes / 256 Bits</span>
								</div>
								<div class="bg-[#141311] border border-[#23201C] p-3 rounded-lg font-mono text-xs text-white break-all select-all font-semibold" x-text="computedHash || 'Menghitung hash...'">
									--
								</div>
								<div class="text-[11px] font-mono text-[#A19A8F] flex items-center gap-2">
									<span class="text-[#FACC15]">📂 Shard Path:</span>
									<span class="text-white font-semibold truncate" x-text="computedShardPath">storage/cas/--/--/...</span>
								</div>
							</div>

							<!-- Output Card 2: AES-256-GCM Streaming Framing -->
							<div class="bg-[#0F0E0D] border border-[#2A2723] rounded-xl p-4 space-y-3">
								<div class="flex items-center justify-between">
									<span class="text-xs font-mono font-bold text-emerald-400 flex items-center gap-1.5">
										<span>🔐</span> Frame Enkripsi AES-256-GCM
									</span>
									<span class="text-[10px] font-mono px-2 py-0.5 bg-[#201E1B] text-emerald-400 rounded">Stream Envelope</span>
								</div>
								<div class="bg-[#141311] border border-[#23201C] p-3 rounded-lg font-mono text-xs text-emerald-300 break-all truncate font-semibold" x-text="computedEnvelope">
									[4B LEN][12B NONCE][CIPHERTEXT + 16B GCM TAG]
								</div>
								<div class="text-[11px] font-mono text-[#A19A8F] flex items-center justify-between">
									<span>Derivasi Kunci: <strong class="text-white">Argon2id (64MB RAM)</strong></span>
									<span>Entropy: <strong class="text-[#FACC15]" x-text="computedEntropy + ' bits/byte'">--</strong></span>
								</div>
							</div>

						</div>

						<!-- Interactive Deduplication Test Action Bar -->
						<div class="p-5 rounded-xl bg-[#141311] border border-[#2A2723] flex flex-col sm:flex-row items-center justify-between gap-4">
							<div class="space-y-1 text-center sm:text-left">
								<div class="text-sm font-bold text-white flex items-center justify-center sm:justify-start gap-2">
									<span>Simulasi Ingesti Berkas ke Server</span>
									<span x-show="lastUploadResult === 'dedup'" class="text-xs font-mono px-2 py-0.5 bg-[#FACC15]/20 text-[#FACC15] border border-[#FACC15]/40 rounded-full font-bold">⚡ 0s Dedup Match!</span>
									<span x-show="lastUploadResult === 'new'" class="text-xs font-mono px-2 py-0.5 bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 rounded-full font-bold">✓ Berkas Baru Tersimpan</span>
								</div>
								<p class="text-xs text-[#A19A8F]" x-text="uploadFeedbackText">
									Klik tombol di sebelah kanan untuk menyimulasikan penyimpanan berkas ke CAS. Jika Anda mengunggah hash yang sama dua kali, server tidak akan memakan disk tambahan.
								</p>
							</div>

							<!-- Upload Button -->
							<button 
								@click="simulateCASUpload()" 
								class="hornetz-btn shrink-0 px-6 py-3 rounded-xl text-xs font-bold flex items-center gap-2 shadow-lg"
							>
								<span>Unggah ke CAS Virtual</span>
								<span>⬆️</span>
							</button>
						</div>

						<!-- Deduplication Telemetry Results -->
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono text-xs text-center">
							<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-xl">
								<div class="text-[#6E675E] text-[10px]">TOTAL UPLOAD DICOBA</div>
								<div class="text-white font-bold text-lg mt-0.5" x-text="uploadAttempts">0</div>
							</div>
							<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-xl">
								<div class="text-[#6E675E] text-[10px]">0-DETIK DEDUPLIKASI TERDETEKSI</div>
								<div class="text-[#FACC15] font-bold text-lg mt-0.5" x-text="dedupHits">0</div>
							</div>
							<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-xl">
								<div class="text-[#6E675E] text-[10px]">DISK FISIK DIHEMAT</div>
								<div class="text-emerald-400 font-bold text-lg mt-0.5" x-text="bytesSavedFormatted">0 Bytes</div>
							</div>
						</div>

					</div>

				</div>
			</section>

			<!-- ========================================== -->
			<!-- SECTION 3: BENTO FEATURE GRID              -->
			<!-- ========================================== -->
			<section id="fitur" class="py-24 border-t border-[#2A2723] bg-[#0F0E0D] relative">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					
					<!-- Section Header -->
					<div class="text-center max-w-3xl mx-auto space-y-4">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1F1D19] border border-[#3A3630] text-xs font-mono text-[#FACC15]">
							<span>🛡️ Pilar Arsitektur Enterprise</span>
						</div>
						<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
							Keamanan Nol-Kompromi. Efisiensi Ekstrem.
						</h2>
						<p class="text-base text-[#A19A8F]">
							Dirancang dari awal untuk menahan ancaman forensik, menghemat kapasitas disk hingga 70%, dan beroperasi tanpa hambatan jaringan.
						</p>
					</div>

					<!-- Bento Grid -->
					<div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						
						<!-- Card 1: Streaming AES-256-GCM -->
						<div class="hornetz-card hornetz-card-glow rounded-2xl p-7 space-y-4 flex flex-col justify-between">
							<div class="space-y-4">
								<div class="w-12 h-12 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-2xl text-amber-400">
									🔐
								</div>
								<h3 class="text-xl font-bold text-white">Streaming Enkripsi AES-256-GCM</h3>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Memproses data blok-demi-blok secara streaming langsung dari request buffer tanpa membebani RAM server, lengkap dengan nonce acak 12-byte per frame dan tag integritas GCM 16-byte.
								</p>
							</div>
							<div class="pt-4 border-t border-[#2A2723] flex items-center justify-between text-xs font-mono text-[#6E675E]">
								<span>RFC 5116 AEAD</span>
								<span class="text-[#FACC15]">0 Full-File RAM</span>
							</div>
						</div>

						<!-- Card 2: 0-Second CAS Deduplication -->
						<div class="hornetz-card hornetz-card-glow rounded-2xl p-7 space-y-4 flex flex-col justify-between">
							<div class="space-y-4">
								<div class="w-12 h-12 rounded-xl bg-yellow-400/10 border border-yellow-400/30 flex items-center justify-center text-2xl text-yellow-400">
									⚡
								</div>
								<h3 class="text-xl font-bold text-white">0-Second CAS Deduplication</h3>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Setiap berkas diindeks secara kriptografis berdasarkan hash konten SHA-256. Konten yang sama yang diunggah oleh 100 pengguna hanya menggunakan 1 kali alokasi ruang penyimpanan fisik.
								</p>
							</div>
							<div class="pt-4 border-t border-[#2A2723] flex items-center justify-between text-xs font-mono text-[#6E675E]">
								<span>SHA-256 Sharded Index</span>
								<span class="text-emerald-400">Hemat ~60% Storage</span>
							</div>
						</div>

						<!-- Card 3: Chitin Shuffler Anti-Forensics -->
						<div class="hornetz-card hornetz-card-glow rounded-2xl p-7 space-y-4 flex flex-col justify-between">
							<div class="space-y-4">
								<div class="w-12 h-12 rounded-xl bg-red-400/10 border border-red-400/30 flex items-center justify-center text-2xl text-red-400">
									🦀
								</div>
								<h3 class="text-xl font-bold text-white">Chitin Shuffler Anti-Forensik</h3>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Worker latar belakang otomatis yang merotasi jalur shard penyimpanan dan memalsukan stempel waktu akses berkas (<code class="text-xs text-white">mtime</code>) secara acak untuk mematahkan analisis jejak forensik disk.
								</p>
							</div>
							<div class="pt-4 border-t border-[#2A2723] flex items-center justify-between text-xs font-mono text-[#6E675E]">
								<span>Autonomous Worker</span>
								<span class="text-red-400">Forensics Thwarted</span>
							</div>
						</div>

						<!-- Card 4: Resumable Multipart Engine -->
						<div class="hornetz-card hornetz-card-glow rounded-2xl p-7 space-y-4 flex flex-col justify-between">
							<div class="space-y-4">
								<div class="w-12 h-12 rounded-xl bg-blue-400/10 border border-blue-400/30 flex items-center justify-center text-2xl text-blue-400">
									🚀
								</div>
								<h3 class="text-xl font-bold text-white">Resumable Chunked Upload</h3>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Mendukung pengunggahan berkas multi-gigabyte yang dipecah menjadi fragmen biner dengan sesi terisolasi. Jika koneksi terputus, unggahan dapat dilanjutkan seketika tanpa mengulang dari awal.
								</p>
							</div>
							<div class="pt-4 border-t border-[#2A2723] flex items-center justify-between text-xs font-mono text-[#6E675E]">
								<span>50MB Chunk Pipeline</span>
								<span class="text-blue-400">Auto-Reap Stale</span>
							</div>
						</div>

						<!-- Card 5: Stinger Panic Purge Protocol -->
						<div class="hornetz-card hornetz-card-glow rounded-2xl p-7 space-y-4 flex flex-col justify-between">
							<div class="space-y-4">
								<div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-2xl text-red-500">
									🚨
								</div>
								<h3 class="text-xl font-bold text-white">Stinger Panic Purge Protocol</h3>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Protokol darurat sekali sentuh (<code class="text-xs text-white">POST /api/purge</code>) yang seketika menghapus kunci memori di RAM dan menimpa fisik seluruh blok berkas dengan byte acak kriptografis sebelum dihapus permanen.
								</p>
							</div>
							<div class="pt-4 border-t border-[#2A2723] flex items-center justify-between text-xs font-mono text-[#6E675E]">
								<span>Cryptographic Shredder</span>
								<span class="text-red-500">Zero Leakage</span>
							</div>
						</div>

						<!-- Card 6: HOTW Stack Single-Binary -->
						<div class="hornetz-card hornetz-card-glow rounded-2xl p-7 space-y-4 flex flex-col justify-between">
							<div class="space-y-4">
								<div class="w-12 h-12 rounded-xl bg-emerald-400/10 border border-emerald-400/30 flex items-center justify-center text-2xl text-emerald-400">
									⚡
								</div>
								<h3 class="text-xl font-bold text-white">HOTW Stack & Single Binary</h3>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Dibangun di atas Templ, Hotwire Turbo 8, Alpine.js, dan Server-Sent Events (SSE). UI reaktif langsung diperbarui dari mutasi DOM server tanpa bundle Node.js/SPA yang berat.
								</p>
							</div>
							<div class="pt-4 border-t border-[#2A2723] flex items-center justify-between text-xs font-mono text-[#6E675E]">
								<span>Go 1.26 + Echo v5</span>
								<span class="text-emerald-400">&lt;25MB RAM Usage</span>
							</div>
						</div>

					</div>

				</div>
			</section>

			<!-- ========================================== -->
			<!-- SECTION 4: INTERACTIVE DEDUP CALCULATOR    -->
			<!-- ========================================== -->
			<section id="kalkulator" class="py-24 border-t border-[#2A2723] bg-[#141311] relative">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					
					<!-- Section Header -->
					<div class="text-center max-w-3xl mx-auto space-y-4">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1F1D19] border border-[#3A3630] text-xs font-mono text-[#FACC15]">
							<span>📊 Estimasi Efisiensi Penyimpanan</span>
						</div>
						<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
							Kalkulator Penghematan CAS & Bandwidth
						</h2>
						<p class="text-base text-[#A19A8F]">
							Geser parameter di bawah untuk melihat bagaimana Content-Addressable Storage (CAS) Hornetz Drive memangkas biaya infrastruktur penyimpanan awan tim Anda.
						</p>
					</div>

					<div class="mt-14 max-w-4xl mx-auto hornetz-card rounded-2xl p-6 sm:p-10 border border-[#3A3630] shadow-2xl">
						
						<!-- Controls Grid -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
							
							<!-- Slider 1: Total Storage Capacity -->
							<div class="space-y-3">
								<div class="flex justify-between items-center text-sm">
									<label for="storage-slider" class="text-white font-bold">Kapasitas Berkas Total (TB)</label>
									<span class="font-mono text-[#FACC15] font-extrabold text-base" x-text="calcStorageTB + ' TB'">10 TB</span>
								</div>
								<input 
									id="storage-slider"
									type="range" 
									min="1" 
									max="100" 
									step="1" 
									x-model="calcStorageTB" 
									class="w-full accent-[#FACC15] bg-[#0F0E0D] h-2 rounded-lg cursor-pointer"
								/>
								<div class="flex justify-between text-[11px] font-mono text-[#6E675E]">
									<span>1 TB</span>
									<span>50 TB</span>
									<span>100 TB</span>
								</div>
							</div>

							<!-- Slider 2: Redundancy / Duplication Ratio -->
							<div class="space-y-3">
								<div class="flex justify-between items-center text-sm">
									<label for="redundancy-slider" class="text-white font-bold">Tingkat Redundansi / Duplikasi (%)</label>
									<span class="font-mono text-emerald-400 font-extrabold text-base" x-text="calcRedundancy + '%'">40%</span>
								</div>
								<input 
									id="redundancy-slider"
									type="range" 
									min="10" 
									max="80" 
									step="5" 
									x-model="calcRedundancy" 
									class="w-full accent-emerald-400 bg-[#0F0E0D] h-2 rounded-lg cursor-pointer"
								/>
								<div class="flex justify-between text-[11px] font-mono text-[#6E675E]">
									<span>10% (Rendah)</span>
									<span>45% (Rata-rata Tim)</span>
									<span>80% (Tinggi)</span>
								</div>
							</div>

						</div>

						<!-- Divider -->
						<div class="my-8 border-t border-[#2A2723]"></div>

						<!-- Results Dynamic Grid -->
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
							
							<!-- Result 1: Space Saved -->
							<div class="bg-[#0F0E0D] border border-[#2A2723] p-5 rounded-2xl">
								<div class="text-[11px] font-mono text-[#A19A8F]">RUANG DISK DIHEMAT</div>
								<div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 mt-2 font-mono" x-text="savedStorageTB + ' TB'">
									4.0 TB
								</div>
								<div class="text-[11px] text-[#6E675E] mt-1 font-mono">Dieliminasi instan oleh CAS</div>
							</div>

							<!-- Result 2: Bandwidth Conserved -->
							<div class="bg-[#0F0E0D] border border-[#2A2723] p-5 rounded-2xl">
								<div class="text-[11px] font-mono text-[#A19A8F]">TRANSFER BANDWIDTH DIHEMAT</div>
								<div class="text-2xl sm:text-3xl font-extrabold text-[#FACC15] mt-2 font-mono" x-text="savedBandwidthTB + ' TB'">
									7.2 TB
								</div>
								<div class="text-[11px] text-[#6E675E] mt-1 font-mono">Tanpa re-upload berulang</div>
							</div>

							<!-- Result 3: Cloud Cost Saved -->
							<div class="bg-[#0F0E0D] border border-[#2A2723] p-5 rounded-2xl">
								<div class="text-[11px] font-mono text-[#A19A8F]">ESTIMASI HEMAT BIAYA TAHUNAN</div>
								<div class="text-2xl sm:text-3xl font-extrabold text-white mt-2 font-mono" x-text="'$' + annualSavingsUSD">
									$1,920
								</div>
								<div class="text-[11px] text-[#6E675E] mt-1 font-mono">Vs standar AWS S3 Standar</div>
							</div>

						</div>

					</div>

				</div>
			</section>

			<!-- ========================================== -->
			<!-- SECTION 5: ARCHITECTURE PIPELINE DEEP DIVE -->
			<!-- ========================================== -->
			<section id="arsitektur" class="py-24 border-t border-[#2A2723] bg-[#0F0E0D] relative">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					
					<!-- Section Header -->
					<div class="text-center max-w-3xl mx-auto space-y-4">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1F1D19] border border-[#3A3630] text-xs font-mono text-[#FACC15]">
							<span>🔍 Inspeksi Alur Data End-to-End</span>
						</div>
						<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
							Arsitektur Streaming Zero-Trust
						</h2>
						<p class="text-base text-[#A19A8F]">
							Jelajahi bagaimana paket data bergerak dari peramban hingga masuk ke sharding disk CAS yang diacak.
						</p>
					</div>

					<!-- Architecture Interactive Tabs -->
					<div class="mt-14 max-w-5xl mx-auto space-y-6">
						
						<!-- Tabs Header -->
						<div class="flex flex-wrap items-center justify-center gap-2 border-b border-[#2A2723] pb-4">
							<button 
								@click="archTab = 1" 
								:class="archTab === 1 ? 'border-[#FACC15] text-[#FACC15] bg-[#1F1D19]' : 'border-transparent text-[#A19A8F] hover:text-white'" 
								class="px-4 py-2.5 rounded-xl border text-xs sm:text-sm font-bold font-mono transition-all flex items-center gap-2"
							>
								<span>1. Handshake & Master Key</span>
							</button>
							<button 
								@click="archTab = 2" 
								:class="archTab === 2 ? 'border-[#FACC15] text-[#FACC15] bg-[#1F1D19]' : 'border-transparent text-[#A19A8F] hover:text-white'" 
								class="px-4 py-2.5 rounded-xl border text-xs sm:text-sm font-bold font-mono transition-all flex items-center gap-2"
							>
								<span>2. Streaming AES Chunking</span>
							</button>
							<button 
								@click="archTab = 3" 
								:class="archTab === 3 ? 'border-[#FACC15] text-[#FACC15] bg-[#1F1D19]' : 'border-transparent text-[#A19A8F] hover:text-white'" 
								class="px-4 py-2.5 rounded-xl border text-xs sm:text-sm font-bold font-mono transition-all flex items-center gap-2"
							>
								<span>3. Sharding CAS 0-Detik</span>
							</button>
							<button 
								@click="archTab = 4" 
								:class="archTab === 4 ? 'border-red-500 text-red-400 bg-red-500/10' : 'border-transparent text-[#A19A8F] hover:text-white'" 
								class="px-4 py-2.5 rounded-xl border text-xs sm:text-sm font-bold font-mono transition-all flex items-center gap-2"
							>
								<span>4. Stinger Purge Protocol</span>
							</button>
						</div>

						<!-- Tab Content Panels -->
						<div class="hornetz-card rounded-2xl p-6 sm:p-8 border border-[#3A3630]">
							
							<!-- Step 1 Panel -->
							<div x-show="archTab === 1" class="space-y-4">
								<div class="flex items-center justify-between">
									<h4 class="text-lg font-bold text-white flex items-center gap-2">
										<span>🔑 Derivasi Kunci Argon2id & Autentikasi Vault</span>
									</h4>
									<span class="text-xs font-mono text-[#FACC15]">Phase: Client Vault</span>
								</div>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Kunci enkripsi master (MEK) tidak pernah disimpan di disk dalam keadaan teks biasa. Saat autentikasi vault, kunci diturunkan menggunakan algoritma Argon2id berkekuatan tinggi (<code class="text-xs text-white">time=3, memory=64MB, threads=4</code>) dan disimpan sementara di secure memory RAM session dengan masa kedaluwarsa otomatis.
								</p>
								<div class="bg-[#0F0E0D] border border-[#2A2723] p-4 rounded-xl font-mono text-xs text-[#E6E1DA] overflow-x-auto space-y-1">
									<div class="text-[#6E675E]">/* Go Cryptographic Key Derivation Flow */</div>
									<div class="text-[#FACC15]">mek := argon2.IDKey([]byte(passphrase), salt, 3, 64*1024, 4, 32)</div>
									<div class="text-[#A19A8F]">sessionStore.StoreVaultKey(sessionID, mek, 15*time.Minute)</div>
								</div>
							</div>

							<!-- Step 2 Panel -->
							<div x-show="archTab === 2" x-cloak class="space-y-4">
								<div class="flex items-center justify-between">
									<h4 class="text-lg font-bold text-white flex items-center gap-2">
										<span>⚡ Chunked Stream AES-256-GCM Framing</span>
									</h4>
									<span class="text-xs font-mono text-emerald-400">Phase: Stream Pipeline</span>
								</div>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Pengunggahan berkas besar ditransmisikan dalam pecahan blok biner 64KB melalui <code class="text-xs text-white">crypto.EncryptStream</code>. Setiap blok dibungkus format biner terpadu: <code class="text-xs text-emerald-400">[4-byte length][12-byte nonce][ciphertext + 16-byte GCM auth tag]</code>. Server tidak pernah menampung seluruh berkas ke RAM.
								</p>
								<div class="bg-[#0F0E0D] border border-[#2A2723] p-4 rounded-xl font-mono text-xs text-[#E6E1DA] overflow-x-auto space-y-1">
									<div class="text-[#6E675E]">/* Stream Chunk Framing Engine */</div>
									<div class="text-white">blockNonce := make([]byte, 12)</div>
									<div class="text-white">binary.BigEndian.PutUint32(lenBuf, uint32(len(sealedBlock)))</div>
									<div class="text-emerald-400">writer.Write(lenBuf); writer.Write(blockNonce); writer.Write(sealedBlock)</div>
								</div>
							</div>

							<!-- Step 3 Panel -->
							<div x-show="archTab === 3" x-cloak class="space-y-4">
								<div class="flex items-center justify-between">
									<h4 class="text-lg font-bold text-white flex items-center gap-2">
										<span>🗂️ Content-Addressable Storage (CAS) Deep Sharding</span>
									</h4>
									<span class="text-xs font-mono text-[#FACC15]">Phase: Storage Sharding</span>
								</div>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Saat stream selesai, verifikasi hash SHA-256 dilakukan secara atomik. Berkas disimpan dalam struktur pohon hierarkis berlapis dua level: <code class="text-xs text-[#FACC15]">storage/cas/ab/cd/abcdef...</code> untuk mencegah bottleneck filesystem saat volume mencapai jutaan berkas.
								</p>
								<div class="bg-[#0F0E0D] border border-[#2A2723] p-4 rounded-xl font-mono text-xs text-[#E6E1DA] overflow-x-auto space-y-1">
									<div class="text-[#6E675E]">/* Zero-Second CAS Deduplication Check */</div>
									<div class="text-white">casPath := filepath.Join(casDir, hash[:2], hash[2:4], hash)</div>
									<div class="text-yellow-400">{ "if FileExists(casPath) { return LinkExistingCAS(fileID, hash) } /* 0-second dedup! */" }</div>
								</div>
							</div>

							<!-- Step 4 Panel -->
							<div x-show="archTab === 4" x-cloak class="space-y-4">
								<div class="flex items-center justify-between">
									<h4 class="text-lg font-bold text-red-400 flex items-center gap-2">
										<span>🚨 Stinger Panic Purge: Cryptographic Shredding</span>
									</h4>
									<span class="text-xs font-mono text-red-400">Phase: Emergency Obliteration</span>
								</div>
								<p class="text-sm text-[#A19A8F] leading-relaxed">
									Ketika ancaman fisik atau kompromi terdeteksi, Stinger Purge memusnahkan seluruh kunci sesi RAM dengan menimpanya dengan nol byte (<code class="text-xs text-white">memzero</code>), lalu menimpa seluruh blok penyimpanan disk dengan byte acak kriptografis dari <code class="text-xs text-white">crypto/rand</code> sebelum menghapus indeksnya.
								</p>
								<div class="bg-[#0F0E0D] border border-[#2A2723] p-4 rounded-xl font-mono text-xs text-[#E6E1DA] overflow-x-auto space-y-1">
									<div class="text-[#6E675E]">/* Disk Overwrite with Cryptographic Random Bytes */</div>
									<div class="text-red-400">io.CopyN(targetFile, rand.Reader, fileSize)</div>
									<div class="text-white">targetFile.Sync()</div>
									<div class="text-red-500">os.Remove(targetFile.Name()) /* Zero data recovery possible */</div>
								</div>
							</div>

						</div>

					</div>

				</div>
			</section>

			<!-- ========================================== -->
			<!-- SECTION 6: LIVE BACKEND TELEMETRY & PING   -->
			<!-- ========================================== -->
			<section class="py-20 border-t border-[#2A2723] bg-[#121110] relative">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="hornetz-card rounded-2xl p-8 border border-[#3A3630] bg-gradient-to-r from-[#171614] via-[#1A1916] to-[#171614]">
						<div class="flex flex-col lg:flex-row items-center justify-between gap-8">
							
							<!-- Telemetry Info -->
							<div class="space-y-2 text-center lg:text-left">
