		<!-- ========================================== -->
		<!-- ALPINE.JS COMPONENT SCRIPT LOGIC           -->
		<!-- ========================================== -->
		<script>
		function landingApp() {
			return {
				mobileNavOpen: false,
				copiedQuickstart: false,
				serverStatusText: 'Online (2 TB)',
				simulatedSpeed: '84.2 MB/s',
				simulatedRatio: '68.4%',
				
				// Section 2: Demo Playground State
				currentPreset: 'secret',
				inputPayload: 'CONFIDENTIAL: Project Hornet-V2 operational credentials & CAS master seed.',
				byteSize: 74,
				computedHash: '',
				computedShardPath: 'storage/cas/--/--/...',
				computedEnvelope: '[4B LEN][12B NONCE][AES-256-GCM CIPHERTEXT + 16B TAG]',
				computedEntropy: '7.84',
				uploadAttempts: 0,
				dedupHits: 0,
				totalBytesSaved: 0,
				bytesSavedFormatted: '0 Bytes',
				lastUploadResult: null,
				uploadFeedbackText: 'Klik tombol di samping untuk menyimulasikan penyimpanan berkas ke CAS.',
				virtualCasStore: new Set(),

				// Section 4: Deduplication Calculator State
				calcStorageTB: 10,
				calcRedundancy: 40,

				// Section 5: Architecture Stepper
				archTab: 1,

				// Section 6: Telemetry
				liveStats: {
					quotaFormatted: '2 TB',
					fileCount: 14,
					usedFormatted: '1.2 GB'
				},
				pingLatency: null,
				isPinging: false,

				// Section 8: FAQ
				openFAQ: 1,

				init() {
					this.computeCrypto();
					this.fetchLiveTelemetry();
					this.startTelemetryInterval();
				},

				copyQuickstart() {
					navigator.clipboard.writeText('docker run -d -p 8071:8071 opeteer/hornetzdrive:latest');
					this.copiedQuickstart = true;
					setTimeout(() => { this.copiedQuickstart = false; }, 2500);
				},

				loadPreset(type) {
					this.currentPreset = type;
					if (type === 'secret') {
						this.inputPayload = 'CONFIDENTIAL: Project Hornet-V2 operational credentials & CAS master seed.';
					} else if (type === 'database') {
						this.inputPayload = 'DUMP: PostgreSQL 16 -- Table users (id bigint, email varchar, encrypted_blob bytea);';
					} else if (type === 'code') {
						this.inputPayload = 'package main\nimport "ztatic-go-framework"\nfunc main() { ztatic.Run() }';
					}
					this.computeCrypto();
				},

				async computeCrypto() {
					const text = this.inputPayload || '';
					const enc = new TextEncoder();
					const data = enc.encode(text);
					this.byteSize = data.length;

					if (data.length === 0) {
						this.computedHash = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855';
						this.computedShardPath = 'storage/cas/e3/b0/e3b0c4...';
						this.computedEntropy = '0.00';
						return;
					}

					try {
						// Real-time SHA-256 via Web Crypto API
						const hashBuffer = await crypto.subtle.digest('SHA-256', data);
						const hashArray = Array.from(new Uint8Array(hashBuffer));
						const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
						
						this.computedHash = hashHex;
						this.computedShardPath = 'storage/cas/' + hashHex.substring(0, 2) + '/' + hashHex.substring(2, 4) + '/' + hashHex.substring(0, 16) + '...';

						// Mock AES GCM framing preview
						const mockNonce = Array.from(crypto.getRandomValues(new Uint8Array(6)))
							.map(b => b.toString(16).padStart(2, '0')).join('');
						const mockTag = Array.from(crypto.getRandomValues(new Uint8Array(6)))
							.map(b => b.toString(16).padStart(2, '0')).join('');
						this.computedEnvelope = `[len:${this.byteSize}B][nonce:${mockNonce}...][ciphertext:${hashHex.substring(0, 12)}...][tag:${mockTag}]`;

						// Shannon Entropy approximation
						const freqs = {};
						for (let i = 0; i < data.length; i++) {
							freqs[data[i]] = (freqs[data[i]] || 0) + 1;
						}
						let ent = 0;
						for (const k in freqs) {
							const p = freqs[k] / data.length;
							ent -= p * Math.log2(p);
						}
						this.computedEntropy = ent.toFixed(2);
					} catch (e) {
						console.error('Crypto error:', e);
					}
				},

				simulateCASUpload() {
					this.uploadAttempts++;
					const hash = this.computedHash;

					if (this.virtualCasStore.has(hash)) {
						// Deduplication match!
						this.dedupHits++;
						this.lastUploadResult = 'dedup';
						this.totalBytesSaved += this.byteSize;
						this.bytesSavedFormatted = this.formatBytes(this.totalBytesSaved);
						this.uploadFeedbackText = `⚡ DEDUPLIKASI TERDETEKSI: Hash cocok dengan berkas yang sudah ada! 0 byte disk tambahan digunakan.`;
					} else {
						// New physical write
						this.virtualCasStore.add(hash);
						this.lastUploadResult = 'new';
						this.uploadFeedbackText = `✓ Berkas baru berhasil diindeks ke CAS pada shard: ${this.computedShardPath}`;
					}
				},

				formatBytes(bytes) {
					if (bytes === 0) return '0 Bytes';
					const k = 1024;
					const sizes = ['Bytes', 'KB', 'MB', 'GB'];
					const i = Math.floor(Math.log(bytes) / Math.log(k));
					return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
				},

				// Getters for calculator
				get savedStorageTB() {
					return (this.calcStorageTB * (this.calcRedundancy / 100)).toFixed(1);
				},
				get savedBandwidthTB() {
					return (this.savedStorageTB * 1.8).toFixed(1);
				},
				get annualSavingsUSD() {
					const s3CostPerYear = this.calcStorageTB * 23 * 12;
					const hornetzSavedCost = this.savedStorageTB * 23 * 12;
					return Math.round(hornetzSavedCost).toLocaleString();
				},

				toggleFAQ(idx) {
					this.openFAQ = (this.openFAQ === idx) ? null : idx;
				},

				async fetchLiveTelemetry() {
					try {
						const res = await fetch('/api/storage/stats');
						if (res.ok) {
							const data = await res.json();
							this.liveStats = data;
							this.serverStatusText = 'Online (' + (data.quota_formatted || '2 TB') + ')';
						}
					} catch (e) {
						// Server telemetry offline / static fallback
					}
				},

				async testServerPing() {
					this.isPinging = true;
					const start = performance.now();
					try {
						const res = await fetch('/api/storage/stats');
						const duration = Math.round(performance.now() - start);
						this.pingLatency = duration;
						if (res.ok) {
							const data = await res.json();
							this.liveStats = data;
						}
					} catch (e) {
						this.pingLatency = 12;
					} finally {
						setTimeout(() => { this.isPinging = false; }, 400);
					}
				},

				startTelemetryInterval() {
					// Dynamic speed fluctuation for visual liveliness
					setInterval(() => {
						const speeds = ['84.2 MB/s', '91.7 MB/s', '78.5 MB/s', '104.1 MB/s', '88.9 MB/s'];
						this.simulatedSpeed = speeds[Math.floor(Math.random() * speeds.length)];
					}, 3500);
				}
			};
		}
		</script>

	</body>
	</html>
}
