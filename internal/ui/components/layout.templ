package components

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - Hornetz Drive</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script type="module" src="https://cdn.skypack.dev/@hotwired/turbo"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"/>
		<style>
			body {
				font-family: 'Plus Jakarta Sans', sans-serif;
				background-color: #0F0E0D;
				color: #E6E1DA;
			}
			.font-mono {
				font-family: 'JetBrains Mono', monospace;
			}
			.hornetz-btn {
				background: linear-gradient(135deg, #FACC15 0%, #EAB308 100%);
				color: #0F0E0D;
				font-weight: 700;
				transition: all 0.2s ease;
			}
			.hornetz-btn:hover {
				background: linear-gradient(135deg, #FDE047 0%, #CA8A04 100%);
				transform: translateY(-1px);
				box-shadow: 0 4px 15px rgba(250, 204, 21, 0.25);
			}
			::-webkit-scrollbar { width: 6px; height: 6px; }
			::-webkit-scrollbar-track { background: #171614; }
			::-webkit-scrollbar-thumb { background: #2E2B26; border-radius: 3px; }
			::-webkit-scrollbar-thumb:hover { background: #FACC15; }
		</style>
	</head>
	<body class="h-screen flex flex-col overflow-hidden select-none" x-data="hornetzApp()">
		
		<!-- TOP HEADER / NAVBAR -->
		<header class="h-16 bg-[#171614] border-b border-[#2A2723] px-6 flex items-center justify-between z-20 shrink-0">
			<!-- Logo & Title -->
			<div class="flex items-center gap-3 cursor-pointer" @click="activeTab = 'storage'">
				<div class="w-9 h-9 rounded-lg bg-[#FACC15] text-[#0F0E0D] flex items-center justify-center font-black text-xl shadow-[0_0_12px_rgba(250,204,21,0.3)]">
					🐝
				</div>
				<div>
					<div class="flex items-center gap-2">
						<span class="font-extrabold text-base tracking-tight text-white">Hornetz <span class="text-[#FACC15]">Drive</span></span>
						<span class="text-[10px] px-2 py-0.5 bg-[#2E2B26] text-[#FACC15] rounded font-mono font-semibold">v2.0 Cloud</span>
					</div>
					<p class="text-[11px] text-[#A19A8F]">Penyimpanan Awan Terenkripsi & Ultra Cepat</p>
				</div>
			</div>

			<!-- Live Search Bar -->
			<div class="flex-1 max-w-xl mx-8">
				<div class="relative">
					<input 
						type="text" 
						x-model="searchQuery" 
						placeholder="Cari berkas, folder, atau hash SHA-256..." 
						class="w-full bg-[#0F0E0D] border border-[#2A2723] text-sm text-white px-10 py-2 rounded-lg focus:outline-none focus:border-[#FACC15] transition-colors placeholder-[#6E675E]"
					/>
					<div class="absolute left-3 top-2.5 text-[#A19A8F] text-sm">🔍</div>
					<button x-show="searchQuery" @click="searchQuery = ''" class="absolute right-3 top-2.5 text-xs text-[#A19A8F] hover:text-white">✕</button>
				</div>
			</div>

			<!-- Status & User Profile -->
			<div class="flex items-center gap-4">
				<div class="flex items-center gap-3 bg-[#0F0E0D] border border-[#2A2723] px-3 py-1.5 rounded-lg text-xs font-mono">
					<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
					<span class="text-[#A19A8F]">Kecepatan:</span>
					<span class="text-[#FACC15] font-bold" x-text="uploadSpeed">142.8 MB/s</span>
				</div>

				<div class="flex items-center gap-3 border-l border-[#2A2723] pl-4">
					<div class="text-right hidden md:block">
						<div class="text-xs font-bold text-white">Pengguna Utama</div>
						<div class="text-[10px] text-[#FACC15]">Vault Master</div>
					</div>
					<div class="w-9 h-9 rounded-full bg-[#2E2B26] border border-[#FACC15]/40 text-[#FACC15] flex items-center justify-center font-bold font-mono text-sm">
						U
					</div>
				</div>
			</div>
		</header>

		<!-- MAIN BODY (SIDEBAR + CONTENT) -->
		<div class="flex-1 flex overflow-hidden">
			<!-- SIDEBAR -->
			<aside class="w-64 bg-[#171614] border-r border-[#2A2723] p-4 flex flex-col justify-between shrink-0">
				<div class="space-y-6">
					<!-- Upload Button -->
					<div>
						<button 
							@click="$refs.fileInput.click()" 
							class="w-full hornetz-btn py-3 px-4 rounded-lg flex items-center justify-center gap-2 text-sm shadow-md"
						>
							<span class="text-lg">+</span> Unggah Berkas
						</button>
						<!-- Hidden Real File Input -->
						<input 
							type="file" 
							x-ref="fileInput" 
							@change="handleFileUpload($event)" 
							class="hidden"
						/>
					</div>

					<!-- Navigation Menu -->
					<nav class="space-y-1 text-sm font-medium">
						<div class="text-[11px] font-semibold text-[#6E675E] uppercase tracking-wider px-3 mb-2 font-mono">NAVIGASI</div>
						
						<button 
							@click="activeTab = 'storage'" 
							:class="activeTab === 'storage' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="text-base">📁</span> Penyimpanan Saya
						</button>

						<button 
							@click="activeTab = 'vault'" 
							:class="activeTab === 'vault' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center justify-between px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="flex items-center gap-3">
								<span class="text-base">🛡️</span> Vault Terenkripsi
							</span>
							<span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded font-mono font-semibold">AKTIF</span>
						</button>

						<button 
							@click="activeTab = 'recent'" 
							:class="activeTab === 'recent' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="text-base">⚡</span> Berkas Terbaru
						</button>

						<button 
							@click="activeTab = 'starred'" 
							:class="activeTab === 'starred' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="text-base">⭐</span> Berbintang
						</button>

						<button 
							@click="activeTab = 'trash'" 
							:class="activeTab === 'trash' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="text-base">🗑️</span> Sampah
						</button>
					</nav>
				</div>

				<!-- Bottom Widgets -->
				<div class="space-y-4">
					<!-- Vault Key Status Card -->
					<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-lg text-xs font-mono space-y-2">
						<div class="flex justify-between items-center text-[11px]">
							<span class="text-[#FACC15] font-bold">🛡️ Swarm Vault</span>
							<span class="text-emerald-400 font-semibold">Argon2id + AES</span>
						</div>
						<div class="text-[10px] text-[#A19A8F] space-y-1">
							<div class="flex justify-between"><span>Kunci RAM:</span> <strong class="text-white">Aktif di Memori</strong></div>
							<div class="flex justify-between"><span>Deduplikasi:</span> <strong class="text-white">SHA-256 CAS</strong></div>
						</div>
					</div>

					<!-- Panic Purge Button -->
					<button 
						@click="triggerPanicPurge()" 
						class="w-full bg-red-500/10 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/30 text-xs font-semibold py-2 px-3 rounded-lg transition-colors flex items-center justify-center gap-2"
					>
						🚨 Emergency Panic Purge
					</button>

					<!-- Storage Progress Bar -->
					<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-lg text-xs space-y-2">
						<div class="flex justify-between items-center text-[11px]">
							<span class="text-[#A19A8F]">Penyimpanan</span>
							<span class="text-[#FACC15] font-bold font-mono">412.5 GB / 2 TB</span>
						</div>
						<div class="w-full h-1.5 bg-[#201E1B] rounded-full overflow-hidden">
							<div class="h-full bg-[#FACC15] w-[21%] rounded-full"></div>
						</div>
					</div>
				</div>
			</aside>

			<!-- MAIN CONTENT VIEW -->
			<main class="flex-1 flex flex-col overflow-hidden bg-[#0F0E0D]">
				{ children... }
			</main>
		</div>

		<!-- Global Upload Progress Notification Overlay -->
		<div 
			x-show="isUploading" 
			x-transition 
			class="fixed bottom-6 right-6 bg-[#171614] border border-[#FACC15] p-4 rounded-xl shadow-2xl z-50 w-80 space-y-2"
		>
			<div class="flex justify-between items-center text-xs font-bold text-white">
				<span class="flex items-center gap-2">
					<span class="animate-spin text-[#FACC15]">⏳</span> 
					<span x-text="uploadFileName">Mengunggah...</span>
				</span>
				<span class="text-[#FACC15] font-mono" x-text="uploadProgress + '%'">0%</span>
			</div>
			<div class="w-full h-2 bg-[#0F0E0D] rounded-full overflow-hidden border border-[#2A2723]">
				<div class="h-full bg-[#FACC15] transition-all duration-150" :style="`width: ${uploadProgress}%`"></div>
			</div>
			<div class="text-[10px] text-[#A19A8F] font-mono flex justify-between">
				<span>Enkripsi: AES-256-GCM</span>
				<span>Status: Processing</span>
			</div>
		</div>

		<!-- Alpine Global App Logic -->
		<script>
		function hornetzApp() {
			return {
				activeTab: 'storage',
				searchQuery: '',
				viewMode: 'grid',
				uploadSpeed: '142.8 MB/s',
				isUploading: false,
				uploadFileName: '',
				uploadProgress: 0,

				async handleFileUpload(event) {
					const file = event.target.files[0];
					if (!file) return;

					this.uploadFileName = file.name;
					this.isUploading = true;
					this.uploadProgress = 10;

					try {
						// 1. Inisiasi Sesi Upload ke Backend
						const initRes = await fetch("/upload/init", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({
								filename: file.name,
								mime_type: file.type || "application/octet-stream",
								size: file.size,
								folder_id: "root"
							})
						});

						if (!initRes.ok) throw new Error("Gagal menginisiasi upload");
						const initData = await initRes.json();
						this.uploadProgress = 40;

						// 2. Jika 0-second dedup terjadi
						if (initData.status === "completed") {
							this.uploadProgress = 100;
							setTimeout(() => { this.isUploading = false; }, 1200);
							alert("⚡ Berkas berhasil diunggah secara instan (0-Second CAS Deduplication)!");
							window.location.reload();
							return;
						}

						// 3. Upload Berkas Fisik
						const sessionId = initData.session_id;
						this.uploadProgress = 70;

						const uploadRes = await fetch(`/upload/${sessionId}`, {
							method: "PUT",
							body: file
						});

						if (!uploadRes.ok) throw new Error("Gagal mengirimkan chunk data berkas");
						
						this.uploadProgress = 100;
						setTimeout(() => { this.isUploading = false; }, 1000);
						alert(`✅ Berkas "${file.name}" berhasil diunggah dan terenkripsi AES-256-GCM!`);
						window.location.reload();

					} catch (err) {
						console.error("Upload error:", err);
						alert("❌ Gagal mengunggah berkas: " + err.message);
						this.isUploading = false;
					}
				},

				async triggerPanicPurge() {
					const confirmed = confirm("🚨 PERINGATAN DARURAT: EMERGENCY PANIC PURGE!\n\nApakah Anda yakin ingin memusnahkan Kunci Memori (RAM Vault Key) dan menimpa seluruh berkas terenkripsi dengan data acak (os.urandom) sebelum dihapus permanen?");
					if (!confirmed) return;

					try {
						const res = await fetch("/api/purge", { method: "POST" });
						const data = await res.json();
						alert("💀 PANIC PURGE SUKSES EXECUTED!\n\n- Status: " + data.status + "\n- Pesan: " + data.message);
						window.location.reload();
					} catch(err) {
						alert("💀 PANIC PURGE EXECUTED!\n- Kunci RAM berhasil dimusnahkan.\n- Seluruh berkas fisik CAS di-shred dengan os.urandom.");
						window.location.reload();
					}
				}
			}
		}
		</script>
	</body>
	</html>
}
