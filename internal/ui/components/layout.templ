package components

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - Hornetz Drive</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script type="module" src="https://cdn.skypack.dev/@hotwired/turbo"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"/>
		<style>
			[x-cloak] { display: none !important; }
			body {
				font-family: 'Plus Jakarta Sans', sans-serif;
				background-color: #0F0E0D;
				color: #E6E1DA;
			}
			.font-mono {
				font-family: 'JetBrains Mono', monospace;
			}
			.hornetz-btn {
				background: linear-gradient(135deg, #FACC15 0%, #EAB308 100%);
				color: #0F0E0D;
				font-weight: 700;
				transition: all 0.2s ease;
			}
			.hornetz-btn:hover {
				background: linear-gradient(135deg, #FDE047 0%, #CA8A04 100%);
				transform: translateY(-1px);
				box-shadow: 0 4px 15px rgba(250, 204, 21, 0.25);
			}
			::-webkit-scrollbar { width: 6px; height: 6px; }
			::-webkit-scrollbar-track { background: #171614; }
			::-webkit-scrollbar-thumb { background: #2E2B26; border-radius: 3px; }
			::-webkit-scrollbar-thumb:hover { background: #FACC15; }
		</style>
	</head>
	<body class="h-screen flex flex-col overflow-hidden select-none" x-data>
		
		<!-- TOP HEADER / NAVBAR -->
		<header class="h-16 bg-[#171614] border-b border-[#2A2723] px-6 flex items-center justify-between z-20 shrink-0">
			<!-- Logo & Title -->
			<div class="flex items-center gap-3 cursor-pointer" @click="$store.drive.setTab('storage')">
				<div class="w-9 h-9 rounded-lg bg-[#FACC15] text-[#0F0E0D] flex items-center justify-center font-black text-xl shadow-[0_0_12px_rgba(250,204,21,0.3)]">
					🐝
				</div>
				<div>
					<div class="flex items-center gap-2">
						<span class="font-extrabold text-base tracking-tight text-white">Hornetz <span class="text-[#FACC15]">Drive</span></span>
						<span class="text-[10px] px-2 py-0.5 bg-[#2E2B26] text-[#FACC15] rounded font-mono font-semibold">v2.0 Cloud</span>
					</div>
					<p class="text-[11px] text-[#A19A8F]">Penyimpanan Awan Terenkripsi Real-Time</p>
				</div>
			</div>

			<!-- Live Search Bar -->
			<div class="flex-1 max-w-xl mx-8">
				<div class="relative">
					<input 
						type="text" 
						x-model="$store.drive.searchQuery" 
						@input.debounce.300ms="$store.drive.fetchFiles()"
						placeholder="Cari berkas, folder, atau hash SHA-256..." 
						class="w-full bg-[#0F0E0D] border border-[#2A2723] text-sm text-white px-10 py-2 rounded-lg focus:outline-none focus:border-[#FACC15] transition-colors placeholder-[#6E675E]"
					/>
					<div class="absolute left-3 top-2.5 text-[#A19A8F] text-sm">🔍</div>
					<button x-show="$store.drive.searchQuery" @click="$store.drive.clearSearch()" class="absolute right-3 top-2.5 text-xs text-[#A19A8F] hover:text-white">✕</button>
				</div>
			</div>

			<!-- Status & User Profile -->
			<div class="flex items-center gap-4">
				<div class="flex items-center gap-3 bg-[#0F0E0D] border border-[#2A2723] px-3 py-1.5 rounded-lg text-xs font-mono">
					<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
					<span class="text-[#A19A8F]">Kecepatan:</span>
					<span class="text-[#FACC15] font-bold">142.8 MB/s</span>
				</div>

				<div class="flex items-center gap-3 border-l border-[#2A2723] pl-4">
					<div class="text-right hidden md:block">
						<div class="text-xs font-bold text-white">Pengguna Utama</div>
						<div class="text-[10px] text-[#FACC15]">Vault Master</div>
					</div>
					<div class="w-9 h-9 rounded-full bg-[#2E2B26] border border-[#FACC15]/40 text-[#FACC15] flex items-center justify-center font-bold font-mono text-sm">
						U
					</div>
				</div>
			</div>
		</header>

		<!-- MAIN BODY (SIDEBAR + CONTENT) -->
		<div class="flex-1 flex overflow-hidden">
			<!-- SIDEBAR -->
			<aside class="w-64 bg-[#171614] border-r border-[#2A2723] p-4 flex flex-col justify-between shrink-0">
				<div class="space-y-6">
					<!-- Upload Button -->
					<div>
						<button 
							@click="$refs.fileInput.click()" 
							class="w-full hornetz-btn py-3 px-4 rounded-lg flex items-center justify-center gap-2 text-sm shadow-md"
						>
							<span class="text-lg">+</span> Unggah Berkas
						</button>
						<!-- Hidden Real File Input -->
						<input 
							type="file" 
							x-ref="fileInput" 
							@change="$store.drive.uploadFile($event)" 
							class="hidden"
						/>
					</div>

					<!-- Navigation Menu -->
					<nav class="space-y-1 text-sm font-medium">
						<div class="text-[11px] font-semibold text-[#6E675E] uppercase tracking-wider px-3 mb-2 font-mono">NAVIGASI</div>
						
						<button 
							@click="$store.drive.setTab('storage')" 
							:class="$store.drive.activeTab === 'storage' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="text-base">📁</span> Penyimpanan Saya
						</button>

						<button 
							@click="$store.drive.setTab('vault')" 
							:class="$store.drive.activeTab === 'vault' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center justify-between px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="flex items-center gap-3">
								<span class="text-base">🛡️</span> Vault Terenkripsi
							</span>
							<span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded font-mono font-semibold">AKTIF</span>
						</button>

						<button 
							@click="$store.drive.setTab('recent')" 
							:class="$store.drive.activeTab === 'recent' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="text-base">⚡</span> Berkas Terbaru
						</button>

						<button 
							@click="$store.drive.setTab('starred')" 
							:class="$store.drive.activeTab === 'starred' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="text-base">⭐</span> Berbintang
						</button>

						<button 
							@click="$store.drive.setTab('trash')" 
							:class="$store.drive.activeTab === 'trash' ? 'bg-[#FACC15]/10 text-[#FACC15] border-l-4 border-[#FACC15] font-bold' : 'text-[#A19A8F] hover:text-white hover:bg-[#201E1B]'" 
							class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-r-lg transition-colors"
						>
							<span class="text-base">🗑️</span> Sampah
						</button>
					</nav>
				</div>

				<!-- Bottom Widgets -->
				<div class="space-y-4">
					<!-- Vault Key Status Card -->
					<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-lg text-xs font-mono space-y-2">
						<div class="flex justify-between items-center text-[11px]">
							<span class="text-[#FACC15] font-bold">🛡️ Swarm Vault</span>
							<span class="text-emerald-400 font-semibold">Argon2id + AES</span>
						</div>
						<div class="text-[10px] text-[#A19A8F] space-y-1">
							<div class="flex justify-between"><span>Kunci RAM:</span> <strong class="text-white">Aktif di Memori</strong></div>
							<div class="flex justify-between"><span>Deduplikasi:</span> <strong class="text-white">SHA-256 CAS</strong></div>
						</div>
					</div>

					<!-- Panic Purge Button -->
					<button 
						@click="$store.drive.triggerPanicPurge()" 
						class="w-full bg-red-500/10 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/30 text-xs font-semibold py-2 px-3 rounded-lg transition-colors flex items-center justify-center gap-2"
					>
						🚨 Emergency Panic Purge
					</button>

					<!-- Storage Progress Bar -->
					<div class="bg-[#0F0E0D] border border-[#2A2723] p-3 rounded-lg text-xs space-y-2">
						<div class="flex justify-between items-center text-[11px]">
							<span class="text-[#A19A8F]">Penyimpanan</span>
							<span class="text-[#FACC15] font-bold font-mono">412.5 GB / 2 TB</span>
						</div>
						<div class="w-full h-1.5 bg-[#201E1B] rounded-full overflow-hidden">
							<div class="h-full bg-[#FACC15] w-[21%] rounded-full"></div>
						</div>
					</div>
				</div>
			</aside>

			<!-- MAIN CONTENT VIEW -->
			<main class="flex-1 flex flex-col overflow-hidden bg-[#0F0E0D]">
				{ children... }
			</main>
		</div>

		<!-- Global Upload Progress Notification Overlay (Controlled strictly by $store.drive.isUploading) -->
		<div 
			x-show="$store.drive && $store.drive.isUploading" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed bottom-6 right-6 bg-[#171614] border border-[#FACC15] p-4 rounded-xl shadow-2xl z-50 w-80 space-y-2"
		>
			<div class="flex justify-between items-center text-xs font-bold text-white">
				<span class="flex items-center gap-2">
					<span class="animate-spin text-[#FACC15]">⏳</span> 
					<span x-text="$store.drive.uploadFileName">Mengunggah...</span>
				</span>
				<span class="text-[#FACC15] font-mono" x-text="$store.drive.uploadProgress + '%'">0%</span>
			</div>
			<div class="w-full h-2 bg-[#0F0E0D] rounded-full overflow-hidden border border-[#2A2723]">
				<div class="h-full bg-[#FACC15] transition-all duration-150" :style="`width: ${$store.drive.uploadProgress}%`"></div>
			</div>
			<div class="text-[10px] text-[#A19A8F] font-mono flex justify-between">
				<span>Enkripsi: AES-256-GCM</span>
				<span>Status: Processing</span>
			</div>
		</div>

		<!-- Vault Unlock Password Modal -->
		<div 
			x-show="$store.drive && $store.drive.showVaultPasswordModal" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/80 backdrop-blur-md flex items-center justify-center z-[100] p-4"
		>
			<div 
				@click.away="$store.drive.showVaultPasswordModal = false" 
				class="bg-[#171614] border-2 border-[#FACC15] w-full max-w-sm rounded-2xl p-6 shadow-2xl space-y-6"
			>
				<div class="text-center space-y-2">
					<div class="w-16 h-16 mx-auto bg-[#FACC15]/10 border border-[#FACC15]/40 rounded-full flex items-center justify-center text-4xl text-[#FACC15]">
						🛡️
					</div>
					<h3 class="font-bold text-lg text-white">Buka Vault Terenkripsi</h3>
					<p class="text-xs text-[#A19A8F]">Masukkan kata sandi master untuk mengakses berkas rahasia.</p>
				</div>
				
				<div class="space-y-4">
					<input 
						type="password" 
						x-model="$store.drive.vaultPassword" 
						@keydown.enter="$store.drive.unlockVault()"
						placeholder="Kata Sandi Master Vault" 
						class="w-full bg-[#0F0E0D] border border-[#2A2723] text-sm text-white px-4 py-3 rounded-lg focus:outline-none focus:border-[#FACC15] transition-colors placeholder-[#6E675E]"
					/>
					
					<div class="flex gap-3">
						<button 
							@click="$store.drive.showVaultPasswordModal = false" 
							class="flex-1 py-3 bg-[#0F0E0D] border border-[#2A2723] text-[#A19A8F] hover:text-white hover:border-[#6E675E] rounded-lg text-sm font-bold transition-colors"
						>
							Batal
						</button>
						<button 
							@click="$store.drive.unlockVault()" 
							class="flex-1 py-3 hornetz-btn font-bold text-sm rounded-lg"
						>
							Buka Vault
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Global Alpine.js Store Initializer -->
		<script>
		document.addEventListener('alpine:init', () => {
			Alpine.store('drive', {
				activeTab: 'storage',
				searchQuery: '',
				viewMode: 'grid',
				files: [],
				folders: [],
				selectedFile: null,
				currentFolderId: '',
				currentFolderName: '',
				isUploading: false,
				uploadFileName: '',
				uploadProgress: 0,
				isVaultUnlocked: false,
				showVaultPasswordModal: false,
				vaultPassword: '',

				init() {
					this.fetchFolders();
					this.fetchFiles();
				},

				setTab(tab) {
					if (tab === 'vault' && !this.isVaultUnlocked) {
						this.showVaultPasswordModal = true;
						return; // Do not switch to vault tab or load its contents until unlocked
					}
					if (tab !== 'vault') {
						this.lockVault(); // Automatically lock vault when leaving the tab
					}
					this.activeTab = tab;
					this.currentFolderId = '';
					this.currentFolderName = '';
					this.fetchFolders();
					this.fetchFiles();
				},

				openFolder(folder) {
					if (!folder) return;
					this.currentFolderId = folder.id;
					this.currentFolderName = folder.name;
					this.fetchFiles();
				},

				clearFolder() {
					this.currentFolderId = '';
					this.currentFolderName = '';
					this.fetchFiles();
				},

				clearSearch() {
					this.searchQuery = '';
					this.fetchFiles();
				},

				async fetchFiles() {
					try {
						const url = `/api/files?tab=${this.activeTab}&q=${encodeURIComponent(this.searchQuery)}&folder_id=${encodeURIComponent(this.currentFolderId)}`;
						const res = await fetch(url);
						if (res.ok) {
							this.files = await res.json();
						}
					} catch(e) {
						console.error("Fetch files error:", e);
					}
				},

				async fetchFolders() {
					try {
						const url = `/api/folders?tab=${this.activeTab}`;
						const res = await fetch(url);
						if (res.ok) {
							this.folders = await res.json();
						}
					} catch(e) {
						console.error("Fetch folders error:", e);
					}
				},

				async unlockVault() {
					try {
						const res = await fetch('/login', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'X-CSRF-Token': this.getCsrfToken()
							},
							body: JSON.stringify({ password: this.vaultPassword })
						});
						if (res.ok) {
							this.isVaultUnlocked = true;
							this.showVaultPasswordModal = false;
							this.vaultPassword = '';
							this.activeTab = 'vault';
							this.fetchFolders();
							this.fetchFiles();
						} else {
							alert("Password salah!");
						}
					} catch(e) {
						console.error("Unlock vault error:", e);
					}
				},

				lockVault() {
					this.isVaultUnlocked = false;
					this.files = [];
					this.folders = [];
				},

				getCsrfToken() {
					const match = document.cookie.match(new RegExp('(?:^|; )_csrf=([^;]+)'));
					return match ? decodeURIComponent(match[1]) : '';
				},

				async uploadFile(event) {
					const file = event.target.files[0];
					if (!file) return;

					this.uploadFileName = file.name;
					this.isUploading = true;
					this.uploadProgress = 15;

					let targetFolderId = this.currentFolderId;
					if (!targetFolderId) {
						targetFolderId = (this.activeTab === 'vault') ? 'f2' : 'f1';
					}

					try {
						const initRes = await fetch("/upload/init", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"X-CSRF-Token": this.getCsrfToken()
							},
							body: JSON.stringify({
								filename: file.name,
								mime_type: file.type || "application/octet-stream",
								size: file.size,
								folder_id: targetFolderId
							})
						});

						if (!initRes.ok) {
							const errData = await initRes.json().catch(() => ({}));
							throw new Error(errData.message || `Gagal inisiasi upload (Status HTTP ${initRes.status})`);
						}
						const initData = await initRes.json();
						this.uploadProgress = 50;

						if (initData.status === "completed") {
							await this.fetchFiles();
							this.uploadProgress = 100;
							setTimeout(() => { this.isUploading = false; }, 800);
							alert("⚡ Berkas berhasil diunggah secara instan (0-Second CAS Deduplication)!");
							return;
						}

						const sessionId = initData.session_id;
						this.uploadProgress = 75;

						const uploadRes = await fetch(`/upload/${sessionId}`, {
							method: "PUT",
							headers: {
								"X-CSRF-Token": this.getCsrfToken()
							},
							body: file
						});

						if (!uploadRes.ok) {
							const errData = await uploadRes.json().catch(() => ({}));
							throw new Error(errData.message || `Gagal mengunggah payload berkas (Status HTTP ${uploadRes.status})`);
						}
						
						await this.fetchFiles();
						this.uploadProgress = 100;
						setTimeout(() => { this.isUploading = false; }, 800);
						alert(`✅ Berkas "${file.name}" berhasil diunggah & tersimpan di basis data!`);

					} catch (err) {
						console.error("Upload error:", err);
						alert("❌ Gagal mengunggah berkas: " + err.message);
						this.isUploading = false;
					} finally {
						event.target.value = "";
					}
				},

				async deleteFile(file) {
					if (!file) return;
					if (!confirm(`Apakah Anda yakin ingin menghapus berkas "${file.name}"?`)) return;
					try {
						const res = await fetch(`/api/files/${file.id}`, {
							method: "DELETE",
							headers: {
								"X-CSRF-Token": this.getCsrfToken()
							}
						});
						if (res.ok) {
							this.selectedFile = null;
							this.fetchFiles();
						}
					} catch(e) {
						alert("Gagal menghapus berkas");
					}
				},

				downloadFile(file) {
					if (!file) return;
					window.open(`/api/files/${file.id}/download`, '_blank');
					this.selectedFile = null;
				},

				async triggerPanicPurge() {
					const confirmed = confirm("🚨 PERINGATAN DARURAT: EMERGENCY PANIC PURGE!\n\nApakah Anda yakin ingin memusnahkan Kunci Memori (RAM Vault Key) dan menimpa seluruh berkas terenkripsi dengan data acak (os.urandom) sebelum dihapus permanen?");
					if (!confirmed) return;

					try {
						const res = await fetch("/api/purge", {
							method: "POST",
							headers: {
								"X-CSRF-Token": this.getCsrfToken()
							}
						});
						const data = await res.json();
						alert("💀 PANIC PURGE SUKSES EXECUTED!\n\n- Status: " + data.status + "\n- Pesan: " + data.message);
						this.fetchFiles();
					} catch(err) {
						alert("💀 PANIC PURGE EXECUTED!\n- Kunci RAM berhasil dimusnahkan.");
						this.fetchFiles();
					}
				}
			});
		});
		</script>
	</body>
	</html>
}
