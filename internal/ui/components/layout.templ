package components

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - Hornetz Drive</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script type="module" src="https://cdn.skypack.dev/@hotwired/turbo"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>
		<style>
			:root {
				--bg-chitin: #0D0C0B;
				--panel-chitin: #161513;
				--card-terga: #1F1D1A;
				--border-joint: #2E2A24;
				--venom-yellow: #FACC15;
				--apex-amber: #F59E0B;
				--stinger-red: #EF4444;
			}
			body {
				background-color: var(--bg-chitin);
				color: #F4F4F0;
				font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
			}
			.stinger-btn {
				clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
				transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
			}
			.stinger-btn:hover {
				transform: translateY(-2px);
				box-shadow: 0 4px 20px rgba(250, 204, 21, 0.25);
			}
			.chitin-card {
				clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
				border: 1px solid var(--border-joint);
			}
			::-webkit-scrollbar { width: 6px; height: 6px; }
			::-webkit-scrollbar-track { background: var(--panel-chitin); }
			::-webkit-scrollbar-thumb { background: var(--border-joint); border-radius: 3px; }
			::-webkit-scrollbar-thumb:hover { background: var(--apex-amber); }
		</style>
	</head>
	<body class="h-screen flex flex-col overflow-hidden select-none">
		<!-- TOP NAVBAR -->
		<header class="h-16 bg-[#141311] border-b border-[#2E2A24] px-6 flex items-center justify-between z-20">
			<!-- Brand Logo -->
			<div class="flex items-center gap-3">
				<div class="w-10 h-10 bg-[#FACC15] text-[#0D0C0B] flex items-center justify-center font-extrabold text-xl stinger-btn shadow-[0_0_15px_rgba(250,204,21,0.4)]">
					⚡
				</div>
				<div>
					<div class="flex items-center gap-2">
						<span class="font-black tracking-wider text-lg text-white uppercase">HORNETZ<span class="text-[#FACC15]">DRIVE</span></span>
						<span class="text-[10px] px-2 py-0.5 bg-[#F59E0B]/20 text-[#FACC15] border border-[#F59E0B]/40 uppercase tracking-widest font-mono">v1.2 VESPA + DYNAMO VAULT</span>
					</div>
					<p class="text-[11px] text-[#A1988A] font-mono">ULTRA-FAST SELF-HOSTED STORAGE & SWARM VAULT</p>
				</div>
			</div>

			<!-- Search Bar -->
			<div class="flex-1 max-w-2xl mx-8">
				<div class="relative">
					<input type="text" placeholder="Cari sel berkas, tag, atau isi dokumen..." 
						class="w-full bg-[#1C1A17] border border-[#2E2A24] text-sm text-white px-11 py-2.5 rounded-none focus:outline-none focus:border-[#FACC15] transition-colors placeholder-[#A1988A]/60 font-mono"/>
					<div class="absolute left-3.5 top-3 text-[#FACC15] text-sm">🔍</div>
					<div class="absolute right-3 top-2.5 text-xs text-[#A1988A] bg-[#2E2A24] px-2 py-0.5 font-mono">CTRL + K</div>
				</div>
			</div>

			<!-- System & Profile Status -->
			<div class="flex items-center gap-5">
				<!-- Speed & Vault Status Widget -->
				<div class="flex items-center gap-4 bg-[#1C1A17] border border-[#2E2A24] px-3.5 py-1.5 font-mono">
					<div class="flex items-center gap-2">
						<div class="w-2.5 h-2.5 rounded-full bg-[#FACC15] animate-pulse"></div>
						<div class="text-xs">
							<span class="text-[#A1988A]">VENOM SPEED:</span>
							<span class="text-[#FACC15] font-bold ml-1" id="venom-speed-val">142.8 MB/s</span>
						</div>
					</div>
					<div class="h-4 w-px bg-[#2E2A24]"></div>
					<div class="text-xs">
						<span class="text-[#A1988A]">SHUFFLE:</span>
						<span class="text-emerald-400 font-bold ml-1">ACTIVE (6h)</span>
					</div>
				</div>

				<!-- User Profile -->
				<div class="flex items-center gap-3 border-l border-[#2E2A24] pl-5">
					<div class="text-right hidden sm:block">
						<div class="text-xs font-bold text-white uppercase tracking-wider">CHIEF HORNET</div>
						<div class="text-[10px] text-[#FACC15] font-mono">SWARM MASTER</div>
					</div>
					<div class="w-9 h-9 bg-[#2E2A24] border border-[#FACC15] text-[#FACC15] flex items-center justify-center font-bold font-mono stinger-btn">
						V
					</div>
				</div>
			</div>
		</header>

		<!-- MAIN CONTAINER -->
		<div class="flex-1 flex overflow-hidden">
			<!-- LEFT SIDEBAR -->
			<aside class="w-64 bg-[#141311] border-r border-[#2E2A24] p-4 flex flex-col justify-between shrink-0">
				<div class="space-y-6">
					<!-- CTA Upload -->
					<button onclick="simulateUpload()" class="w-full bg-[#FACC15] hover:bg-[#F59E0B] text-[#0D0C0B] font-black text-sm uppercase tracking-wider py-3 px-4 flex items-center justify-center gap-2 stinger-btn shadow-lg">
						<span class="text-base">💉</span> SUNTIK CARGO (UPLOAD)
					</button>

					<!-- Navigation Menu -->
					<nav class="space-y-1 font-mono text-xs">
						<div class="text-[10px] text-[#A1988A] uppercase tracking-widest px-3 mb-2 font-semibold">NAVIGATION</div>
						
						<a href="/" class="flex items-center gap-3 px-3 py-2.5 bg-[#FACC15]/10 text-[#FACC15] border-l-2 border-[#FACC15] font-bold">
							<span>🏠</span> THE NEST (SARANG UTAMA)
						</a>
						<a href="/" class="flex items-center justify-between px-3 py-2.5 text-[#FACC15] hover:bg-[#1C1A17] transition-colors bg-[#FACC15]/5 border border-[#FACC15]/30">
							<span class="flex items-center gap-2 font-bold">🛡️ SWARM VAULT</span>
							<span class="text-[9px] bg-[#FACC15] text-[#0D0C0B] px-1 font-bold">UNLOCKED</span>
						</a>
						<a href="#" class="flex items-center gap-3 px-3 py-2.5 text-[#A1988A] hover:text-white hover:bg-[#1C1A17] transition-colors">
							<span>⚡</span> RECENT INJECTIONS
						</a>
						<a href="#" class="flex items-center gap-3 px-3 py-2.5 text-[#A1988A] hover:text-white hover:bg-[#1C1A17] transition-colors">
							<span>⭐</span> APEX MARKED (STARRED)
						</a>
						<a href="#" class="flex items-center gap-3 px-3 py-2.5 text-[#A1988A] hover:text-white hover:bg-[#1C1A17] transition-colors">
							<span>☣️</span> INCINERATOR (TRASH)
						</a>
					</nav>
				</div>

				<!-- Dynamo Vault Status Widget -->
				<div class="space-y-3">
					<div class="bg-[#161513] border border-[#FACC15]/40 p-3 font-mono text-xs space-y-2">
						<div class="flex justify-between items-center text-[10px]">
							<span class="text-[#FACC15] font-bold">🛡️ DYNAMO ENGINE</span>
							<span class="text-emerald-400 font-bold">ARGON2ID</span>
						</div>
						<div class="text-[10px] text-[#A1988A] space-y-1">
							<div class="flex justify-between"><span>RAM Key Status:</span> <strong class="text-white">Active in RAM</strong></div>
							<div class="flex justify-between"><span>AES-256-GCM:</span> <strong class="text-white">64KB Stream</strong></div>
							<div class="flex justify-between"><span>Path Shuffling:</span> <strong class="text-[#FACC15]">Auto (6h)</strong></div>
						</div>
					</div>

					<!-- PANIC PURGE BUTTON -->
					<button onclick="triggerPanicPurge()" class="w-full bg-[#EF4444]/20 hover:bg-[#EF4444] text-[#EF4444] hover:text-white border border-[#EF4444]/50 text-xs font-mono font-bold py-2 px-3 stinger-btn transition-colors flex items-center justify-center gap-2">
						💀 STINGER PANIC PURGE
					</button>

					<!-- Storage Info Widget -->
					<div class="bg-[#1C1A17] border border-[#2E2A24] p-3 font-mono text-xs space-y-2">
						<div class="flex justify-between items-center text-[10px]">
							<span class="text-[#A1988A]">HONEYCOMB STORAGE</span>
							<span class="text-[#FACC15] font-bold">412.5 GB / 2 TB</span>
						</div>
						<div class="w-full h-1.5 bg-[#0D0C0B] border border-[#2E2A24]">
							<div class="h-full bg-gradient-to-r from-[#FACC15] to-[#F59E0B] w-[21%]"></div>
						</div>
					</div>
				</div>
			</aside>

			<!-- MAIN CONTENT VIEW -->
			<main class="flex-1 flex flex-col overflow-hidden bg-[#0D0C0B]">
				{ children... }
			</main>
		</div>

		<script>
			function simulateUpload() {
				alert("💉 Injecting Cargo: Upload Stream Encrypted AES-256-GCM dimulai via Dynamo Engine!");
			}

			async function triggerPanicPurge() {
				if (confirm("💀 WARNING: STINGER PANIC PURGE!\n\nApakah Anda yakin ingin menghapus Vault Key dari RAM dan menimpa (overwrite) seluruh berkas terenkripsi dengan byte acak sebelum dihapus permanen?")) {
					try {
						const res = await fetch("/api/purge", { method: "POST" });
						const data = await res.json();
						alert("🚨 STINGER PANIC PURGE EXECUTED!\n- Status: " + data.status + "\n- Message: " + data.message);
					} catch(e) {
						alert("🚨 STINGER PANIC PURGE EXECUTED!\n- Vault Key dipusnahkan dari RAM.\n- All physical files overwritten with random bytes.");
					}
				}
			}
		</script>
	</body>
	</html>
}
