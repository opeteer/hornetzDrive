package components

import "ztatic-go-framework/fullstack"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - Hornetz Drive</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script>
			tailwind.config = {
				theme: {
					extend: {
						fontFamily: {
							sans: ['"Plus Jakarta Sans"', 'sans-serif'],
							mono: ['"JetBrains Mono"', 'monospace'],
						}
					}
				}
			}
		</script>
		<script type="module" src="https://cdn.skypack.dev/@hotwired/turbo"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>
		<script src={ fullstack.AssetURL("js/turbo_downloader.js") }></script>
		<script src={ fullstack.AssetURL("js/reconcile_tree.js") }></script>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href={ fullstack.AssetURL("css/main.css") }/>
		<style>
			[x-cloak] { display: none !important; }
			html, body {
				font-family: 'Plus Jakarta Sans', sans-serif;
				background-color: #0A0D14;
				color: #F8FAFC;
			}
			.font-sans {
				font-family: 'Plus Jakarta Sans', sans-serif;
			}
			.font-mono {
				font-family: 'JetBrains Mono', monospace;
			}
			/* Ambient glassmorphic backdrop glow orbs */
			.glass-ambient-bg {
				position: fixed;
				inset: 0;
				pointer-events: none;
				z-index: 0;
				overflow: hidden;
			}
			.glass-orb-1 {
				position: absolute;
				top: -10%;
				right: -5%;
				width: 650px;
				height: 650px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(245, 186, 19, 0.08) 0%, rgba(10, 13, 20, 0) 70%);
				filter: blur(80px);
			}
			.glass-orb-2 {
				position: absolute;
				bottom: -15%;
				left: -5%;
				width: 750px;
				height: 750px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(59, 130, 246, 0.07) 0%, rgba(10, 13, 20, 0) 70%);
				filter: blur(100px);
			}
			.glass-orb-3 {
				position: absolute;
				top: 40%;
				left: 45%;
				width: 500px;
				height: 500px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(30, 41, 59, 0.35) 0%, rgba(10, 13, 20, 0) 70%);
				filter: blur(90px);
			}
			.hornetz-glass {
				background: rgba(10, 13, 20, 0.85);
				backdrop-filter: blur(20px);
				-webkit-backdrop-filter: blur(20px);
				border-color: rgba(255, 255, 255, 0.07);
			}
			.hornetz-glass-card {
				background: rgba(17, 22, 34, 0.65);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid rgba(255, 255, 255, 0.08);
				box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 8px 32px 0 rgba(0, 0, 0, 0.4);
			}
			.hornetz-glass-pill {
				background: rgba(26, 33, 50, 0.5);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid rgba(255, 255, 255, 0.08);
			}
			.hornetz-btn {
				background: linear-gradient(135deg, #F5BA13 0%, #D97706 100%);
				color: #0A0D14;
				font-weight: 700;
				transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
				border: 1px solid rgba(251, 191, 36, 0.4);
				box-shadow: 0 4px 14px rgba(245, 186, 19, 0.22);
			}
			.hornetz-btn:hover {
				background: linear-gradient(135deg, #FBD34D 0%, #F5BA13 100%);
				transform: translateY(-1px);
				box-shadow: 0 6px 20px rgba(245, 186, 19, 0.35);
			}
			::-webkit-scrollbar { width: 6px; height: 6px; }
			::-webkit-scrollbar-track { background: rgba(10, 13, 20, 0.5); }
			::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.25); border-radius: 4px; }
			::-webkit-scrollbar-thumb:hover { background: #F5BA13; }
		</style>
	</head>
	<body 
		class="h-screen flex flex-col overflow-hidden select-none relative bg-[#0A0D14] text-[#F8FAFC]" 
		x-data
		@dragenter="$store.drive.handleDragEnter($event)"
		@dragleave="$store.drive.handleDragLeave($event)"
		@dragover.prevent="$store.drive.handleDragOver($event)"
		@drop.prevent="$store.drive.handleDrop($event)"
		@keydown.escape.window="$store.drive.dismissModals()"
		@mouseup.window="$store.drive.handleMouseUp($event)"
	>
		<!-- Atmospheric Glass Background Lighting -->
		<div class="glass-ambient-bg">
			<div class="glass-orb-1"></div>
			<div class="glass-orb-2"></div>
			<div class="glass-orb-3"></div>
		</div>

		<!-- TOP HEADER / NAVBAR -->
		<header class="h-16 hornetz-glass border-b border-white/[0.08] px-4 sm:px-6 flex items-center justify-between gap-4 z-20 shrink-0 relative">
			<!-- Brand / Logo & Mobile Menu Toggle -->
			<div class="flex items-center gap-3 shrink-0">
				<button @click="$store.drive.isMobileMenuOpen = !$store.drive.isMobileMenuOpen" class="md:hidden text-[#F5BA13] focus:outline-none shrink-0 p-1.5 rounded-xl hover:bg-white/5 transition-colors" aria-label="Menu">
					@IconMenu("w-5 h-5")
				</button>
				<a href="/" class="flex items-center gap-2.5 group select-none" data-turbo="false" title="Hornetz Drive - Beranda">
					<div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#F5BA13] to-[#D97706] text-[#0A0D14] flex items-center justify-center font-extrabold shadow-md shadow-[#F5BA13]/25 group-hover:scale-105 transition-all">
						@IconShield("w-5 h-5 fill-current stroke-[2]")
					</div>
					<div class="hidden sm:block">
						<div class="flex items-center gap-1.5 leading-none">
							<span class="font-bold text-sm tracking-tight text-white group-hover:text-[#F5BA13] transition-colors">Hornetz</span>
							<span class="text-xs font-semibold text-[#94A3B8]">Drive</span>
							<span class="text-[9px] px-1.5 py-0.5 rounded font-mono font-bold bg-[#F5BA13]/10 text-[#F5BA13] border border-[#F5BA13]/25 ml-0.5">v1.2</span>
						</div>
						<div class="text-[10px] text-[#94A3B8] font-medium mt-0.5">Secure Encrypted Cloud</div>
					</div>
				</a>
			</div>

			<!-- Live Search Bar -->
			<div class="flex-1 max-w-xl mx-auto relative" x-data="{ searchFocused: false }">
				<form role="search" @submit.prevent="$store.drive.handleSearchSubmit(); searchFocused = false" autocomplete="off" class="relative">
					<input 
						type="search" 
						name="hornetz_search" 
						id="hornetz-search-input"
						role="searchbox"
						autocomplete="off"
						autocorrect="off"
						autocapitalize="off"
						spellcheck="false"
						x-model="$store.drive.searchQuery" 
						@input.debounce.250ms="if (!$store.drive.isDownloadLink($store.drive.searchQuery)) { $store.drive.fetchFiles(); $store.drive.fetchFolders(); } searchFocused = true" 
						@focus="searchFocused = true"
						@keydown.escape="searchFocused = false"
						placeholder="Cari berkas, folder, atau tempel link unduhan..." 
						class="w-full bg-[#111622]/80 border border-white/[0.08] text-sm text-white pl-10 pr-20 py-2 rounded-xl focus:outline-none focus:border-[#F5BA13]/60 focus:bg-[#161D2C] backdrop-blur-md transition-all placeholder-[#94A3B8]/60 shadow-inner"
					/>
					<div class="absolute left-3.5 top-2.5 text-[#94A3B8] pointer-events-none">
						<span x-show="!$store.drive.isDownloadLink($store.drive.searchQuery)">
							@IconSearch("w-4 h-4")
						</span>
						<span x-show="$store.drive.isDownloadLink($store.drive.searchQuery)" class="text-[#F5BA13]" x-cloak>
							@IconDownload("w-4 h-4")
						</span>
					</div>
					<!-- Right Action Buttons / Shortcut Badge -->
					<div class="absolute right-2.5 top-1.5 flex items-center gap-1.5">
						<button 
							type="button" 
							x-show="$store.drive.isDownloadLink($store.drive.searchQuery)" 
							@click="$store.drive.startDownloadFromLink($store.drive.searchQuery); searchFocused = false" 
							x-cloak
							class="px-2.5 py-1 bg-gradient-to-r from-[#F5BA13] to-[#D97706] hover:from-[#FBD34D] hover:to-[#F5BA13] text-[#0A0D14] rounded-lg text-xs font-bold transition-all flex items-center gap-1 shadow-md shadow-[#F5BA13]/20 cursor-pointer"
							title="Mulai Unduh Berkas dari Tautan"
						>
							@IconDownload("w-3.5 h-3.5")
							<span>Unduh</span>
						</button>
						<span x-show="!$store.drive.searchQuery && !$store.drive.isDownloadLink($store.drive.searchQuery)" class="hidden md:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono text-[#94A3B8]/60 bg-white/[0.04] border border-white/[0.08] rounded">
							/
						</span>
						<button 
							type="button" 
							x-show="$store.drive.searchQuery" 
							@click="$store.drive.clearSearch(); searchFocused = false" 
							class="text-[#94A3B8] hover:text-white p-1 rounded transition-colors"
							aria-label="Hapus Pencarian"
						>
							@IconX("w-4 h-4")
						</button>
					</div>
				</form>

				<!-- Google Drive-style Live Search Dropdown -->
				<div 
					x-show="searchFocused && $store.drive.searchQuery && $store.drive.searchQuery.trim().length > 0" 
					@click.away="searchFocused = false" 
					x-cloak
					style="display: none;"
					x-transition:enter="transition ease-out duration-150"
					x-transition:enter-start="opacity-0 translate-y-1"
					x-transition:enter-end="opacity-100 translate-y-0"
					x-transition:leave="transition ease-in duration-100"
					x-transition:leave-start="opacity-100 translate-y-0"
					x-transition:leave-end="opacity-0 translate-y-1"
					class="absolute top-full left-0 right-0 mt-2 bg-[#141824]/95 backdrop-blur-2xl border border-white/[0.1] rounded-2xl shadow-2xl overflow-hidden z-50 max-h-96 flex flex-col"
				>
					<!-- Detected Download Link Action Card -->
					<template x-if="$store.drive.isDownloadLink($store.drive.searchQuery)">
						<div class="p-3 bg-gradient-to-r from-[#F5BA13]/15 to-[#F5BA13]/5 border-b border-[#F5BA13]/30">
							<div class="flex items-center justify-between gap-3">
								<div class="flex items-center gap-3 min-w-0">
									<div class="w-10 h-10 rounded-xl bg-white/[0.05] border border-[#F5BA13]/40 text-[#F5BA13] flex items-center justify-center shrink-0 shadow-sm">
										<span x-show="$store.drive.getLinkType($store.drive.searchQuery) === 'magnet'">
											@IconZap("w-5 h-5 fill-current")
										</span>
										<span x-show="$store.drive.getLinkType($store.drive.searchQuery) !== 'magnet'">
											@IconDownload("w-5 h-5")
										</span>
									</div>
									<div class="min-w-0">
										<div class="flex items-center gap-2">
											<span class="text-xs font-bold text-white">Tautan Unduhan Terdeteksi</span>
											<span 
												class="text-[9px] px-1.5 py-0.5 rounded font-mono font-bold uppercase"
												:class="$store.drive.getLinkType($store.drive.searchQuery) === 'magnet' ? 'bg-purple-500/20 text-purple-300 border border-purple-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'"
												x-text="$store.drive.getLinkType($store.drive.searchQuery) === 'magnet' ? 'Torrent Magnet' : 'Direct URL'"
											></span>
											<span 
												class="text-[9px] px-1.5 py-0.5 rounded font-mono font-bold uppercase"
												:class="$store.drive.getProviderBadgeClass($store.drive.getLinkProvider($store.drive.searchQuery))"
												x-text="$store.drive.getLinkProvider($store.drive.searchQuery)"
											></span>
										</div>
										<div class="text-xs text-[#F8FAFC] font-semibold truncate mt-0.5" x-text="$store.drive.getLinkPreviewName($store.drive.searchQuery)"></div>
										<div class="text-[10px] text-[#94A3B8] font-mono mt-0.5 flex items-center gap-1.5">
											<span>Simpan ke:</span>
											<span class="text-[#F5BA13] font-bold" x-text="$store.drive.currentFolderName || 'Drive Utama'"></span>
										</div>
									</div>
								</div>
								<button 
									type="button" 
									@click="$store.drive.startDownloadFromLink($store.drive.searchQuery); searchFocused = false" 
									class="hornetz-btn px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 shrink-0 cursor-pointer shadow-md"
								>
									@IconDownload("w-3.5 h-3.5")
									<span>Unduh Sekarang</span>
								</button>
							</div>
						</div>
					</template>

					<!-- Header info -->
					<div class="px-4 py-2.5 border-b border-white/[0.06] flex justify-between items-center text-[11px] font-sans text-[#94A3B8]">
						<span>Hasil pencarian untuk <span class="text-[#F5BA13] font-bold" x-text="'“' + $store.drive.searchQuery + '”'"></span></span>
						<span x-text="($store.drive.files.length + $store.drive.folders.length) + ' hasil'"></span>
					</div>

					<div class="overflow-y-auto divide-y divide-white/[0.06] flex-1">
						<!-- Matching Folders -->
						<template x-if="$store.drive.folders && $store.drive.folders.length > 0">
							<div class="p-2">
								<div class="text-[10px] font-bold text-[#F5BA13] uppercase px-2 py-1 tracking-wider">Folder</div>
								<template x-for="folder in $store.drive.folders.slice(0, 4)" :key="folder.id">
									<div 
										@click="$store.drive.openFolder(folder); searchFocused = false"
										class="flex items-center gap-3 px-2 py-1.5 rounded-xl hover:bg-white/[0.06] cursor-pointer group transition-colors"
									>
										<div class="w-7 h-7 rounded-lg bg-white/[0.05] border border-white/[0.08] text-[#F5BA13] flex items-center justify-center shrink-0">
											@IconFolder("w-3.5 h-3.5")
										</div>
										<div class="flex-1 min-w-0">
											<div class="text-xs font-semibold text-white group-hover:text-[#F5BA13] truncate transition-colors" x-text="folder.name"></div>
											<div class="text-[10px] text-[#94A3B8]" x-text="(folder.file_count || 0) + ' berkas'"></div>
										</div>
									</div>
								</template>
							</div>
						</template>

						<!-- Matching Files -->
						<template x-if="$store.drive.files && $store.drive.files.length > 0">
							<div class="p-2">
								<div class="text-[10px] font-bold text-[#94A3B8] uppercase px-2 py-1 tracking-wider">Berkas</div>
								<template x-for="file in $store.drive.files.slice(0, 8)" :key="file.id">
									<div 
										@click="$store.drive.selectFile(file); searchFocused = false"
										class="flex items-center gap-3 px-2 py-2 rounded-xl hover:bg-white/[0.06] cursor-pointer group transition-colors"
									>
										<div class="w-8 h-8 rounded-lg bg-white/[0.05] border border-white/[0.08] text-[#F5BA13] flex items-center justify-center shrink-0" x-html="$store.drive.getFileIconSvg(file.icon, 'w-4 h-4')"></div>
										<div class="flex-1 min-w-0">
											<div class="text-xs font-semibold text-white group-hover:text-[#F5BA13] truncate transition-colors" :title="file.name" x-text="file.name"></div>
											<div class="flex items-center gap-2 text-[10px] text-[#94A3B8] font-mono mt-0.5">
												<span x-text="(file.size >= 1073741824) ? (file.size / 1073741824).toFixed(2) + ' GB' : (file.size >= 1048576) ? (file.size / 1048576).toFixed(1) + ' MB' : (file.size >= 1024) ? (file.size / 1024).toFixed(1) + ' KB' : file.size + ' B'"></span>
												<span class="text-white/20">•</span>
												<span class="uppercase text-[9px] px-1 bg-white/5 rounded border border-white/10" x-text="(file.ext || 'FILE').slice(0, 4)"></span>
											</div>
										</div>
									</div>
								</template>
							</div>
						</template>

						<!-- Empty State -->
						<template x-if="$store.drive.files.length === 0 && $store.drive.folders.length === 0">
							<div class="py-6 px-4 text-center space-y-2">
								<template x-if="$store.drive.isDownloadLink($store.drive.searchQuery)">
									<div class="space-y-1">
										<div class="text-[#F5BA13] text-xs font-semibold">
											Tekan Enter atau klik Unduh Sekarang untuk mengunduh ke Hornetz Drive
										</div>
										<p class="text-[11px] text-[#94A3B8]">Berkas akan langsung dienkripsi dengan AES-256-GCM dan disimpan ke CAS.</p>
									</div>
								</template>
								<template x-if="!$store.drive.isDownloadLink($store.drive.searchQuery)">
									<div class="space-y-1">
										<div class="text-[#94A3B8] text-xs">
											Tidak ada berkas atau folder yang cocok dengan <span class="text-white font-bold" x-text="'“' + $store.drive.searchQuery + '”'"></span>
										</div>
										<p class="text-[11px] text-[#94A3B8]/70">Coba kata kunci lain atau periksa kembali ejaan.</p>
									</div>
								</template>
							</div>
						</template>
					</div>

					<!-- Footer -->
					<div class="px-4 py-2 bg-[#0B0E14]/80 border-t border-white/[0.06] flex justify-between items-center text-[10px] text-[#94A3B8]">
						<span x-show="$store.drive.isDownloadLink($store.drive.searchQuery)">
							Tekan <kbd class="px-1.5 py-0.5 bg-white/[0.08] rounded border border-white/[0.1] text-white font-bold font-mono">Enter</kbd> untuk mulai mengunduh
						</span>
						<span x-show="!$store.drive.isDownloadLink($store.drive.searchQuery)">
							Tekan <kbd class="px-1.5 py-0.5 bg-white/[0.08] rounded border border-white/[0.1] text-white font-bold font-mono">Enter</kbd> untuk filter tampilan
						</span>
						<button type="button" @click="$store.drive.clearSearch(); searchFocused = false" class="hover:text-white underline cursor-pointer">Tutup</button>
					</div>
				</div>
			</div>

			<!-- Status & User Profile -->
			<div class="flex items-center gap-3 shrink-0">
				<!-- Dynamic Transfer / Status Indicator -->
				<div 
					x-show="$store.drive.isTransferring || $store.drive.transfers.some(t => t.status === 'active')"
					@click="$store.drive.isTransferMinimized = false"
					class="flex items-center gap-2 bg-[#F5BA13]/10 border border-[#F5BA13]/30 px-3 py-1.5 rounded-xl text-xs font-mono backdrop-blur-md cursor-pointer hover:bg-[#F5BA13]/15 transition-all text-[#F5BA13] shadow-sm"
					title="Klik untuk membuka pengelola transfer"
				>
					<span class="w-2 h-2 rounded-full bg-[#F5BA13] animate-pulse"></span>
					<span class="hidden sm:inline" x-text="$store.drive.transferDirection === 'upload' ? 'Unggah:' : ($store.drive.transferDirection === 'download' ? 'Unduh:' : 'Transfer:')"></span>
					<span class="font-bold" x-text="$store.drive.currentSpeedText"></span>
				</div>

				<div 
					x-show="!$store.drive.isTransferring && !$store.drive.transfers.some(t => t.status === 'active')"
					class="hidden md:flex items-center gap-1.5 text-xs text-[#94A3B8] px-2.5 py-1 rounded-xl bg-white/[0.03] border border-white/[0.06] font-mono text-[11px]"
					title="Sistem Hornetz Siap"
				>
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
					<span>Vault Aktif</span>
				</div>

				<!-- User Profile with Dropdown -->
				<div class="relative" x-data="{ profileOpen: false }" @click.away="profileOpen = false">
					<button 
						@click="profileOpen = !profileOpen"
						class="flex items-center gap-2.5 pl-2 py-1 pr-1.5 rounded-xl hover:bg-white/[0.05] border border-transparent hover:border-white/[0.08] transition-all cursor-pointer"
					>
						<div class="text-right hidden sm:block">
							<div class="text-xs font-bold text-white leading-tight">Pengguna Utama</div>
							<div class="text-[10px] text-[#F5BA13] font-medium leading-tight">Vault Master</div>
						</div>
						<div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#1E2638] to-[#141824] border border-[#F5BA13]/40 text-[#F5BA13] flex items-center justify-center font-bold font-mono text-xs shadow-sm">
							U
						</div>
						<div class="text-[#94A3B8]">
							@IconChevronDown("w-3.5 h-3.5")
						</div>
					</button>

					<!-- Profile Popover -->
					<div 
						x-show="profileOpen" 
						x-cloak
						x-transition:enter="transition ease-out duration-150"
						x-transition:enter-start="opacity-0 translate-y-1 scale-95"
						x-transition:enter-end="opacity-100 translate-y-0 scale-100"
						x-transition:leave="transition ease-in duration-100"
						x-transition:leave-start="opacity-100 translate-y-0 scale-100"
						x-transition:leave-end="opacity-0 translate-y-1 scale-95"
						class="absolute right-0 mt-2 w-64 bg-[#141824]/95 backdrop-blur-2xl border border-white/[0.1] rounded-2xl shadow-2xl p-2 z-50 space-y-1 font-sans text-xs"
					>
						<div class="px-3 py-2 border-b border-white/[0.06] mb-1">
							<div class="font-bold text-white text-sm">Pengguna Utama</div>
							<div class="text-[#94A3B8] text-[11px] font-mono mt-0.5">Admin &bull; AES-256-GCM</div>
						</div>

						<button 
							@click="$store.drive.showSecurityModal = true; profileOpen = false" 
							class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-white/[0.08] text-white hover:text-[#F5BA13] transition-colors text-left font-medium"
						>
							@IconShield("w-4 h-4 text-[#F5BA13]")
							<span>Keamanan & Spesifikasi Vault</span>
						</button>

						<button 
							@click="$store.drive.openAddDownloadModal(); profileOpen = false" 
							class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-white/[0.08] text-white hover:text-[#F5BA13] transition-colors text-left font-medium"
						>
							@IconDownload("w-4 h-4 text-[#F5BA13]")
							<span>Unduh dari Tautan / Magnet</span>
						</button>

						<template x-if="$store.drive.isVaultUnlocked">
							<button 
								@click="$store.drive.lockVault(); profileOpen = false" 
								class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-red-500/15 text-red-400 transition-colors text-left font-medium"
							>
								@IconLock("w-4 h-4")
								<span>Kunci Vault Terenkripsi</span>
							</button>
						</template>

						<div class="h-px bg-white/[0.06] my-1"></div>

						<a 
							href="/" 
							data-turbo="false"
							class="flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-white/[0.08] text-[#94A3B8] hover:text-white transition-colors font-medium"
						>
							@IconHome("w-4 h-4")
							<span>Kembali ke Beranda</span>
						</a>
					</div>
				</div>
			</div>
		</header>

		<!-- MAIN BODY (SIDEBAR + CONTENT) -->
		<div class="flex-1 flex overflow-hidden relative z-10">
			<!-- Mobile Overlay Backdrop -->
			<div 
				x-show="$store.drive && $store.drive.isMobileMenuOpen" 
				@click="$store.drive.isMobileMenuOpen = false" 
				class="fixed inset-0 bg-black/70 backdrop-blur-sm z-30 md:hidden" 
				x-cloak
			></div>
			<!-- SIDEBAR -->
			<aside 
				:class="$store.drive.isMobileMenuOpen ? 'translate-x-0' : '-translate-x-full md:translate-x-0'"
				class="fixed md:static inset-y-0 left-0 z-40 w-64 bg-[#0D1017]/85 backdrop-blur-2xl border-r border-white/[0.08] p-4 flex flex-col justify-between shrink-0 transition-transform duration-200 select-none"
			>
				<div class="space-y-6">
					<!-- Unified Action Button (+ Baru) -->
					<div class="relative" x-data="{ newMenuOpen: false }" @click.away="newMenuOpen = false">
						<button 
							@click="newMenuOpen = !newMenuOpen" 
							class="w-full hornetz-btn py-3 px-4 rounded-xl flex items-center justify-between gap-2 text-sm shadow-lg font-bold cursor-pointer"
							title="Unggah berkas, folder, atau buat folder baru"
						>
							<div class="flex items-center gap-2">
								@IconPlus("w-5 h-5 stroke-[2.5]")
								<span>Baru</span>
							</div>
							<div :class="newMenuOpen ? 'rotate-180' : ''" class="transition-transform duration-200">
								@IconChevronDown("w-4 h-4")
							</div>
						</button>

						<!-- Dropdown Menu -->
						<div 
							x-show="newMenuOpen" 
							x-cloak
							x-transition:enter="transition ease-out duration-150"
							x-transition:enter-start="opacity-0 translate-y-1 scale-95"
							x-transition:enter-end="opacity-100 translate-y-0 scale-100"
							x-transition:leave="transition ease-in duration-100"
							x-transition:leave-start="opacity-100 translate-y-0 scale-100"
							x-transition:leave-end="opacity-0 translate-y-1 scale-95"
							class="absolute left-0 right-0 top-full mt-2 bg-[#141824]/95 backdrop-blur-2xl border border-white/[0.1] rounded-2xl shadow-2xl p-1.5 z-50 space-y-1"
						>
							<button 
								@click="$refs.fileInput.click(); newMenuOpen = false" 
								class="w-full flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-white/[0.08] text-xs font-semibold text-white hover:text-[#F5BA13] transition-colors text-left cursor-pointer"
							>
								<div class="w-7 h-7 rounded-lg bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-[#F5BA13]">
									@IconUploadCloud("w-4 h-4")
								</div>
								<div>
									<div class="font-bold">Unggah Berkas</div>
									<div class="text-[10px] text-[#94A3B8] font-normal">Pilih satu atau banyak berkas</div>
								</div>
							</button>

							<button 
								@click="$refs.folderInput.click(); newMenuOpen = false" 
								class="w-full flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-white/[0.08] text-xs font-semibold text-white hover:text-[#F5BA13] transition-colors text-left cursor-pointer"
							>
								<div class="w-7 h-7 rounded-lg bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-[#F5BA13]">
									@IconFolderInput("w-4 h-4")
								</div>
								<div>
									<div class="font-bold">Unggah Folder</div>
									<div class="text-[10px] text-[#94A3B8] font-normal">Seluruh folder beserta isinya</div>
								</div>
							</button>

							<div class="h-px bg-white/[0.06] my-1"></div>

							<button 
								@click="$store.drive.showCreateFolderModal = true; newMenuOpen = false" 
								class="w-full flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-white/[0.08] text-xs font-semibold text-white hover:text-[#F5BA13] transition-colors text-left cursor-pointer"
							>
								<div class="w-7 h-7 rounded-lg bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-[#F5BA13]">
									@IconFolderPlus("w-4 h-4")
								</div>
								<div>
									<div class="font-bold">Buat Folder Baru</div>
									<div class="text-[10px] text-[#94A3B8] font-normal">Buat direktori baru</div>
								</div>
							</button>

							<button 
								@click="$store.drive.openAddDownloadModal(); newMenuOpen = false" 
								class="w-full flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-white/[0.08] text-xs font-semibold text-white hover:text-[#F5BA13] transition-colors text-left cursor-pointer"
							>
								<div class="w-7 h-7 rounded-lg bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-[#F5BA13]">
									@IconDownload("w-4 h-4")
								</div>
								<div>
									<div class="font-bold">Unduh dari Tautan</div>
									<div class="text-[10px] text-[#94A3B8] font-normal">Direct URL atau Magnet link</div>
								</div>
							</button>
						</div>

						<!-- Hidden Real File Inputs -->
						<input 
							type="file" 
							x-ref="fileInput" 
							multiple
							@change="$store.drive.uploadFile($event)" 
							class="hidden"
						/>
						<input 
							type="file" 
							x-ref="folderInput" 
							webkitdirectory 
							directory 
							multiple
							@change="$store.drive.uploadFolder($event)" 
							class="hidden"
						/>
					</div>

					<!-- Navigation Menu -->
					<nav class="space-y-1 text-sm font-medium">
						<div class="text-[10px] font-bold text-[#94A3B8] uppercase tracking-wider px-3 mb-2 font-sans">Menu Utama</div>
						
						<button 
							@click="$store.drive.setTab('storage')" 
							:class="$store.drive.activeTab === 'storage' ? 'bg-[#F5BA13]/15 text-[#F5BA13] font-bold shadow-sm' : 'text-[#94A3B8] hover:text-white hover:bg-white/[0.05]'" 
							class="w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all cursor-pointer"
						>
							@IconHardDrive("w-4 h-4")
							<span>Penyimpanan Saya</span>
						</button>

						<button 
							@click="$store.drive.setTab('vault')" 
							:class="$store.drive.activeTab === 'vault' ? 'bg-[#F5BA13]/15 text-[#F5BA13] font-bold shadow-sm' : 'text-[#94A3B8] hover:text-white hover:bg-white/[0.05]'" 
							class="w-full text-left flex items-center justify-between px-3.5 py-2.5 rounded-xl transition-all cursor-pointer"
						>
							<span class="flex items-center gap-3">
								@IconShieldCheck("w-4 h-4")
								<span>Vault Terenkripsi</span>
							</span>
							<span class="text-[10px] bg-emerald-500/15 text-emerald-400 px-1.5 py-0.5 rounded font-mono font-semibold border border-emerald-500/25">AKTIF</span>
						</button>

						<button 
							@click="$store.drive.setTab('recent')" 
							:class="$store.drive.activeTab === 'recent' ? 'bg-[#F5BA13]/15 text-[#F5BA13] font-bold shadow-sm' : 'text-[#94A3B8] hover:text-white hover:bg-white/[0.05]'" 
							class="w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all cursor-pointer"
						>
							@IconClock("w-4 h-4")
							<span>Berkas Terbaru</span>
						</button>

						<button 
							@click="$store.drive.setTab('starred')" 
							:class="$store.drive.activeTab === 'starred' ? 'bg-[#F5BA13]/15 text-[#F5BA13] font-bold shadow-sm' : 'text-[#94A3B8] hover:text-white hover:bg-white/[0.05]'" 
							class="w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all cursor-pointer"
						>
							@IconStar("w-4 h-4", false)
							<span>Berbintang</span>
						</button>

						<button 
							@click="$store.drive.setTab('trash')" 
							:class="$store.drive.activeTab === 'trash' ? 'bg-[#F5BA13]/15 text-[#F5BA13] font-bold shadow-sm' : 'text-[#94A3B8] hover:text-white hover:bg-white/[0.05]'" 
							class="w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all cursor-pointer"
						>
							@IconTrash("w-4 h-4")
							<span>Sampah</span>
						</button>
					</nav>
				</div>

				<!-- Bottom Widgets -->
				<div class="space-y-3 pt-4 border-t border-white/[0.06]">
					<!-- Vault Key Status Card (Clean & Clickable) -->
					<div 
						@click="$store.drive.showSecurityModal = true"
						class="bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.08] hover:border-[#F5BA13]/40 p-3 rounded-2xl cursor-pointer transition-all space-y-1.5 group"
						title="Klik untuk melihat spesifikasi kriptografi & keamanan"
					>
						<div class="flex justify-between items-center text-xs">
							<span class="text-white font-bold flex items-center gap-1.5 group-hover:text-[#F5BA13] transition-colors">
								@IconShield("w-3.5 h-3.5 text-[#F5BA13]")
								<span>Keamanan Vault</span>
							</span>
							<span class="text-[10px] bg-[#F5BA13]/10 text-[#F5BA13] px-1.5 py-0.5 rounded font-mono font-bold border border-[#F5BA13]/20">AES-256</span>
						</div>
						<div class="flex justify-between items-center text-[11px] text-[#94A3B8]">
							<span>Status: <strong class="text-emerald-400 font-medium">Terproteksi</strong></span>
							<span class="text-[10px] text-[#94A3B8] group-hover:text-white transition-colors">Detail &rarr;</span>
						</div>
					</div>

					<!-- Storage Progress Bar -->
					<div class="bg-white/[0.03] border border-white/[0.08] p-3 rounded-2xl space-y-2">
						<div class="flex justify-between items-center text-xs">
							<span class="text-[#94A3B8] font-medium">Penyimpanan</span>
							<span class="text-[#F5BA13] font-bold font-mono text-[11px]" x-text="`${$store.drive.storageUsedText} / ${$store.drive.storageQuotaText}`">0 B / -</span>
						</div>
						<div class="w-full h-1.5 bg-black/40 rounded-full overflow-hidden border border-white/[0.05]">
							<div 
								class="h-full bg-gradient-to-r from-[#F5BA13] to-[#D97706] transition-all duration-300 rounded-full" 
								:style="`width: ${Math.max($store.drive.storagePercent, $store.drive.storageUsedBytes > 0 ? 0.8 : 0)}%`"
							></div>
						</div>
					</div>
				</div>
			</aside>

			<!-- MAIN CONTENT VIEW -->
			<main class="flex-1 flex flex-col overflow-hidden bg-transparent relative z-10">
				{ children... }
			</main>
		</div>

		<!-- Upgraded Multi-Upload/Download Intelligent Transfer Manager Panel -->
		<div 
			x-show="$store.drive && ($store.drive.transfers.length > 0 || $store.drive.isUploading)" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed bottom-6 right-6 z-50 flex flex-col items-end"
		>
			<!-- Minimized Compact Pill -->
			<div 
				x-show="$store.drive.isTransferMinimized"
				@click="$store.drive.isTransferMinimized = false"
				class="bg-[#121519]/95 backdrop-blur-2xl border border-[#F5CE0D]/40 shadow-2xl rounded-2xl px-4 py-2.5 flex items-center gap-3 cursor-pointer hover:border-[#F5CE0D] transition-all hover:scale-105"
			>
				<div class="w-2.5 h-2.5 rounded-full" :class="$store.drive.transfers.some(t => t.status === 'active') ? 'bg-[#F5CE0D] animate-ping' : 'bg-emerald-400'"></div>
				<span class="text-xs font-bold text-white font-mono" x-text="$store.drive.getTransferSummaryText()"></span>
				<div class="text-[#86898B] hover:text-white">
					@IconChevronUp("w-4 h-4")
				</div>
			</div>

			<!-- Expanded Multi-Transfer Tray -->
			<div 
				x-show="!$store.drive.isTransferMinimized"
				class="bg-[#121519]/95 backdrop-blur-2xl border border-[#3F4247]/70 rounded-2xl shadow-2xl w-88 sm:w-96 flex flex-col overflow-hidden"
			>
				<!-- Header -->
				<div class="px-4 py-3 border-b border-[#3F4247]/50 flex items-center justify-between bg-white/[0.02]">
					<div class="flex items-center gap-2">
						<div class="w-6 h-6 rounded-lg bg-[#2E3137] border border-[#F5CE0D]/40 text-[#F5CE0D] flex items-center justify-center">
							<template x-if="$store.drive.transfers.some(t => t.type === 'download' && t.status === 'active')">
								@IconDownload("w-3.5 h-3.5")
							</template>
							<template x-if="!$store.drive.transfers.some(t => t.type === 'download' && t.status === 'active')">
								@IconUploadCloud("w-3.5 h-3.5")
							</template>
						</div>
						<div>
							<h4 class="text-xs font-bold text-white">Pengelola Transfer</h4>
							<span class="text-[10px] text-[#86898B] font-mono" x-text="$store.drive.getTransferSummaryText()"></span>
						</div>
					</div>
					<div class="flex items-center gap-1.5">
						<button 
							type="button" 
							@click="$store.drive.clearCompletedTransfers()" 
							x-show="$store.drive.transfers.some(t => t.status === 'completed' || t.status === 'failed' || t.status === 'cancelled')"
							class="text-[10px] text-[#86898B] hover:text-[#F5CE0D] px-2 py-0.5 rounded hover:bg-[#2E3137]/40 font-mono transition-colors"
							title="Bersihkan transfer yang sudah selesai"
						>
							Bersihkan
						</button>
						<button 
							type="button" 
							@click="$store.drive.isTransferMinimized = true"
							class="text-[#86898B] hover:text-white p-1 rounded hover:bg-[#2E3137]/40 transition-colors"
							title="Perkecil Panel"
						>
							@IconChevronDown("w-4 h-4")
						</button>
						<button 
							type="button" 
							@click="$store.drive.dismissAllTransfers()"
							class="text-[#86898B] hover:text-white p-1 rounded hover:bg-[#2E3137]/40 transition-colors"
							title="Tutup Panel"
						>
							@IconX("w-3.5 h-3.5")
						</button>
					</div>
				</div>

				<!-- Transfers List -->
				<div class="max-h-72 overflow-y-auto divide-y divide-[#3F4247]/30 p-2 space-y-2">
					<template x-for="t in $store.drive.transfers" :key="t.id">
						<div class="p-2.5 rounded-xl bg-[#2E3137]/20 border border-[#3F4247]/40 space-y-1.5">
							<div class="flex items-center justify-between text-xs gap-2">
								<div class="flex items-center gap-2 min-w-0">
									<div 
										class="w-6 h-6 rounded-md flex items-center justify-center shrink-0"
										:class="t.type === 'download' ? 'bg-purple-500/15 text-purple-300' : 'bg-[#F5CE0D]/15 text-[#F5CE0D]'"
									>
										<template x-if="t.type === 'download'">
											@IconDownload("w-3.5 h-3.5")
										</template>
										<template x-if="t.type !== 'download'">
											@IconUploadCloud("w-3.5 h-3.5")
										</template>
									</div>
									<span class="font-bold text-white truncate max-w-[170px]" :title="t.name" x-text="t.name"></span>
								</div>

								<div class="flex items-center gap-2 shrink-0">
									<span 
										class="text-xs font-mono font-bold" 
										:class="t.status === 'failed' ? 'text-rose-400' : (t.status === 'completed' ? 'text-emerald-400' : 'text-[#F5CE0D]')"
										x-text="(t.progress || 0) + '%'"
									></span>
									<button 
										type="button"
										@click="$store.drive.cancelTransfer(t.id); $store.drive.dismissTransfer(t.id)"
										class="text-[#86898B] hover:text-white p-0.5 rounded hover:bg-white/10 transition-colors"
										:title="t.status === 'active' ? 'Batalkan Transfer' : 'Hapus dari Daftar'"
									>
										@IconX("w-3.5 h-3.5")
									</button>
								</div>
							</div>

							<!-- Progress Bar -->
							<div class="w-full h-1.5 bg-black/40 rounded-full overflow-hidden border border-[#3F4247]/40">
								<div 
									class="h-full transition-all duration-200" 
									:class="t.status === 'failed' ? 'bg-gradient-to-r from-rose-500 to-amber-600' : (t.status === 'completed' ? 'bg-gradient-to-r from-emerald-500 to-teal-400' : 'bg-gradient-to-r from-[#F5CE0D] to-[#DDAC0D]')"
									:style="`width: ${t.progress || 0}%`"
								></div>
							</div>

							<!-- Transfer Telemetry Footer -->
							<div class="flex items-center justify-between text-[10px] font-mono text-[#86898B]">
								<span class="truncate max-w-[160px]" :class="t.status === 'failed' ? 'text-rose-400 font-semibold' : ''" x-text="t.statusText || t.status"></span>
								<div class="flex items-center gap-2">
									<span x-show="t.total > 0" x-text="$store.drive.formatBytes(t.loaded || 0) + ' / ' + $store.drive.formatBytes(t.total)"></span>
									<span x-show="(!t.total || t.total <= 0) && t.loaded > 0" x-text="$store.drive.formatBytes(t.loaded || 0) + ' diunduh'"></span>
									<span x-show="t.speed && t.speed !== 'Idle' && t.status === 'active'" class="text-[#EDEBE8] font-bold" x-text="t.speed"></span>
								</div>
							</div>
						</div>
					</template>
				</div>
			</div>
		</div>

		<!-- Vault Security & Cryptographic Details Modal -->
		<div 
			x-show="$store.drive && $store.drive.showSecurityModal" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/85 backdrop-blur-xl flex items-center justify-center z-[105] p-4"
		>
			<div 
				@click.away="$store.drive.showSecurityModal = false" 
				class="bg-[#141824]/95 backdrop-blur-2xl border border-white/[0.1] w-full max-w-md rounded-2xl p-6 shadow-2xl space-y-5"
			>
				<div class="flex items-center justify-between border-b border-white/[0.08] pb-3">
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 rounded-xl bg-[#F5BA13]/10 border border-[#F5BA13]/30 text-[#F5BA13] flex items-center justify-center shadow-sm">
							@IconShield("w-5 h-5")
						</div>
						<div>
							<h3 class="font-bold text-base text-white">Keamanan & Spesifikasi Vault</h3>
							<p class="text-xs text-[#94A3B8]">Arsitektur enkripsi end-to-end Hornetz Drive</p>
						</div>
					</div>
					<button @click="$store.drive.showSecurityModal = false" class="text-[#94A3B8] hover:text-white p-1 rounded-lg hover:bg-white/5 transition-colors cursor-pointer">
						@IconX("w-4 h-4")
					</button>
				</div>

				<div class="space-y-3 font-sans">
					<div class="bg-white/[0.03] border border-white/[0.06] p-3.5 rounded-xl space-y-2.5">
						<div class="flex justify-between items-center text-xs">
							<span class="text-[#94A3B8]">Algoritma Enkripsi:</span>
							<span class="font-mono font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 text-[11px]">AES-256-GCM</span>
						</div>
						<div class="flex justify-between items-center text-xs">
							<span class="text-[#94A3B8]">Derivasi Kunci:</span>
							<span class="font-mono text-white text-[11px]">Argon2id (Memory-Hard)</span>
						</div>
						<div class="flex justify-between items-center text-xs">
							<span class="text-[#94A3B8]">Penyimpanan Kunci:</span>
							<span class="font-mono text-white text-[11px]">RAM Ephemeral (Zero-at-Rest)</span>
						</div>
						<div class="flex justify-between items-center text-xs">
							<span class="text-[#94A3B8]">Integritas & Deduplikasi:</span>
							<span class="font-mono text-[#F5BA13] text-[11px]">SHA-256 Content-Addressed (CAS)</span>
						</div>
					</div>

					<!-- Danger Zone -->
					<div class="border border-red-500/30 bg-red-500/5 p-4 rounded-xl space-y-2.5">
						<div class="flex items-center gap-2 text-red-400 font-bold text-xs">
							@IconAlertTriangle("w-4 h-4")
							<span>Zona Bahaya: Emergency Panic Purge</span>
						</div>
						<p class="text-[11px] text-[#94A3B8] leading-relaxed">
							Tindakan darurat untuk memusnahkan seluruh berkas vault, chunk terenkripsi, dan database secara instan jika server terkompromi.
						</p>
						<button 
							@click="$store.drive.showSecurityModal = false; $store.drive.triggerPanicPurge()" 
							class="w-full py-2.5 px-3 bg-red-500/15 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/30 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm hover:shadow-lg hover:shadow-red-600/20"
						>
							@IconFlame("w-4 h-4")
							<span>Picu Emergency Panic Purge</span>
						</button>
					</div>
				</div>

				<div class="pt-2 flex justify-end">
					<button 
						@click="$store.drive.showSecurityModal = false" 
						class="px-4 py-2 bg-white/[0.05] hover:bg-white/[0.1] text-white rounded-xl text-xs font-bold transition-all cursor-pointer"
					>
						Tutup
					</button>
				</div>
			</div>
		</div>

		<!-- Vault Unlock Password Modal -->
		<div 
			x-show="$store.drive && $store.drive.showVaultPasswordModal" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/80 backdrop-blur-xl flex items-center justify-center z-[100] p-4"
		>
			<div 
				@click.away="$store.drive.showVaultPasswordModal = false" 
				class="bg-[#121519]/90 backdrop-blur-2xl border border-[#3F4247]/60 w-full max-w-sm rounded-2xl p-6 shadow-2xl space-y-6"
			>
				<div class="text-center space-y-2">
					<div class="w-16 h-16 mx-auto bg-[#2E3137] border border-[#F5CE0D]/40 rounded-full flex items-center justify-center text-[#F5CE0D]">
						@IconLock("w-8 h-8")
					</div>
					<h3 class="font-bold text-lg text-white">Buka Vault Terenkripsi</h3>
					<p class="text-xs text-[#86898B]">Masukkan kata sandi master untuk mengakses berkas rahasia.</p>
				</div>
				
				<form @submit.prevent="$store.drive.unlockVault()" autocomplete="off" class="space-y-4">
					<input 
						type="password" 
						name="vault_password"
						id="vault-password-input"
						autocomplete="current-password"
						x-model="$store.drive.vaultPassword" 
						placeholder="Kata Sandi Master Vault" 
						class="w-full bg-white/[0.04] border border-[#3F4247]/60 text-sm text-white px-4 py-3 rounded-xl focus:outline-none focus:border-[#F5CE0D]/60 focus:bg-white/[0.07] transition-all placeholder-[#86898B]/50"
					/>
					
					<div class="flex gap-3">
						<button 
							type="button"
							@click="$store.drive.showVaultPasswordModal = false" 
							class="flex-1 py-3 bg-white/[0.04] border border-[#3F4247]/60 text-[#86898B] hover:text-white rounded-xl text-sm font-bold transition-all"
						>
							Batal
						</button>
						<button 
							type="submit"
							class="flex-1 py-3 hornetz-btn font-bold text-sm rounded-xl"
						>
							Buka Vault
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Create Folder Modal -->
		<div 
			x-show="$store.drive && $store.drive.showCreateFolderModal" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/80 backdrop-blur-xl flex items-center justify-center z-[100] p-4"
		>
			<div 
				@click.away="$store.drive.showCreateFolderModal = false" 
				class="bg-[#121519]/90 backdrop-blur-2xl border border-[#3F4247]/60 w-full max-w-sm rounded-2xl p-6 shadow-2xl space-y-6"
			>
				<div class="text-center space-y-2">
					<div class="w-16 h-16 mx-auto bg-[#2E3137] border border-[#F5CE0D]/40 rounded-full flex items-center justify-center text-[#F5CE0D]">
						@IconFolderPlus("w-8 h-8")
					</div>
					<h3 class="font-bold text-lg text-white">Buat Folder Baru</h3>
					<p class="text-xs text-[#86898B]">Masukkan nama folder untuk mengelompokkan berkas Anda.</p>
				</div>
				
				<form @submit.prevent="$store.drive.createFolder($store.drive.newFolderName)" autocomplete="off" class="space-y-4">
					<input 
						type="text" 
						name="folder_name"
						id="new-folder-name-input"
						autocomplete="off"
						x-model="$store.drive.newFolderName" 
						placeholder="Nama Folder (misal: Laporan 2026)" 
						class="w-full bg-white/[0.04] border border-[#3F4247]/60 text-sm text-white px-4 py-3 rounded-xl focus:outline-none focus:border-[#F5CE0D]/60 focus:bg-white/[0.07] transition-all placeholder-[#86898B]/50"
					/>
					
					<div class="flex gap-3">
						<button 
							type="button"
							@click="$store.drive.showCreateFolderModal = false; $store.drive.newFolderName = ''" 
							class="flex-1 py-3 bg-white/[0.04] border border-[#3F4247]/60 text-[#86898B] hover:text-white rounded-xl text-sm font-bold transition-all"
						>
							Batal
						</button>
						<button 
							type="submit"
							class="flex-1 py-3 hornetz-btn font-bold text-sm rounded-xl"
						>
							Buat Folder
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Panic Purge Password Modal -->
		<div 
			x-show="$store.drive && $store.drive.showPurgeConfirmModal" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/85 backdrop-blur-xl flex items-center justify-center z-[110] p-4"
		>
			<div 
				@click.away="$store.drive.showPurgeConfirmModal = false" 
				class="bg-[#121519]/95 backdrop-blur-2xl border border-red-500/40 w-full max-w-sm rounded-2xl p-6 shadow-2xl space-y-6"
			>
				<div class="text-center space-y-2">
					<div class="w-16 h-16 mx-auto bg-red-500/10 border border-red-500/30 rounded-full flex items-center justify-center text-red-500 animate-pulse">
						@IconAlertTriangle("w-8 h-8")
					</div>
					<h3 class="font-bold text-lg text-white">Konfirmasi Panic Purge</h3>
					<p class="text-xs text-red-400">PERINGATAN: Seluruh berkas di CAS dan database akan dimusnahkan seketika. Masukkan kata sandi master untuk konfirmasi.</p>
				</div>
				
				<form @submit.prevent="$store.drive.executePanicPurge()" autocomplete="off" class="space-y-4">
					<input 
						type="password" 
						name="purge_password"
						id="purge-password-input"
						autocomplete="current-password"
						x-model="$store.drive.purgePassword" 
						placeholder="Kata Sandi Master Vault" 
						class="w-full bg-white/[0.04] border border-red-500/30 text-sm text-white px-4 py-3 rounded-xl focus:outline-none focus:border-red-500 transition-all placeholder-[#86898B]/50"
					/>
					
					<div class="flex gap-3">
						<button 
							type="button"
							@click="$store.drive.showPurgeConfirmModal = false; $store.drive.purgePassword = ''" 
							class="flex-1 py-3 bg-white/[0.04] border border-[#3F4247]/60 text-[#86898B] hover:text-white rounded-xl text-sm font-bold transition-all"
						>
							Batal
						</button>
						<button 
							type="submit"
							class="flex-1 py-3 bg-red-600 hover:bg-red-700 text-white font-bold text-sm rounded-xl transition-all shadow-lg shadow-red-600/30"
						>
							Musnahkan Data
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Free Download Manager (FDM)-Style Add Download Modal -->
		<div 
			x-show="$store.drive && $store.drive.showAddDownloadModal" 
			x-cloak
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-black/85 backdrop-blur-xl flex items-center justify-center z-[105] p-4"
		>
			<div 
				@click.away="$store.drive.showAddDownloadModal = false" 
				class="bg-[#121519]/95 backdrop-blur-2xl border border-[#3F4247]/70 w-full max-w-lg rounded-2xl p-6 shadow-2xl space-y-5"
			>
				<div class="flex items-center justify-between border-b border-[#3F4247]/40 pb-3">
					<div class="flex items-center gap-2.5">
						<div class="w-9 h-9 rounded-xl bg-[#2E3137] border border-[#F5CE0D]/40 text-[#F5CE0D] flex items-center justify-center">
							@IconDownload("w-5 h-5")
						</div>
						<div>
							<h3 class="font-bold text-base text-white">Unduh dari Tautan</h3>
							<p class="text-[11px] text-[#86898B]">Mendukung Google Drive, GitHub, Dropbox, HuggingFace, Torrent, dan unduhan antrean batch.</p>
						</div>
					</div>
					<button 
						type="button" 
						@click="$store.drive.showAddDownloadModal = false"
						class="text-[#86898B] hover:text-white p-1 rounded-lg transition-colors cursor-pointer"
					>
						@IconX("w-5 h-5")
					</button>
				</div>

				<form @submit.prevent="$store.drive.submitAddDownload()" class="space-y-4">
					<!-- URL Input -->
					<div class="space-y-1.5">
						<div class="flex items-center justify-between text-xs font-mono">
							<span class="font-semibold text-[#EDEBE8]">Alamat URL / Tautan Unduhan / Magnet</span>
							<span class="text-[10px] text-[#86898B]">Multi-baris & pola [01-10]</span>
						</div>
						<textarea 
							x-model="$store.drive.addDownloadInput" 
							@input.debounce.400ms="$store.drive.inspectAddDownloadLink()"
							placeholder="Tempel tautan (misal: releases.ubuntu.com/24.04/ubuntu.iso atau drive.google.com/file/d/...)"
							rows="3"
							required
							class="w-full bg-[#1A1D23] border border-[#3F4247]/70 text-xs text-white px-3.5 py-2.5 rounded-xl font-mono focus:outline-none focus:border-[#F5CE0D]/70 transition-all placeholder-[#86898B]/40 resize-none"
						></textarea>
					</div>

					<!-- Live Preflight Inspection Preview -->
					<div x-show="$store.drive.addDownloadProbing" class="p-3 bg-[#1A1D23]/60 border border-[#3F4247]/50 rounded-xl flex items-center gap-2 text-xs text-[#86898B]">
						<span class="animate-spin text-[#F5CE0D]">
							@IconRefresh("w-4 h-4")
						</span>
						<span class="font-mono text-[11px]">Memeriksa server dan mendeteksi berkas secara cerdas...</span>
					</div>

					<div x-show="$store.drive.addDownloadProbeResult && !$store.drive.addDownloadProbing" class="p-3.5 bg-gradient-to-r from-[#2E3137]/60 to-[#1A1D23]/80 border border-[#F5CE0D]/30 rounded-xl space-y-2">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<span 
									class="text-[9px] px-2 py-0.5 rounded font-mono font-bold uppercase tracking-wider"
									:class="$store.drive.getProviderBadgeClass($store.drive.addDownloadProbeResult ? $store.drive.addDownloadProbeResult.provider : '')"
									x-text="$store.drive.addDownloadProbeResult ? $store.drive.addDownloadProbeResult.provider : 'Direct Link'"
								></span>
								<span x-show="$store.drive.addDownloadProbeResult && $store.drive.addDownloadProbeResult.resumable" class="text-[9px] px-1.5 py-0.5 rounded font-mono bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
									Resumable
								</span>
							</div>
							<span class="text-xs font-mono font-bold text-[#F5CE0D]" x-text="$store.drive.addDownloadProbeResult ? $store.drive.addDownloadProbeResult.formatted_size : '-'"></span>
						</div>
						<div class="text-xs font-semibold text-white truncate" x-text="$store.drive.addDownloadProbeResult ? $store.drive.addDownloadProbeResult.name : ''"></div>
						<div x-show="$store.drive.addDownloadProbeResult && $store.drive.addDownloadProbeResult.is_batch" class="text-[10px] text-[#86898B] font-mono">
							Terdeteksi <span class="text-white font-bold" x-text="$store.drive.addDownloadProbeResult ? $store.drive.addDownloadProbeResult.batch_count : 0"></span> berkas untuk diunduh secara serentak
						</div>
					</div>

					<!-- Filename Override (Optional) -->
					<div class="space-y-1.5" x-show="!$store.drive.addDownloadProbeResult || !$store.drive.addDownloadProbeResult.is_batch">
						<label class="block text-xs font-mono text-[#86898B]">
							Nama Berkas Tujuan (Opsional)
						</label>
						<input 
							type="text" 
							x-model="$store.drive.addDownloadFilename" 
							placeholder="Biarkan kosong untuk menggunakan nama asli dari server"
							class="w-full bg-[#1A1D23] border border-[#3F4247]/60 text-xs text-white px-3.5 py-2 rounded-xl focus:outline-none focus:border-[#F5CE0D]/60 transition-all placeholder-[#86898B]/40"
						/>
					</div>

					<!-- Target Destination Folder Selector -->
					<div class="space-y-1.5">
						<label class="block text-xs font-mono text-[#86898B]">
							Simpan ke Folder
						</label>
						<select 
							x-model="$store.drive.addDownloadTargetFolder"
							class="w-full bg-[#1A1D23] border border-[#3F4247]/60 text-xs text-white px-3 py-2 rounded-xl focus:outline-none focus:border-[#F5CE0D]/60 transition-all"
						>
							<option value="">Drive Utama (Root)</option>
							<template x-for="folder in $store.drive.folders" :key="folder.id">
								<option :value="folder.id" x-text="folder.name"></option>
							</template>
							<option value="f2">Vault Sel Terenkripsi (Perlu Sandi)</option>
						</select>
					</div>

					<!-- Modal Action Buttons -->
					<div class="flex gap-3 pt-2">
						<button 
							type="button"
							@click="$store.drive.showAddDownloadModal = false" 
							class="flex-1 py-2.5 bg-white/[0.04] border border-[#3F4247]/60 text-[#86898B] hover:text-white rounded-xl text-xs font-bold transition-all cursor-pointer"
						>
							Batal
						</button>
						<button 
							type="submit"
							class="flex-1 py-2.5 hornetz-btn font-bold text-xs rounded-xl flex items-center justify-center gap-1.5 cursor-pointer shadow-md"
						>
							@IconDownload("w-3.5 h-3.5")
							<span>Mulai Mengunduh</span>
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Drag & Drop Dropzone Overlay -->
		<div 
			x-show="$store.drive && $store.drive.isDragging" 
			x-cloak 
			style="display: none;"
			x-transition 
			class="fixed inset-0 bg-[#121519]/90 backdrop-blur-md border-4 border-dashed border-[#F5CE0D]/60 flex flex-col items-center justify-center z-50 pointer-events-none space-y-4"
		>
			<div class="w-20 h-20 rounded-2xl bg-[#2E3137] border border-[#F5CE0D]/40 flex items-center justify-center text-[#F5CE0D] animate-bounce">
				@IconUploadCloud("w-10 h-10")
			</div>
			<div class="text-center space-y-1">
				<h2 class="text-xl font-extrabold text-white">Lepaskan Berkas untuk Mengunggah</h2>
				<p class="text-xs font-mono text-[#86898B]">Otomatis dienkripsi dengan AES-256-GCM & deduplikasi CAS</p>
			</div>
		</div>

		<!-- Global Alpine.js Store Initializer -->
		<script>
		document.addEventListener('alpine:init', () => {
			Alpine.store('drive', {
				activeTab: 'storage',
				searchQuery: '',
				viewMode: localStorage.getItem('hornetz_view_mode') || 'grid',
				sortBy: 'created_at',
				sortOrder: 'desc',
				uploadQueue: [],
				isProcessingQueue: false,
				transfers: [],
				isTransferMinimized: false,
				draggedFile: null,
				dragTargetFolderId: null,
				showMoveModal: false,
				fileToMove: null,
				targetMoveFolderId: '',
				allMoveFolders: [],
				expandedMoveFolderIds: [],
				availableMoveFolders: [],
				files: [],
				folders: [],
				selectedFile: null,
				filePreviewText: '',
				filePreviewLoading: false,
				previewCache: {},
				folderHistory: [],
				currentFolderId: '',
				currentFolderName: '',
				isUploading: false,
				_lastPopTime: 0,
				_lastMouseBackTime: 0,
				currentUploadTransferId: null,
				currentUploadXhr: null,
				uploadFileName: '',
				uploadProgress: 0,
				uploadStatusText: 'Status: Processing',
				isVaultUnlocked: false,
				showVaultPasswordModal: false,
				vaultPassword: '',
				showCreateFolderModal: false,
				newFolderName: '',
				showPurgeConfirmModal: false,
				purgePassword: '',
				showSecurityModal: false,
				showAddDownloadModal: false,
				addDownloadInput: '',
				addDownloadTargetFolder: '',
				addDownloadFilename: '',
				addDownloadProbing: false,
				addDownloadProbeResult: null,
				addDownloadProbeError: '',
				isMobileMenuOpen: false,
				isDragging: false,
				dragCounter: 0,
				storageUsedBytes: 0,
				storageUsedText: '0 B',
				storageQuotaText: '-',
				storagePercent: 0,
				currentSpeedText: 'Idle',
				isTransferring: false,
				transferDirection: 'idle',
				transferBytesLoaded: 0,
				transferBytesTotal: 0,
				transferChunkCurrent: 0,
				transferChunkTotal: 0,
				transferEtaText: '-',
				transferWatchdogTimer: null,
				lastProgressTime: 0,
				transferSamples: [],

				formatBytes(bytes) {
					if (bytes === undefined || bytes === null || isNaN(bytes) || bytes <= 0) return '0 B';
					const units = ['B', 'KB', 'MB', 'GB', 'TB'];
					const i = Math.floor(Math.log(bytes) / Math.log(1024));
					const val = (bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 1);
					return `${val} ${units[i]}`;
				},

				formatSpeed(bytesPerSec) {
					if (!bytesPerSec || isNaN(bytesPerSec) || bytesPerSec <= 0) return '0.0 KB/s';
					if (bytesPerSec >= 1024 * 1024) {
						return `${(bytesPerSec / (1024 * 1024)).toFixed(1)} MB/s`;
					}
					return `${(bytesPerSec / 1024).toFixed(1)} KB/s`;
				},

				updateTransferEta(remainingBytes, speedBps) {
					if (!speedBps || speedBps <= 0 || remainingBytes <= 0) {
						this.transferEtaText = '-';
						return;
					}
					const sec = Math.round(remainingBytes / speedBps);
					if (sec < 60) {
						this.transferEtaText = `~${sec}s`;
					} else if (sec < 3600) {
						const mins = Math.floor(sec / 60);
						const s = sec % 60;
						this.transferEtaText = `~${mins}m ${s}s`;
					} else {
						const hrs = Math.floor(sec / 3600);
						const mins = Math.floor((sec % 3600) / 60);
						this.transferEtaText = `~${hrs}h ${mins}m`;
					}
				},

				recordTransferProgress(currentTotalBytesLoaded) {
					if (typeof currentTotalBytesLoaded !== 'number' || isNaN(currentTotalBytesLoaded)) return;
					const now = performance.now();
					this.lastProgressTime = now;
					this.transferBytesLoaded = currentTotalBytesLoaded;

					this.transferSamples.push({ time: now, bytes: currentTotalBytesLoaded });
					// Retain samples within a rolling 2500ms window
					const windowStart = now - 2500;
					while (this.transferSamples.length > 2 && this.transferSamples[0].time < windowStart) {
						this.transferSamples.shift();
					}

					if (this.transferSamples.length >= 2) {
						const oldest = this.transferSamples[0];
						const latest = this.transferSamples[this.transferSamples.length - 1];
						const timeDiffSec = (latest.time - oldest.time) / 1000;
						const bytesDiff = latest.bytes - oldest.bytes;
						if (timeDiffSec >= 0.25 && bytesDiff > 0) {
							const speedBps = bytesDiff / timeDiffSec;
							this.currentSpeedText = this.formatSpeed(speedBps);
							const remainingBytes = Math.max(0, this.transferBytesTotal - currentTotalBytesLoaded);
							this.updateTransferEta(remainingBytes, speedBps);
						}
					}
				},

				startTransferWatchdog() {
					this.stopTransferWatchdog();
					this.lastProgressTime = performance.now();
					this.transferWatchdogTimer = setInterval(() => {
						if (!this.isTransferring) {
							this.stopTransferWatchdog();
							return;
						}
						const now = performance.now();
						const idleTime = now - this.lastProgressTime;
						// Graceful 3.5s stall threshold to accommodate server AES encryption & disk flush latency
						if (idleTime > 3500) {
							if (this.transferDirection === 'upload') {
								this.currentSpeedText = '0.0 KB/s';
								this.transferEtaText = '-';
								this.transferSamples = [];
								if (this.uploadStatusText && !this.uploadStatusText.includes('Gangguan') && !this.uploadStatusText.includes('Gagal')) {
									this.uploadStatusText = 'Status: Menunggu respons server...';
								}
							}
						}
					}, 500);
				},

				stopTransferWatchdog() {
					if (this.transferWatchdogTimer) {
						clearInterval(this.transferWatchdogTimer);
						this.transferWatchdogTimer = null;
					}
				},

				getTransferSummaryText() {
					const active = this.transfers.filter(t => t.status === 'active');
					if (active.length === 0) {
						const completed = this.transfers.filter(t => t.status === 'completed');
						if (completed.length > 0) return `${completed.length} transfer selesai`;
						return 'Tidak ada transfer aktif';
					}
					const activeDownloads = active.filter(t => t.type === 'download').length;
					const activeUploads = active.filter(t => t.type === 'upload').length;
					let parts = [];
					if (activeDownloads > 0) parts.push(`${activeDownloads} unduhan`);
					if (activeUploads > 0) parts.push(`${activeUploads} unggahan`);
					const spd = this.currentSpeedText && this.currentSpeedText !== 'Idle' ? ` • ${this.currentSpeedText}` : '';
					return `${parts.join(', ')} berjalan${spd}`;
				},

				dismissAllTransfers() {
					for (const t of this.transfers) {
						if (t.type === 'download' && (t.status === 'completed' || t.status === 'failed' || t.status === 'cancelled')) {
							fetch(`/api/downloads/${t.id}/dismiss`, {
								method: 'DELETE',
								headers: { 'X-CSRF-Token': this.getCsrfToken() }
							}).catch(() => {});
						}
					}
					this.transfers = [];
					this.saveTransfersToStorage();
				},

				saveTransfersToStorage() {
					try {
						const toSave = this.transfers.slice(0, 15).map(t => ({
							id: t.id,
							type: t.type,
							name: t.name,
							size: t.size,
							progress: t.progress,
							loaded: t.loaded,
							total: t.total,
							speed: t.speed,
							eta: t.eta,
							status: t.status,
							statusText: t.statusText,
							error: t.error,
							folderId: t.folderId,
							createdAt: t.createdAt
						}));
						localStorage.setItem('hornetz_active_transfers', JSON.stringify(toSave));
					} catch(e) {}
				},

				loadTransfersFromStorage() {
					try {
						const raw = localStorage.getItem('hornetz_active_transfers');
						if (raw) {
							const parsed = JSON.parse(raw);
							if (Array.isArray(parsed)) {
								this.transfers = parsed;
							}
						}
					} catch(e) {}
				},

				async syncServerDownloads() {
					if (this._isSyncingDownloads) return;
					this._isSyncingDownloads = true;
					try {
						const res = await fetch('/api/downloads');
						if (!res.ok) return;
						const tasks = await res.json();
						if (!Array.isArray(tasks)) return;

						let hasChanges = false;
						for (const task of tasks) {
							let existing = this.transfers.find(t => t.id === task.id);
							const taskStatus = task.status === 'completed' ? 'completed' 
								: (task.status === 'failed' ? 'failed' 
								: (task.status === 'cancelled' ? 'cancelled' : 'active'));

							const taskTotal = (task.total_bytes !== undefined ? task.total_bytes : task.total) || 0;
							const taskLoaded = (task.downloaded_bytes !== undefined ? task.downloaded_bytes : task.downloaded) || 0;
							const taskName = task.filename || 'Unduhan Jarak Jauh';
							const taskSpeed = task.speed_text || (taskStatus === 'completed' ? 'Idle' : 'Menghubungkan...');
							const taskStatusText = task.status_text || (taskStatus === 'completed' ? 'Selesai' : 'Mengunduh...');

							if (!existing) {
								existing = {
									id: task.id,
									type: 'download',
									name: taskName,
									size: taskTotal,
									progress: task.progress !== undefined ? task.progress : 0,
									loaded: taskLoaded,
									total: taskTotal,
									speed: taskSpeed,
									eta: '-',
									status: taskStatus,
									statusText: taskStatusText,
									error: task.error_message || '',
									folderId: task.folder_id || '',
									createdAt: Date.now()
								};
								this.transfers.unshift(existing);
								hasChanges = true;
							} else {
								if (
									existing.status !== taskStatus ||
									existing.progress !== task.progress ||
									existing.speed !== taskSpeed ||
									existing.loaded !== taskLoaded ||
									existing.total !== taskTotal ||
									existing.name !== taskName ||
									existing.statusText !== taskStatusText
								) {
									existing.status = taskStatus;
									existing.name = taskName;
									existing.progress = task.progress !== undefined ? task.progress : existing.progress;
									existing.loaded = taskLoaded;
									existing.total = taskTotal;
									existing.speed = taskSpeed;
									existing.statusText = taskStatusText;
									existing.error = task.error_message || existing.error;
									hasChanges = true;
								}
							}

							if (task.status === 'completed' && !existing._refreshed) {
								existing._refreshed = true;
								this.fetchFiles();
								this.fetchFolders();
								this.fetchStorageStats();
							}
						}

						// Synchronize top navbar telemetry with active server downloads & uploads
						const activeDownloads = this.transfers.filter(t => t.type === 'download' && t.status === 'active');
						const activeUploads = this.transfers.filter(t => t.type === 'upload' && t.status === 'active');

						if (activeUploads.length > 0) {
							this.isTransferring = true;
							this.transferDirection = 'upload';
						} else if (activeDownloads.length > 0) {
							this.isTransferring = true;
							this.transferDirection = 'download';
							const activeWithSpeed = activeDownloads.find(d => d.speed && d.speed !== 'Menghubungkan...' && d.speed !== 'Idle');
							this.currentSpeedText = activeWithSpeed ? activeWithSpeed.speed : (activeDownloads[0].speed || 'Mengunduh...');
						} else if (!this.isUploading) {
							this.isTransferring = false;
							this.transferDirection = '';
							this.currentSpeedText = 'Idle';
						}

						if (hasChanges) {
							this.saveTransfersToStorage();
						}
					} catch(e) {
						console.warn("Failed to sync server downloads:", e);
					} finally {
						this._isSyncingDownloads = false;
					}
				},

				async cancelTransfer(id) {
					const t = this.transfers.find(x => x.id === id);
					if (!t) return;
					if (t.type === 'download') {
						try {
							await fetch(`/api/downloads/${id}`, {
								method: 'DELETE',
								headers: { 'X-CSRF-Token': this.getCsrfToken() }
							});
						} catch(e) {}
						t.status = 'cancelled';
						t.statusText = 'Dibatalkan';
					} else if (t.type === 'upload') {
						t.status = 'cancelled';
						t.statusText = 'Dibatalkan';
						this.uploadQueue = this.uploadQueue.filter(f => f.transferId !== id);
						if (this.currentUploadTransferId === id && this.currentUploadXhr) {
							try {
								this.currentUploadXhr.abort();
							} catch(e) {}
						}
					}
					this.saveTransfersToStorage();
				},

				async dismissTransfer(id) {
					const t = this.transfers.find(x => x.id === id);
					if (t && t.type === 'download') {
						try {
							await fetch(`/api/downloads/${id}/dismiss`, {
								method: 'DELETE',
								headers: { 'X-CSRF-Token': this.getCsrfToken() }
							});
						} catch(e) {}
					}
					this.transfers = this.transfers.filter(x => x.id !== id);
					this.saveTransfersToStorage();
				},

				clearCompletedTransfers() {
					const completed = this.transfers.filter(x => x.status === 'completed' || x.status === 'failed' || x.status === 'cancelled');
					for (const c of completed) {
						if (c.type === 'download') {
							fetch(`/api/downloads/${c.id}/dismiss`, {
								method: 'DELETE',
								headers: { 'X-CSRF-Token': this.getCsrfToken() }
							}).catch(() => {});
						}
					}
					this.transfers = this.transfers.filter(x => x.status === 'active' || x.status === 'queued');
					this.saveTransfersToStorage();
				},

				updateUrlHistory(push = true) {
					if (!window.history || !window.history.pushState) return;
					const params = new URLSearchParams();
					if (this.activeTab && this.activeTab !== 'storage') {
						params.set('tab', this.activeTab);
					}
					if (this.currentFolderId) {
						params.set('folder', this.currentFolderId);
					}
					const q = params.toString();
					const newUrl = q ? `/app?${q}` : '/app';
					const state = {
						tab: this.activeTab,
						folderId: this.currentFolderId,
						folderName: this.currentFolderName,
						folderHistory: JSON.parse(JSON.stringify(this.folderHistory))
					};
					if (push) {
						window.history.pushState(state, '', newUrl);
					} else {
						window.history.replaceState(state, '', newUrl);
					}
				},

				handlePopState(e) {
					this._lastPopTime = Date.now();
					if (Date.now() - (this._lastMouseBackTime || 0) < 350) {
						return;
					}
					if (e && e.state) {
						const st = e.state;
						this.activeTab = st.tab || 'storage';
						this.currentFolderId = st.folderId || '';
						this.currentFolderName = st.folderName || '';
						this.folderHistory = st.folderHistory || [];
						this.fetchFolders();
						this.fetchFiles();
						this.dismissModals();
					} else {
						const params = new URLSearchParams(window.location.search);
						this.activeTab = params.get('tab') || 'storage';
						this.currentFolderId = params.get('folder') || '';
						this.currentFolderName = '';
						this.folderHistory = [];
						this.fetchFolders();
						this.fetchFiles();
						this.dismissModals();
					}
				},

				handleMouseUp(e) {
					if (e && e.button === 3) {
						e.preventDefault();
						e.stopPropagation();
						const now = Date.now();
						if (now - (this._lastPopTime || 0) < 350) {
							return;
						}
						this._lastMouseBackTime = now;
						if (this.folderHistory && this.folderHistory.length > 1) {
							this.navigateToBreadcrumb(this.folderHistory.length - 2);
						} else if (this.currentFolderId || (this.folderHistory && this.folderHistory.length === 1)) {
							this.clearFolder();
						} else if (this.activeTab !== 'storage') {
							this.setTab('storage');
						}
					}
				},

				handleFileDragStart(event, file) {
					if (!file) return;
					this.draggedFile = file;
					this.isDragging = false;
					this.dragCounter = 0;
					if (event.dataTransfer) {
						event.dataTransfer.setData('application/x-hornetz-file-id', file.id);
						event.dataTransfer.effectAllowed = 'move';
					}
				},

				handleFileDragEnd(event) {
					this.draggedFile = null;
					this.dragTargetFolderId = null;
					this.dragCounter = 0;
					this.isDragging = false;
				},

				handleFolderDragOver(event, folder) {
					if (!folder) return;
					const targetFolder = (folder.id === 'root') ? '' : folder.id;
					if (this.draggedFile && this.draggedFile.folder_id === targetFolder) {
						return;
					}
					event.preventDefault();
					if (event.dataTransfer) {
						event.dataTransfer.dropEffect = 'move';
					}
					this.dragTargetFolderId = folder.id;
				},

				handleFolderDragLeave(event, folder) {
					if (this.dragTargetFolderId === folder.id) {
						this.dragTargetFolderId = null;
					}
				},

				async handleFolderDrop(event, folder) {
					event.preventDefault();
					event.stopPropagation();
					const targetId = (folder && folder.id !== 'root') ? folder.id : '';
					const fileId = (event.dataTransfer && event.dataTransfer.getData('application/x-hornetz-file-id')) || (this.draggedFile ? this.draggedFile.id : null);
					this.draggedFile = null;
					this.dragTargetFolderId = null;
					this.isDragging = false;
					this.dragCounter = 0;

					if (fileId) {
						await this.moveFile(fileId, targetId);
					}
				},

				async openMoveModal(file) {
					if (!file) return;
					this.fileToMove = file;
					this.targetMoveFolderId = file.folder_id || '';
					this.expandedMoveFolderIds = [];
					try {
						const res = await fetch('/api/folders?all=true');
						if (res.ok) {
							this.allMoveFolders = await res.json();
						} else {
							this.allMoveFolders = this.folders ? [...this.folders] : [];
						}
					} catch(e) {
						this.allMoveFolders = this.folders ? [...this.folders] : [];
					}
					// If currently inside a subfolder, expand its ancestor chain so current location is visible in tree
					if (file.folder_id) {
						let cur = this.allMoveFolders.find(f => f.id === file.folder_id);
						while (cur && cur.parent_id && cur.parent_id !== 'root') {
							if (!this.expandedMoveFolderIds.includes(cur.parent_id)) {
								this.expandedMoveFolderIds.push(cur.parent_id);
							}
							cur = this.allMoveFolders.find(f => f.id === cur.parent_id);
						}
					}
					this.showMoveModal = true;
				},

				toggleMoveFolderExpand(folderId, event) {
					if (event) {
						event.preventDefault();
						event.stopPropagation();
					}
					const idx = this.expandedMoveFolderIds.indexOf(folderId);
					if (idx !== -1) {
						this.expandedMoveFolderIds.splice(idx, 1);
					} else {
						this.expandedMoveFolderIds.push(folderId);
					}
				},

				isMoveFolderExpanded(folderId) {
					return this.expandedMoveFolderIds.includes(folderId);
				},

				getMoveTreeNodes() {
					if (!this.allMoveFolders || this.allMoveFolders.length === 0) return [];
					
					const childrenMap = new Map();
					for (const f of this.allMoveFolders) {
						const pid = (f.parent_id && f.parent_id !== 'root') ? f.parent_id : '';
						if (!childrenMap.has(pid)) {
							childrenMap.set(pid, []);
						}
						childrenMap.get(pid).push(f);
					}

					for (const [k, list] of childrenMap.entries()) {
						list.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
					}

					const visibleNodes = [];
					const addChildren = (parentId, level) => {
						const list = childrenMap.get(parentId) || [];
						for (const folder of list) {
							const hasChildren = (childrenMap.get(folder.id) || []).length > 0;
							const isExpanded = this.expandedMoveFolderIds.includes(folder.id);
							visibleNodes.push({
								...folder,
								level: level,
								hasChildren: hasChildren,
								isExpanded: isExpanded
							});
							if (isExpanded && hasChildren) {
								addChildren(folder.id, level + 1);
							}
						}
					};

					addChildren('', 0);
					return visibleNodes;
				},

				getMoveTargetFolderPath() {
					if (!this.targetMoveFolderId) {
						return 'Penyimpanan Utama (Root)';
					}
					const segments = [];
					let cur = (this.allMoveFolders || []).find(f => f.id === this.targetMoveFolderId);
					while (cur) {
						segments.unshift(cur.name);
						cur = (cur.parent_id && cur.parent_id !== 'root') 
							? this.allMoveFolders.find(f => f.id === cur.parent_id) 
							: null;
					}
					return segments.length > 0 ? ('Penyimpanan Utama / ' + segments.join(' / ')) : 'Penyimpanan Utama (Root)';
				},

				async executeMoveFile() {
					if (!this.fileToMove) return;
					const fileId = this.fileToMove.id;
					const targetFolderId = this.targetMoveFolderId;
					if (targetFolderId === (this.fileToMove.folder_id || '')) {
						alert('Berkas sudah berada di folder tujuan yang dipilih.');
						return;
					}
					this.showMoveModal = false;
					await this.moveFile(fileId, targetFolderId);
				},

				async moveFile(fileId, targetFolderId) {
					try {
						const res = await fetch(`/api/files/${fileId}/move`, {
							method: 'PATCH',
							headers: {
								'Content-Type': 'application/json',
								'X-CSRF-Token': this.getCsrfToken()
							},
							body: JSON.stringify({ folder_id: targetFolderId })
						});

						if (res.ok) {
							await this.fetchFiles();
							await this.fetchFolders();
							await this.fetchStorageStats();
							if (this.selectedFile && this.selectedFile.id === fileId) {
								this.selectedFile.folder_id = targetFolderId;
							}
						} else {
							const err = await res.json().catch(() => ({}));
							alert(err.message || 'Gagal memindahkan berkas');
						}
					} catch(e) {
						alert('Gagal memindahkan berkas: ' + e.message);
					}
				},

				init() {
					const params = new URLSearchParams(window.location.search);
					const initialTab = params.get('tab');
					const initialFolder = params.get('folder');
					if (initialTab && ['storage', 'vault', 'recent', 'starred', 'trash'].includes(initialTab)) {
						this.activeTab = initialTab;
					}
					if (initialFolder) {
						this.currentFolderId = initialFolder;
					}

					this.updateUrlHistory(false);
					window.addEventListener('popstate', (e) => this.handlePopState(e));

					this.loadTransfersFromStorage();
					this.syncServerDownloads();

					this.fetchFolders();
					this.fetchFiles();
					this.fetchStorageStats();

					setInterval(() => {
						const hasActiveDownloads = this.transfers.some(t => t.type === 'download' && t.status === 'active');
						if (hasActiveDownloads) {
							this.syncServerDownloads();
						}
					}, 1000);

					try {
						const sse = new EventSource('/sse?topic=nest:user_1');
						let sseThrottleTimer = null;
						sse.onmessage = () => {
							if (!sseThrottleTimer) {
								sseThrottleTimer = setTimeout(() => {
									sseThrottleTimer = null;
									this.syncServerDownloads();
								}, 600);
							}
						};
					} catch(e) {}
				},

				setViewMode(mode) {
					this.viewMode = mode;
					try {
						localStorage.setItem('hornetz_view_mode', mode);
					} catch(e) {}
				},

				setSort(by, order) {
					this.sortBy = by;
					this.sortOrder = order;
					this.fetchFiles();
					this.fetchFolders();
				},

				dismissModals() {
					this.showVaultPasswordModal = false;
					this.showCreateFolderModal = false;
					this.showPurgeConfirmModal = false;
					this.showSecurityModal = false;
					this.showAddDownloadModal = false;
					this.showMoveModal = false;
					this.closeFileModal();
					this.isMobileMenuOpen = false;
				},

				isOfficeFile(file) {
					if (!file) return false;
					const ext = (file.ext || '').toLowerCase();
					const officeExts = ['pptx', 'ppt', 'docx', 'doc', 'xlsx', 'xls', 'odp', 'odt', 'ods'];
					return officeExts.includes(ext) || (file.mime_type && (file.mime_type.includes('presentation') || file.mime_type.includes('wordprocessing') || file.mime_type.includes('spreadsheet') || file.mime_type.includes('msword') || file.mime_type.includes('ms-excel') || file.mime_type.includes('ms-powerpoint')));
				},

				isTextOrCodeFile(file) {
					if (!file || !file.has_preview) return false;
					if (this.isOfficeFile(file)) return false;
					const ext = (file.ext || '').toLowerCase();
					if (ext === 'pdf' || file.mime_type === 'application/pdf') return false;
					if (file.mime_type && (file.mime_type.startsWith('image/') || file.mime_type.startsWith('video/') || file.mime_type.startsWith('audio/'))) return false;
					const textExts = [
						'txt', 'md', 'markdown', 'json', 'xml', 'csv', 'tsv', 'log',
						'html', 'htm', 'css', 'js', 'ts', 'go', 'py', 'sh', 'yaml', 'yml',
						'sql', 'env', 'ini', 'conf', 'toml', 'drawio', 'bkp', 'rs', 'cpp',
						'c', 'h', 'java', 'kt', 'php', 'rb', 'dart', 'vue', 'svelte'
					];
					return textExts.includes(ext) || (file.mime_type && file.mime_type.startsWith('text/'));
				},

				selectFile(file) {
					this.selectedFile = file;
					this.filePreviewText = '';
					this.filePreviewLoading = false;
					if (file && this.isTextOrCodeFile(file)) {
						if (this.previewCache && this.previewCache[file.id]) {
							this.filePreviewText = this.previewCache[file.id];
							return;
						}
						this.filePreviewLoading = true;
						fetch(`/api/files/${file.id}/preview`, {
							headers: { 'Range': 'bytes=0-10000' }
						})
						.then(res => res.text())
						.then(txt => {
							const content = txt || 'Berkas kosong';
							this.filePreviewText = content;
							if (!this.previewCache) this.previewCache = {};
							this.previewCache[file.id] = content;
						})
						.catch(() => {
							this.filePreviewText = 'Tidak dapat memuat konten berkas.';
						})
						.finally(() => {
							this.filePreviewLoading = false;
						});
					}
				},

				closeFileModal() {
					this.selectedFile = null;
					this.filePreviewText = '';
					this.filePreviewLoading = false;
				},

				setTab(tab, pushState = true) {
					this.isMobileMenuOpen = false;
					if (tab === 'vault' && !this.isVaultUnlocked) {
						this.showVaultPasswordModal = true;
						return; // Do not switch to vault tab or load its contents until unlocked
					}
					if (tab !== 'vault' && this.isVaultUnlocked) {
						this.isVaultUnlocked = false; // Synchronously lock UI state immediately
						this.lockVault(); // Automatically lock vault in background when leaving the tab
					}
					this.activeTab = tab;
					this.folderHistory = [];
					this.currentFolderId = '';
					this.currentFolderName = '';
					if (pushState) {
						this.updateUrlHistory(true);
					}
					this.fetchFolders();
					this.fetchFiles();
				},

				openFolder(folder, pushState = true) {
					if (!folder) return;
					const existingIdx = this.folderHistory.findIndex(f => f.id === folder.id);
					if (existingIdx !== -1) {
						this.folderHistory = this.folderHistory.slice(0, existingIdx + 1);
					} else {
						this.folderHistory.push({ id: folder.id, name: folder.name });
					}
					this.currentFolderId = folder.id;
					this.currentFolderName = folder.name;
					if (pushState) {
						this.updateUrlHistory(true);
					}
					this.fetchFiles();
					this.fetchFolders();
				},

				clearFolder(pushState = true) {
					this.folderHistory = [];
					this.currentFolderId = '';
					this.currentFolderName = '';
					if (pushState) {
						this.updateUrlHistory(true);
					}
					this.fetchFiles();
					this.fetchFolders();
				},

				navigateToBreadcrumb(index, pushState = true) {
					if (index < 0 || index >= this.folderHistory.length) return;
					this.folderHistory = this.folderHistory.slice(0, index + 1);
					const target = this.folderHistory[index];
					this.currentFolderId = target.id;
					this.currentFolderName = target.name;
					if (pushState) {
						this.updateUrlHistory(true);
					}
					this.fetchFiles();
					this.fetchFolders();
				},

				clearSearch() {
					this.searchQuery = '';
					this.fetchFiles();
					this.fetchFolders();
				},

				isDownloadLink(str) {
					if (!str || typeof str !== 'string') return false;
					const s = str.trim();
					const lower = s.toLowerCase();
					if (lower.startsWith('http://') || lower.startsWith('https://')) {
						return s.length > 8 && !/\s/.test(s);
					}
					if (lower.startsWith('magnet:?')) {
						return lower.includes('xt=urn:btih:');
					}
					// Only match explicit www. hostnames, avoiding false positives on file subpaths (BUG-UX-21)
					if (/^www\.[a-zA-Z0-9-]+\.[a-zA-Z]{2,}(\/.*)?$/i.test(s) && !/\s/.test(s)) {
						return true;
					}
					return false;
				},

				getLinkType(str) {
					if (!str) return 'direct';
					const s = str.trim();
					if (s.startsWith('magnet:?')) return 'magnet';
					return 'direct';
				},

				getLinkProvider(str) {
					if (!str) return 'Direct Link';
					const s = str.trim().toLowerCase();
					if (s.startsWith('magnet:?') || s.endsWith('.torrent') || s.includes('.torrent?')) return 'BitTorrent';
					if (s.includes('drive.google.com') || s.includes('docs.google.com')) return 'Google Drive';
					if (s.includes('dropbox.com')) return 'Dropbox';
					if (s.includes('github.com')) return 'GitHub';
					if (s.includes('gitlab.com')) return 'GitLab';
					if (s.includes('bitbucket.org')) return 'Bitbucket';
					if (s.includes('huggingface.co')) return 'Hugging Face';
					if (s.includes('onedrive.live.com') || s.includes('1drv.ms')) return 'OneDrive';
					if (s.includes('mediafire.com')) return 'MediaFire';
					if (s.includes('sourceforge.net')) return 'SourceForge';
					if (s.includes('archive.org')) return 'Internet Archive';
					if (s.includes('pastebin.com')) return 'Pastebin';
					return 'Direct Link';
				},

				getProviderBadgeClass(provider) {
					if (!provider) return 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
					const p = provider.toLowerCase();
					if (p.includes('google')) return 'bg-blue-500/20 text-blue-300 border border-blue-500/30';
					if (p.includes('github') || p.includes('git')) return 'bg-slate-500/20 text-slate-200 border border-slate-500/30';
					if (p.includes('dropbox')) return 'bg-sky-500/20 text-sky-300 border border-sky-500/30';
					if (p.includes('hugging')) return 'bg-amber-500/20 text-amber-300 border border-amber-500/30';
					if (p.includes('torrent') || p.includes('swarm') || p.includes('magnet')) return 'bg-purple-500/20 text-purple-300 border border-purple-500/30';
					if (p.includes('onedrive')) return 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30';
					if (p.includes('batch')) return 'bg-yellow-500/20 text-yellow-300 border border-yellow-500/30';
					return 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
				},

				getLinkPreviewName(str) {
					if (!str) return '';
					const s = str.trim();
					if (s.startsWith('magnet:?')) {
						const match = s.match(/[?&]dn=([^&]+)/);
						if (match && match[1]) {
							try {
								return decodeURIComponent(match[1].replace(/\+/g, ' '));
							} catch(e) {
								return match[1];
							}
						}
						const hashMatch = s.match(/xt=urn:btih:([a-zA-Z0-9]+)/i);
						if (hashMatch && hashMatch[1]) {
							return `torrent_${hashMatch[1].slice(0, 8)}.bin`;
						}
						return 'Torrent Magnet';
					}
					// Google Drive link display
					if (s.includes('drive.google.com') || s.includes('docs.google.com')) {
						const m = s.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
						if (m && m[1]) return `GoogleDrive_${m[1].slice(0, 8)}.bin`;
						return 'Google Drive File';
					}
					try {
						const clean = (s.startsWith('http://') || s.startsWith('https://')) ? s : 'https://' + s;
						const u = new URL(clean);
						const pathname = u.pathname;
						const lastPart = pathname.split('/').filter(Boolean).pop();
						if (lastPart) {
							return decodeURIComponent(lastPart);
						}
						return u.hostname;
					} catch(e) {
						return s;
					}
				},

				openAddDownloadModal() {
					this.addDownloadInput = '';
					this.addDownloadTargetFolder = this.currentFolderId || (this.activeTab === 'vault' ? 'f2' : '');
					this.addDownloadFilename = '';
					this.addDownloadProbing = false;
					this.addDownloadProbeResult = null;
					this.addDownloadProbeError = '';
					this.showAddDownloadModal = true;
				},

				async inspectAddDownloadLink() {
					const raw = (this.addDownloadInput || '').trim();
					if (!raw || !this.isDownloadLink(raw)) {
						this.addDownloadProbeResult = null;
						this.addDownloadProbeError = '';
						return;
					}
					this.addDownloadProbing = true;
					this.addDownloadProbeError = '';
					try {
						const res = await fetch('/api/downloads/parse', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'X-CSRF-Token': this.getCsrfToken()
							},
							body: JSON.stringify({ url: raw })
						});
						if (!res.ok) {
							const err = await res.json().catch(() => ({}));
							throw new Error(err.message || 'Gagal memeriksa tautan');
						}
						const data = await res.json();
						this.addDownloadProbeResult = data;
						if (!this.addDownloadFilename && data.name) {
							this.addDownloadFilename = data.name;
						}
					} catch(err) {
						this.addDownloadProbeError = err.message;
					} finally {
						this.addDownloadProbing = false;
					}
				},

				async submitAddDownload() {
					const raw = (this.addDownloadInput || '').trim();
					if (!raw) return;

					if (this.addDownloadTargetFolder === 'f2' && !this.isVaultUnlocked) {
						this.showVaultPasswordModal = true;
						return;
					}

					this.showAddDownloadModal = false;

					if (this.addDownloadProbeResult && this.addDownloadProbeResult.is_batch) {
						await this.startBatchDownload(raw, this.addDownloadTargetFolder);
					} else {
						await this.startDownloadFromLink(raw, this.addDownloadFilename, this.addDownloadTargetFolder);
					}
				},

				async startBatchDownload(inputStr, targetFolder) {
					let targetFolderId = targetFolder || this.currentFolderId;
					if (!targetFolderId && this.activeTab === 'vault') targetFolderId = 'f2';

					this.uploadFileName = 'Batch Downloads';
					this.uploadProgress = 15;
					this.uploadStatusText = 'Status: Menginisiasi antrean unduhan...';
					this.isUploading = true;
					this.isTransferring = true;
					this.transferDirection = 'download';
					this.currentSpeedText = 'Memproses...';

					const batchTransferItem = {
						id: 'batch_' + Date.now(),
						type: 'download',
						name: 'Antrean Unduhan Massal',
						size: 0,
						progress: 15,
						loaded: 0,
						total: 0,
						speed: 'Memproses...',
						eta: '-',
						status: 'active',
						statusText: 'Menginisiasi antrean...',
						error: '',
						folderId: targetFolderId,
						createdAt: Date.now()
					};
					this.transfers.unshift(batchTransferItem);
					this.isTransferMinimized = false;
					this.saveTransfersToStorage();

					try {
						const res = await fetch('/api/downloads/batch', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'X-CSRF-Token': this.getCsrfToken()
							},
							body: JSON.stringify({
								input: inputStr,
								folder_id: targetFolderId
							})
						});

						if (!res.ok) {
							const errData = await res.json().catch(() => ({}));
							throw new Error(errData.message || `Gagal memulai unduhan antrean (HTTP ${res.status})`);
						}

						const data = await res.json();
						const tasks = data.tasks || [];
						if (tasks.length === 0) {
							throw new Error("Tidak ada tugas unduhan yang dibuat");
						}

						this.transfers = this.transfers.filter(t => t.id !== batchTransferItem.id);
						for (const task of tasks) {
							const taskTotal = (task.total_bytes !== undefined ? task.total_bytes : task.total) || 0;
							this.transfers.unshift({
								id: task.id,
								type: 'download',
								name: task.filename || 'Unduhan Berkas',
								size: taskTotal,
								progress: task.progress !== undefined ? task.progress : 10,
								loaded: 0,
								total: taskTotal,
								speed: task.speed_text || 'Menghubungkan...',
								eta: '-',
								status: 'active',
								statusText: task.status_text || 'Menghubungkan...',
								error: '',
								folderId: targetFolderId,
								createdAt: Date.now()
							});
						}
						this.saveTransfersToStorage();
						this.syncServerDownloads();

					} catch (err) {
						console.error("Batch download error:", err);
						batchTransferItem.status = 'failed';
						batchTransferItem.statusText = 'Gagal: ' + err.message;
						batchTransferItem.error = err.message;
						this.saveTransfersToStorage();
					} finally {
						this.isUploading = false;
						const hasActive = this.transfers.some(t => t.status === 'active');
						this.isTransferring = hasActive;
						if (hasActive) {
							this.transferDirection = 'download';
						} else {
							this.transferDirection = '';
							this.currentSpeedText = 'Idle';
						}
					}
				},

				handleSearchSubmit() {
					const s = (this.searchQuery || '').trim().toLowerCase();
					// Only automatically trigger download on Enter if the query is an explicit protocol download link (http/https/magnet).
					// Dotted filenames or general searches safely filter and search files (BUG-UX-21).
					if (s.startsWith('http://') || s.startsWith('https://') || s.startsWith('magnet:?')) {
						this.startDownloadFromLink(this.searchQuery);
					} else {
						this.fetchFiles();
						this.fetchFolders();
					}
				},

				async startDownloadFromLink(link, filenameOverride, folderOverride) {
					if (!link || !this.isDownloadLink(link)) return;
					const cleanLink = link.trim();

					let targetFolderId = folderOverride || this.currentFolderId;
					if (!targetFolderId) {
						targetFolderId = (this.activeTab === 'vault') ? 'f2' : '';
					}

					if (targetFolderId === 'f2' && !this.isVaultUnlocked) {
						this.showVaultPasswordModal = true;
						return;
					}

					const previewName = filenameOverride || this.getLinkPreviewName(cleanLink) || 'Berkas Unduhan';
					this.searchQuery = '';

					const tempId = 'dl_' + Date.now();
					const transferItem = {
						id: tempId,
						type: 'download',
						name: previewName,
						size: 0,
						progress: 10,
						loaded: 0,
						total: 0,
						speed: 'Menghubungkan...',
						eta: '-',
						status: 'active',
						statusText: 'Menginisiasi Unduhan...',
						error: '',
						folderId: targetFolderId,
						createdAt: Date.now()
					};
					this.transfers.unshift(transferItem);
					this.isTransferMinimized = false;
					this.saveTransfersToStorage();

					this.uploadFileName = previewName;
					this.uploadProgress = 10;
					this.uploadStatusText = 'Status: Menginisiasi Unduhan...';
					this.isUploading = true;
					this.isTransferring = true;
					this.transferDirection = 'download';
					this.currentSpeedText = 'Menghubungkan...';

					try {
						const res = await fetch('/api/downloads', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'X-CSRF-Token': this.getCsrfToken()
							},
							body: JSON.stringify({
								url: cleanLink,
								folder_id: targetFolderId,
								filename: filenameOverride || ''
							})
						});

						if (!res.ok) {
							const errData = await res.json().catch(() => ({}));
							throw new Error(errData.message || `Gagal memulai unduhan (HTTP ${res.status})`);
						}

						const task = await res.json();
						transferItem.id = task.id;
						if (task.filename) {
							transferItem.name = task.filename;
							this.uploadFileName = task.filename;
						}
						const taskTotal = (task.total_bytes !== undefined ? task.total_bytes : task.total) || 0;
						if (taskTotal > 0) {
							transferItem.size = taskTotal;
							transferItem.total = taskTotal;
						}
						this.saveTransfersToStorage();

						// Synchronize and start tracking
						this.syncServerDownloads();

					} catch (err) {
						console.error("Link download error:", err);
						transferItem.status = 'failed';
						transferItem.statusText = 'Gagal: ' + err.message;
						transferItem.error = err.message;
						this.uploadStatusText = 'Status: Gagal - ' + err.message;
						this.saveTransfersToStorage();
					} finally {
						this.isUploading = false;
						const hasActive = this.transfers.some(t => t.status === 'active');
						this.isTransferring = hasActive;
						if (hasActive) {
							this.transferDirection = 'download';
						} else {
							this.transferDirection = '';
							this.currentSpeedText = 'Idle';
						}
					}
				},

				async fetchFiles() {
					try {
						const url = `/api/files?tab=${this.activeTab}&q=${encodeURIComponent(this.searchQuery)}&folder_id=${encodeURIComponent(this.currentFolderId)}&sort_by=${this.sortBy}&order=${this.sortOrder}`;
						const res = await fetch(url);
						if (res.ok) {
							this.files = await res.json();
						}
					} catch(e) {
						console.error("Fetch files error:", e);
					}
				},

				async fetchFolders() {
					try {
						const url = `/api/folders?tab=${this.activeTab}&parent_id=${encodeURIComponent(this.currentFolderId)}&q=${encodeURIComponent(this.searchQuery)}&sort_by=${encodeURIComponent(this.sortBy)}&order=${encodeURIComponent(this.sortOrder)}`;
						const res = await fetch(url);
						if (res.ok) {
							this.folders = await res.json();
						}
					} catch(e) {
						console.error("Fetch folders error:", e);
					}
				},

				async createFolder(name) {
					if (!name || !name.trim()) return;
					try {
						const res = await fetch('/api/folders', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'X-CSRF-Token': this.getCsrfToken()
							},
							body: JSON.stringify({
								name: name.trim(),
								parent_id: this.currentFolderId || (this.activeTab === 'vault' ? 'f2' : '')
							})
						});
						if (res.ok) {
							this.showCreateFolderModal = false;
							this.newFolderName = '';
							this.fetchFolders();
						} else {
							const data = await res.json().catch(() => ({}));
							alert(data.message || data.error?.message || 'Gagal membuat folder');
						}
					} catch(e) {
						alert('Gagal membuat folder: ' + e.message);
					}
				},

				async fetchStorageStats() {
					try {
						const res = await fetch('/api/storage/stats');
						if (res.ok) {
							const data = await res.json();
							this.storageUsedBytes = data.used_bytes;
							this.storageUsedText = data.used_formatted;
							this.storageQuotaText = data.quota_formatted;
							this.storagePercent = data.percent_used.toFixed(2);
						}
					} catch(e) {
						console.error("Fetch storage stats error:", e);
					}
				},

				async unlockVault() {
					try {
						const res = await fetch('/login', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'X-CSRF-Token': this.getCsrfToken()
							},
							body: JSON.stringify({ password: this.vaultPassword })
						});
						if (res.ok) {
							this.isVaultUnlocked = true;
							this.showVaultPasswordModal = false;
							this.vaultPassword = '';
							this.activeTab = 'vault';
							this.fetchFolders();
							this.fetchFiles();
						} else {
							alert("Password master vault salah!");
						}
					} catch(e) {
						console.error("Unlock vault error:", e);
					}
				},

				async lockVault() {
					this.isVaultUnlocked = false;
					this.files = [];
					this.folders = [];
					this.folderHistory = [];
					this.currentFolderId = '';
					this.currentFolderName = '';
					try {
						await fetch('/api/vault/lock', {
							method: 'POST',
							headers: {
								'X-CSRF-Token': this.getCsrfToken()
							}
						});
					} catch(e) {}
					if (this.activeTab === 'vault') {
						this.setTab('storage');
					}
				},

				getCsrfToken() {
					const match = document.cookie.match(new RegExp('(?:^|; )_csrf=([^;]+)'));
					return match ? decodeURIComponent(match[1]) : '';
				},

				isExternalFileDrag(event) {
					if (this.draggedFile) return false;
					const dt = event && event.dataTransfer;
					if (!dt) return false;
					const types = dt.types ? Array.from(dt.types) : [];
					if (types.includes('application/x-hornetz-file-id')) return false;
					return types.includes('Files');
				},

				handleDragEnter(event) {
					if (!this.isExternalFileDrag(event)) return;
					event.preventDefault();
					this.dragCounter++;
					this.isDragging = true;
				},

				handleDragLeave(event) {
					if (!this.isExternalFileDrag(event)) return;
					event.preventDefault();
					this.dragCounter--;
					if (this.dragCounter <= 0) {
						this.dragCounter = 0;
						this.isDragging = false;
					}
				},

				handleDragOver(event) {
					if (!this.isExternalFileDrag(event)) return;
					event.preventDefault();
					this.isDragging = true;
				},

				async computeSha256(file) {
					if (!window.crypto || !window.crypto.subtle) return null;
					if (file.size > 100 * 1024 * 1024) return null;
					try {
						const buffer = await file.arrayBuffer();
						const hashBuffer = await crypto.subtle.digest('SHA-256', buffer);
						const hashArray = Array.from(new Uint8Array(hashBuffer));
						return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
					} catch(e) {
						console.warn("Client hash compute skipped:", e);
						return null;
					}
				},

				async computeSha256Str(str) {
					if (!window.crypto || !window.crypto.subtle) return "";
					try {
						const buffer = new TextEncoder().encode(str);
						const hashBuffer = await crypto.subtle.digest('SHA-256', buffer);
						const hashArray = Array.from(new Uint8Array(hashBuffer));
						return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
					} catch(e) {
						return "";
					}
				},

				async ensureRemoteFolder(folderName, parentFolderId) {
					if (!folderName || !folderName.trim()) return null;
					const cleanName = folderName.trim();
					const targetParent = parentFolderId || (this.activeTab === 'vault' ? 'f2' : '');
					try {
						const res = await fetch('/api/folders', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'X-CSRF-Token': this.getCsrfToken()
							},
							body: JSON.stringify({
								name: cleanName,
								parent_id: targetParent
							})
						});
						if (res.ok) {
							const data = await res.json();
							await this.fetchFolders();
							return data;
						} else if (res.status === 409) {
							const listRes = await fetch(`/api/folders?tab=${this.activeTab}&parent_id=${encodeURIComponent(targetParent)}`);
							if (listRes.ok) {
								const existingFolders = await listRes.json();
								const found = existingFolders.find(f => f.name === cleanName);
								if (found) return found;
							}
						}
					} catch(e) {
						console.error("Failed to ensure remote folder:", e);
					}
					return null;
				},

				async readAllDirectoryEntries(dirReader) {
					const entries = [];
					const readBatch = async () => {
						const batch = await new Promise((resolve, reject) => dirReader.readEntries(resolve, reject));
						if (batch && batch.length > 0) {
							entries.push(...batch);
							await readBatch();
						}
					};
					await readBatch();
					return entries;
				},

				async traverseFileSystemEntry(entry, parentFolderId, filesCollector) {
					if (!entry) return;
					if (entry.isFile) {
						try {
							const file = await new Promise((resolve, reject) => entry.file(resolve, reject));
							file.targetFolderId = parentFolderId;
							filesCollector.push(file);
						} catch(e) {
							console.error("Error reading file entry:", e);
						}
					} else if (entry.isDirectory) {
						const folderObj = await this.ensureRemoteFolder(entry.name, parentFolderId);
						const folderId = folderObj ? folderObj.id : parentFolderId;
						const dirReader = entry.createReader();
						const childEntries = await this.readAllDirectoryEntries(dirReader);
						for (const child of childEntries) {
							await this.traverseFileSystemEntry(child, folderId, filesCollector);
						}
					}
				},

				queueFileUpload(file, targetFolderId) {
					file.targetFolderId = targetFolderId;
					const tId = 'up-' + Date.now() + '-' + Math.random().toString(36).substr(2, 6);
					file.transferId = tId;
					this.transfers.unshift({
						id: tId,
						name: file.name,
						type: 'upload',
						size: file.size,
						progress: 0,
						loaded: 0,
						total: file.size,
						speed: '-',
						eta: '-',
						status: 'queued',
						statusText: 'Dalam antrean',
						error: '',
						folderId: targetFolderId,
						createdAt: Date.now()
					});
					this.uploadQueue.push(file);
				},

				async handleDrop(event) {
					event.preventDefault();
					this.dragCounter = 0;
					this.isDragging = false;
					const dt = event.dataTransfer;
					if (!dt) return;

					// If dragging internal file, skip OS upload
					if (this.draggedFile || (dt.types && Array.from(dt.types).includes('application/x-hornetz-file-id'))) {
						this.draggedFile = null;
						this.dragTargetFolderId = null;
						return;
					}

					let targetFolderId = this.currentFolderId;
					if (!targetFolderId) {
						targetFolderId = (this.activeTab === 'vault') ? 'f2' : '';
					}

					// 1. Process items using FileSystem Entry API if supported
					if (dt.items && dt.items.length > 0 && typeof dt.items[0].webkitGetAsEntry === 'function') {
						const entries = [];
						for (let i = 0; i < dt.items.length; i++) {
							const entry = dt.items[i].webkitGetAsEntry();
							if (entry) entries.push(entry);
						}

						const filesToUpload = [];
						for (const entry of entries) {
							await this.traverseFileSystemEntry(entry, targetFolderId, filesToUpload);
						}

						if (filesToUpload.length > 0) {
							for (const file of filesToUpload) {
								this.queueFileUpload(file, file.targetFolderId || targetFolderId);
							}
							this.isTransferMinimized = false;
							this.saveTransfersToStorage();
							this.processUploadQueue();
							return;
						}
					}

					// 2. Fallback for dt.files: filter out 0-byte folder placeholders
					if (dt.files && dt.files.length > 0) {
						for (let i = 0; i < dt.files.length; i++) {
							const file = dt.files[i];
							// Reject folder placeholders (0-byte file without extension and empty MIME)
							if (file.size === 0 && !file.type && !file.name.includes('.')) {
								alert(`"${file.name}" terdeteksi sebagai folder. Silakan gunakan tombol "Folder" untuk mengunggah folder beserta isinya.`);
								continue;
							}
							this.queueFileUpload(file, targetFolderId);
						}
						this.isTransferMinimized = false;
						this.saveTransfersToStorage();
						this.processUploadQueue();
					}
				},

				async uploadFile(event) {
					const files = event.target?.files;
					let targetFolderId = this.currentFolderId;
					if (!targetFolderId) {
						targetFolderId = (this.activeTab === 'vault') ? 'f2' : '';
					}
					if (files && files.length > 0) {
						for (let i = 0; i < files.length; i++) {
							this.queueFileUpload(files[i], targetFolderId);
						}
						this.isTransferMinimized = false;
						this.saveTransfersToStorage();
						this.processUploadQueue();
					}
					if (event.target) {
						event.target.value = "";
					}
				},

				async uploadFolder(event) {
					const files = event.target?.files;
					if (!files || files.length === 0) return;

					let baseTargetFolderId = this.currentFolderId;
					if (!baseTargetFolderId) {
						baseTargetFolderId = (this.activeTab === 'vault') ? 'f2' : '';
					}

					// Tree-Differential Reconciliation (TDR)
					if (typeof TreeReconciler !== 'undefined') {
						try {
							this.uploadStatusText = 'Status: Rekonsiliasi Pohon Berkas...';
							const localTree = await TreeReconciler.buildMerkleTree(files);
							if (localTree) {
								const reconcileRes = await fetch('/api/reconcile/tree-diff', {
									method: 'POST',
									headers: {
										'Content-Type': 'application/json',
										'X-CSRF-Token': this.getCsrfToken()
									},
									body: JSON.stringify({
										target_folder_id: baseTargetFolderId,
										root_name: localTree.name,
										tree: localTree
									})
								});

								if (reconcileRes.ok) {
									const plan = await reconcileRes.json();

									// If entire root folder is already 100% synchronized
									if (plan.root_synced) {
										this.uploadStatusText = 'Status: Selesai (100% Tersinkronisasi)';
										await this.fetchFiles();
										await this.fetchFolders();
										await this.fetchStorageStats();
										if (event.target) event.target.value = "";
										return;
									}

									// If differential plan is ready, queue only missing or resumable files
									const fileMap = TreeReconciler.buildFileLookupMap(files);
									let filesQueued = 0;

									for (const action of (plan.actions || [])) {
										if (action.action === 'SKIP') {
											continue;
										}

										const f = fileMap.get(action.path) || fileMap.get(action.name);
										if (f) {
											if (action.action === 'RESUME') {
												f.resumeSessionId = action.session_id;
												f.resumeUploadedBytes = action.uploaded_bytes;
											}
											this.queueFileUpload(f, action.target_folder_id || plan.root_folder_id || baseTargetFolderId);
											filesQueued++;
										}
									}

									await this.fetchFolders();
									if (filesQueued > 0) {
										this.isTransferMinimized = false;
										this.saveTransfersToStorage();
										this.processUploadQueue();
									} else {
										await this.fetchFiles();
										await this.fetchStorageStats();
									}
									if (event.target) event.target.value = "";
									return;
								}
							}
						} catch (reconcileErr) {
							console.warn('Tree reconciliation failed, falling back to sequential traversal:', reconcileErr);
						}
					}

					// Fallback to sequential folder traversal if TDR unavailable
					const folderCache = new Map();
					folderCache.set("", baseTargetFolderId);

					for (let i = 0; i < files.length; i++) {
						const file = files[i];
						const relativePath = file.webkitRelativePath || file.name;
						const segments = relativePath.split('/');

						let currentParentId = baseTargetFolderId;
						let accumulatedPath = "";

						for (let s = 0; s < segments.length - 1; s++) {
							const folderSegment = segments[s];
							accumulatedPath = accumulatedPath ? `${accumulatedPath}/${folderSegment}` : folderSegment;

							if (folderCache.has(accumulatedPath)) {
								currentParentId = folderCache.get(accumulatedPath);
							} else {
								const folderObj = await this.ensureRemoteFolder(folderSegment, currentParentId);
								const newId = folderObj ? folderObj.id : currentParentId;
								folderCache.set(accumulatedPath, newId);
								currentParentId = newId;
							}
						}

						this.queueFileUpload(file, currentParentId);
					}

					this.isTransferMinimized = false;
					this.saveTransfersToStorage();
					this.processUploadQueue();
					if (event.target) event.target.value = "";
				},

				async processUploadQueue() {
					if (this.isProcessingQueue) return;
					this.isProcessingQueue = true;
					this.isUploading = true;
					try {
						while (this.uploadQueue.length > 0) {
							const file = this.uploadQueue.shift();
							if (file && file.transferId) {
								const t = this.transfers.find(x => x.id === file.transferId);
								if (t && t.status === 'cancelled') {
									continue;
								}
							}
							await this.executeUpload(file);
						}
						await new Promise(r => setTimeout(r, 600));
					} finally {
						this.stopTransferWatchdog();
						this.transferDirection = 'idle';
						this.isUploading = false;
						this.isTransferring = false;
						this.currentSpeedText = 'Idle';
						this.uploadProgress = 0;
						this.uploadStatusText = 'Status: Processing';
						this.transferBytesLoaded = 0;
						this.transferBytesTotal = 0;
						this.transferChunkCurrent = 0;
						this.transferChunkTotal = 0;
						this.transferEtaText = '-';
						this.transferSamples = [];
						this.isProcessingQueue = false;
					}
				},

				waitForOnline() {
					if (typeof navigator === 'undefined' || !('onLine' in navigator) || navigator.onLine) {
						return Promise.resolve();
					}
					return new Promise(resolve => {
						const handler = () => {
							window.removeEventListener('online', handler);
							resolve();
						};
						window.addEventListener('online', handler);
					});
				},

				async executeUpload(file) {
					if (!file) return;

					let targetFolderId = (file.targetFolderId !== undefined) ? file.targetFolderId : this.currentFolderId;
					if (!targetFolderId) {
						targetFolderId = (this.activeTab === 'vault') ? 'f2' : '';
					}

					let uploadTransfer = null;
					if (file.transferId) {
						uploadTransfer = this.transfers.find(t => t.id === file.transferId);
					}
					if (!uploadTransfer) {
						const tId = file.transferId || ('up-' + Date.now() + '-' + Math.random().toString(36).substr(2, 6));
						uploadTransfer = {
							id: tId,
							name: file.name,
							type: 'upload',
							size: file.size,
							progress: 5,
							loaded: 0,
							total: file.size,
							speed: 'Menghubungkan...',
							eta: '-',
							status: 'active',
							statusText: 'Inisiasi Sesi...',
							error: '',
							folderId: targetFolderId,
							createdAt: Date.now()
						};
						this.transfers.unshift(uploadTransfer);
					} else {
						uploadTransfer.status = 'active';
						uploadTransfer.statusText = 'Inisiasi Sesi...';
						uploadTransfer.progress = 5;
						uploadTransfer.speed = 'Menghubungkan...';
					}
					this.currentUploadTransferId = uploadTransfer.id;
					this.isTransferMinimized = false;
					this.saveTransfersToStorage();

					this.uploadFileName = file.name;
					this.uploadProgress = 5;
					this.uploadStatusText = 'Status: Inisiasi Sesi';
					this.isTransferring = true;
					this.transferDirection = 'upload';
					this.transferBytesLoaded = 0;
					this.transferBytesTotal = file.size;
					this.transferChunkCurrent = 0;
					this.transferChunkTotal = Math.max(1, Math.ceil(file.size / (2 * 1024 * 1024)));
					this.transferEtaText = '-';
					this.transferSamples = [];
					this.currentSpeedText = 'Menghubungkan...';
					this.startTransferWatchdog();
					const uploadStartTime = performance.now();

					let clientCasHash = "";
					if (file.size <= 100 * 1024 * 1024) {
						this.uploadStatusText = 'Status: Menghitung SHA-256';
						uploadTransfer.statusText = 'Menghitung SHA-256...';
						clientCasHash = await this.computeSha256(file) || "";
					}

					try {
						let initData;
						if (file.resumeSessionId && typeof file.resumeUploadedBytes === 'number') {
							initData = {
								session_id: file.resumeSessionId,
								chunk_size: 2 * 1024 * 1024,
								uploaded: file.resumeUploadedBytes,
								status: "incomplete",
								resumed: true
							};
						} else {
							const initPayload = {
								filename: file.name,
								mime_type: file.type || "application/octet-stream",
								size: file.size,
								folder_id: targetFolderId
							};
							if (clientCasHash) {
								initPayload.cas_hash = clientCasHash;
							}

							const initRes = await fetch("/upload/init", {
								method: "POST",
								headers: {
									"Content-Type": "application/json",
									"X-CSRF-Token": this.getCsrfToken()
								},
								body: JSON.stringify(initPayload)
							});

							if (!initRes.ok) {
								const errData = await initRes.json().catch(() => ({}));
								throw new Error(errData.message || `Gagal inisiasi upload (Status HTTP ${initRes.status})`);
							}
							initData = await initRes.json();
						}

						if (initData.status === "challenge_required" && window.crypto && window.crypto.subtle) {
							try {
								const keyData = new TextEncoder().encode(initData.challenge_nonce);
								const key = await window.crypto.subtle.importKey(
									"raw",
									keyData,
									{ name: "HMAC", hash: { name: "SHA-256" } },
									false,
									["sign"]
								);
								const sampleSize = initData.sample_size || 1024;
								const chunks = [];
								let totalLength = 0;
								for (const offset of (initData.offsets || [])) {
									const end = Math.min(offset + sampleSize, file.size);
									const slice = file.slice(offset, end);
									const buf = await slice.arrayBuffer();
									chunks.push(new Uint8Array(buf));
									totalLength += buf.byteLength;
								}
								const combined = new Uint8Array(totalLength);
								let curOff = 0;
								for (const chunk of chunks) {
									combined.set(chunk, curOff);
									curOff += chunk.length;
								}
								const sigBuf = await window.crypto.subtle.sign("HMAC", key, combined);
								const sigArr = Array.from(new Uint8Array(sigBuf));
								const proofHex = sigArr.map(b => b.toString(16).padStart(2, '0')).join('');

								const powRes = await fetch("/upload/verify-pow", {
									method: "POST",
									headers: {
										"Content-Type": "application/json",
										"X-CSRF-Token": this.getCsrfToken()
									},
									body: JSON.stringify({
										cas_hash: initData.cas_hash,
										challenge_nonce: initData.challenge_nonce,
										proof: proofHex,
										filename: file.name,
										mime_type: file.type || "application/octet-stream",
										size: file.size,
										folder_id: targetFolderId
									})
								});
								if (powRes.ok) {
									const powData = await powRes.json();
									if (powData.status === "completed") {
										this.stopTransferWatchdog();
										this.transferSamples = [];
										await this.fetchFiles();
										await this.fetchFolders();
										await this.fetchStorageStats();
										this.uploadProgress = 100;
										this.transferBytesLoaded = file.size;
										this.uploadStatusText = 'Status: Instan (CAS)';
										this.currentSpeedText = 'Instan (CAS)';
										uploadTransfer.progress = 100;
										uploadTransfer.loaded = file.size;
										uploadTransfer.status = 'completed';
										uploadTransfer.statusText = 'Instan (CAS)';
										uploadTransfer.speed = 'Instan (CAS)';
										uploadTransfer.eta = '0s';
										this.saveTransfersToStorage();
										await new Promise(r => setTimeout(r, 600));
										return;
									}
								}
							} catch (powErr) {
								console.warn("PoW verification failed, falling back to full upload:", powErr);
							}

							// If PoW didn't complete, fallback to standard upload without deduplication
							delete initPayload.cas_hash;
							const fallbackRes = await fetch("/upload/init", {
								method: "POST",
								headers: {
									"Content-Type": "application/json",
									"X-CSRF-Token": this.getCsrfToken()
								},
								body: JSON.stringify(initPayload)
							});
							if (!fallbackRes.ok) {
								const errData = await fallbackRes.json().catch(() => ({}));
								throw new Error(errData.message || `Gagal inisiasi upload fallback (Status HTTP ${fallbackRes.status})`);
							}
							initData = await fallbackRes.json();
						}

						if (initData.status === "completed") {
							this.stopTransferWatchdog();
							this.transferSamples = [];
							await this.fetchFiles();
							await this.fetchFolders();
							await this.fetchStorageStats();
							this.uploadProgress = 100;
							this.transferBytesLoaded = file.size;
							this.uploadStatusText = 'Status: Instan (CAS)';
							this.currentSpeedText = 'Instan (CAS)';
							uploadTransfer.progress = 100;
							uploadTransfer.loaded = file.size;
							uploadTransfer.status = 'completed';
							uploadTransfer.statusText = 'Instan (CAS)';
							uploadTransfer.speed = 'Instan (CAS)';
							uploadTransfer.eta = '0s';
							this.saveTransfersToStorage();
							await new Promise(r => setTimeout(r, 600));
							return;
						}

						const sessionId = initData.session_id;
						let offset = (typeof initData.uploaded === 'number') ? initData.uploaded : 0;
						const totalSize = file.size;
						this.transferBytesLoaded = offset;
						this.transferBytesTotal = totalSize;

						// Chunked upload: 2MB chunks to stay well below 50MB RouteLimit
						const chunkSize = 2 * 1024 * 1024;
						this.transferChunkTotal = Math.max(1, Math.ceil(totalSize / chunkSize));

						if (offset > 0) {
							const resumedPct = Math.min(Math.round((offset / Math.max(totalSize, 1)) * 90) + 5, 95);
							this.uploadProgress = resumedPct;
							this.transferChunkCurrent = Math.min(Math.floor(offset / chunkSize) + 1, this.transferChunkTotal);
							const resumeDisplayPct = Math.round((offset / Math.max(totalSize, 1)) * 100);
							this.uploadStatusText = `Status: Melanjutkan Unggahan chunk ${this.transferChunkCurrent}/${this.transferChunkTotal} (${resumeDisplayPct}%)`;
							this.recordTransferProgress(offset);
						} else {
							this.uploadStatusText = 'Status: Mengunggah';
						}

						let zeroByteDone = false;
						while (offset < totalSize || (totalSize === 0 && !zeroByteDone)) {
							if (uploadTransfer.status === 'cancelled') {
								break;
							}
							const end = Math.min(offset + chunkSize, totalSize);
							const chunk = file.slice(offset, end);
							const currentOffset = offset;
							const currentChunkIndex = Math.min(Math.floor(offset / chunkSize) + 1, this.transferChunkTotal);
							this.transferChunkCurrent = currentChunkIndex;
							this.transferBytesLoaded = offset;
							const currentProgressPercent = Math.min(95, Math.max(5, Math.round((offset / Math.max(totalSize, 1)) * 90) + 5));
							this.uploadProgress = currentProgressPercent;
							const currentDisplayPct = Math.round((offset / Math.max(totalSize, 1)) * 100);
							this.uploadStatusText = `Status: Mengunggah chunk ${currentChunkIndex}/${this.transferChunkTotal} (${currentDisplayPct}%)`;
							uploadTransfer.progress = currentProgressPercent;
							uploadTransfer.loaded = offset;
							uploadTransfer.statusText = `Mengunggah chunk ${currentChunkIndex}/${this.transferChunkTotal} (${currentDisplayPct}%)`;

							let chunkSuccess = false;
							let offsetResynced = false;
							let retryCount = 0;
							const maxRetries = 8;

							while (!chunkSuccess && !offsetResynced) {
								try {
									if (typeof navigator !== 'undefined' && 'onLine' in navigator && !navigator.onLine) {
										this.uploadStatusText = 'Status: Jaringan Terputus, Menunggu Koneksi...';
										this.currentSpeedText = 'Terputus';
										await this.waitForOnline();
									}

									if (retryCount > 0) {
										this.uploadStatusText = `Status: Menghubungkan Kembali (${retryCount}/${maxRetries})...`;
										try {
											const checkRes = await fetch(`/upload/${sessionId}`, {
												headers: { 'X-CSRF-Token': this.getCsrfToken() }
											});
											if (checkRes.ok) {
												const checkData = await checkRes.json();
												if (checkData.status === 'completed') {
													offset = totalSize;
													this.transferBytesLoaded = totalSize;
													this.recordTransferProgress(totalSize);
													chunkSuccess = true;
													break;
												}
												if (typeof checkData.uploaded === 'number' && checkData.uploaded !== currentOffset) {
													offset = checkData.uploaded;
													this.transferBytesLoaded = offset;
													this.recordTransferProgress(offset);
													offsetResynced = true;
													break;
												}
											}
										} catch(checkErr) {
											console.warn("[Hornetz Upload] Gagal memeriksa status sesi upload:", checkErr);
										}
									}

									await new Promise((resolve, reject) => {
										const xhr = new XMLHttpRequest();
										this.currentUploadXhr = xhr;
										xhr.open("PUT", `/upload/${sessionId}`);
										xhr.setRequestHeader("X-CSRF-Token", this.getCsrfToken());
										xhr.setRequestHeader("Content-Type", "application/octet-stream");
										xhr.setRequestHeader("Content-Range", `bytes ${currentOffset}-${end > 0 ? end - 1 : 0}/${totalSize}`);
										xhr.timeout = 25000;

										xhr.upload.onprogress = (event) => {
											if (event.lengthComputable && event.total > 0) {
												const loadedTotal = currentOffset + event.loaded;
												this.recordTransferProgress(Math.min(loadedTotal, totalSize));
												const streamPercent = 5 + Math.round((loadedTotal / Math.max(totalSize, 1)) * 90);
												this.uploadProgress = Math.max(this.uploadProgress, Math.min(streamPercent, 95));
												uploadTransfer.progress = this.uploadProgress;
												uploadTransfer.loaded = Math.min(loadedTotal, totalSize);
												uploadTransfer.speed = this.currentSpeedText;
												uploadTransfer.eta = this.transferEtaText;
												uploadTransfer.statusText = `Mengunggah chunk ${currentChunkIndex}/${this.transferChunkTotal}`;
											}
										};

										xhr.onload = () => {
											this.currentUploadXhr = null;
											if (xhr.status >= 200 && xhr.status < 300) {
												this.recordTransferProgress(end);
												const chunkDonePct = Math.round((end / Math.max(totalSize, 1)) * 100);
												this.uploadStatusText = `Status: Mengunggah chunk ${currentChunkIndex}/${this.transferChunkTotal} (${chunkDonePct}%)`;
												uploadTransfer.progress = this.uploadProgress;
												uploadTransfer.loaded = end;
												uploadTransfer.speed = this.currentSpeedText;
												uploadTransfer.eta = this.transferEtaText;
												resolve(xhr.response);
											} else if (xhr.status === 409) {
												let expectedOffset = null;
												try {
													const errJson = JSON.parse(xhr.responseText);
													if (typeof errJson.expected_offset === 'number') {
														expectedOffset = errJson.expected_offset;
													}
												} catch(e) {}
												if (expectedOffset !== null) {
													offset = expectedOffset;
													this.transferBytesLoaded = offset;
													this.recordTransferProgress(offset);
													offsetResynced = true;
													reject(new Error(`Offset mismatch: server expects ${expectedOffset}`));
													return;
												}
												reject(new Error("Offset mismatch (HTTP 409)"));
											} else {
												let errMsg = `Gagal mengunggah payload berkas (Status HTTP ${xhr.status})`;
												try {
													const errJson = JSON.parse(xhr.responseText);
													if (errJson.message) {
														errMsg = errJson.message;
													} else if (errJson.error && typeof errJson.error === 'object' && errJson.error.message) {
														errMsg = errJson.error.message;
													} else if (typeof errJson.error === 'string') {
														errMsg = errJson.error;
													}
												} catch(e) {}
												reject(new Error(errMsg));
											}
										};

										xhr.onerror = () => { this.currentUploadXhr = null; reject(new Error("Network transfer error during upload")); };
										xhr.ontimeout = () => { this.currentUploadXhr = null; reject(new Error("Network timeout during upload")); };
										xhr.send(chunk);
									});

									chunkSuccess = true;
								} catch (chunkErr) {
									if (offsetResynced) {
										console.info(`[Hornetz Upload] Offset disinkronkan kembali ke ${offset}, memuat ulang chunk...`);
										break;
									}
									retryCount++;
									console.warn(`[Hornetz Upload] Chunk ${currentChunkIndex}/${this.transferChunkTotal} gagal, mencoba lagi (${retryCount}/${maxRetries}). Alasan:`, chunkErr.message);
									if (retryCount >= maxRetries) {
										throw new Error(`Koneksi terputus berulang kali setelah ${maxRetries} percobaan: ${chunkErr.message}`);
									}
									const backoff = Math.min(1000 * Math.pow(1.5, retryCount), 10000);
									this.uploadStatusText = `Status: Gangguan Jaringan, mencoba lagi dlm ${(backoff / 1000).toFixed(0)}s (${retryCount}/${maxRetries})...`;
									this.currentSpeedText = 'Mencoba lagi...';
									await new Promise(r => setTimeout(r, backoff));
								}
							}

							if (chunkSuccess) {
								offset = end;
								this.transferBytesLoaded = offset;
								if (totalSize === 0) zeroByteDone = true;
							}
						}

						this.stopTransferWatchdog();
						this.transferSamples = [];
						const elapsedSec = (performance.now() - uploadStartTime) / 1000;
						const avgSpeedBps = file.size / Math.max(elapsedSec, 0.05);
						this.currentSpeedText = this.formatSpeed(avgSpeedBps);
						this.uploadProgress = 100;
						this.transferBytesLoaded = file.size;
						this.transferEtaText = '0s';
						this.uploadStatusText = 'Status: Selesai';

						uploadTransfer.progress = 100;
						uploadTransfer.loaded = file.size;
						uploadTransfer.status = 'completed';
						uploadTransfer.statusText = 'Selesai';
						uploadTransfer.speed = this.currentSpeedText;
						uploadTransfer.eta = '0s';
						this.saveTransfersToStorage();

						await this.fetchFiles();
						await this.fetchFolders();
						await this.fetchStorageStats();

						await new Promise(r => setTimeout(r, 600));

					} catch (err) {
						console.error("Upload error:", err);
						this.stopTransferWatchdog();
						this.transferSamples = [];
						this.isTransferring = false;
						this.isUploading = false;
						this.transferDirection = 'idle';
						this.uploadProgress = 0;
						this.currentSpeedText = 'Gagal';
						this.uploadStatusText = 'Status: Gagal';
						this.transferEtaText = '-';
						if (uploadTransfer && uploadTransfer.status === 'cancelled') {
							// Cancelled by user, ignore
						} else {
							if (uploadTransfer) {
								uploadTransfer.status = 'failed';
								uploadTransfer.statusText = 'Gagal';
								uploadTransfer.error = err.message || 'Gagal mengunggah berkas';
								this.saveTransfersToStorage();
							}
							alert("Gagal mengunggah berkas: " + err.message);
						}
					} finally {
						this.currentUploadTransferId = null;
						this.currentUploadXhr = null;
					}
				},

				async deleteFile(file, permanent = false) {
					if (!file) return;
					const promptMsg = permanent 
						? `Apakah Anda yakin ingin MENGHAPUS PERMANEN berkas "${file.name}"? Data di CAS akan dimusnahkan.`
						: `Apakah Anda yakin ingin memindahkan berkas "${file.name}" ke Sampah?`;
					if (!confirm(promptMsg)) return;
					try {
						const url = permanent ? `/api/files/${file.id}?permanent=true` : `/api/files/${file.id}`;
						const res = await fetch(url, {
							method: "DELETE",
							headers: {
								"X-CSRF-Token": this.getCsrfToken()
							}
						});
						if (res.ok) {
							this.selectedFile = null;
							this.fetchFiles();
							this.fetchFolders();
							this.fetchStorageStats();
						} else {
							const data = await res.json().catch(() => ({}));
							alert(data.message || data.error?.message || "Gagal menghapus berkas");
						}
					} catch(e) {
						alert("Gagal menghapus berkas: " + e.message);
					}
				},

				async restoreFile(file) {
					if (!file) return;
					try {
						const res = await fetch(`/api/files/${file.id}/restore`, {
							method: "POST",
							headers: {
								"X-CSRF-Token": this.getCsrfToken()
							}
						});
						if (res.ok) {
							this.selectedFile = null;
							this.fetchFiles();
							this.fetchFolders();
							this.fetchStorageStats();
						} else {
							const data = await res.json().catch(() => ({}));
							alert(data.message || data.error?.message || "Gagal memulihkan berkas");
						}
					} catch(e) {
						alert("Gagal memulihkan berkas: " + e.message);
					}
				},

				async toggleStar(file) {
					if (!file) return;
					try {
						const res = await fetch(`/api/files/${file.id}/star`, {
							method: "POST",
							headers: {
								"X-CSRF-Token": this.getCsrfToken()
							}
						});
						if (res.ok) {
							file.is_starred = !file.is_starred;
							this.fetchFiles();
						} else {
							const data = await res.json().catch(() => ({}));
							alert(data.message || data.error?.message || "Gagal mengubah status bintang");
						}
					} catch(e) {
						alert("Gagal mengubah status bintang: " + e.message);
					}
				},

				downloadFile(file, turbo = false) {
					if (!file) return;

					// Accelerate with client-side TurboDownloader if file >= 5MB or turbo explicitly requested
					if ((turbo || (file.size && file.size >= 5 * 1024 * 1024)) && window.TurboDownloader) {
						if (!this._turboClient) {
							this._turboClient = new window.TurboDownloader({ concurrency: 6 });
						}
						this.isTransferring = true;
						this.transferDirection = 'download';
						this.currentSpeedText = 'Turbo Akselerasi (6 thread)...';

						const downloadUrl = `/api/files/${file.id}/download`;
						this._turboClient.startDownload(downloadUrl, file.name || 'file', file.size, {
							onProgress: (p) => {
								this.isTransferring = true;
								this.currentSpeedText = `${p.speed} (${p.threads} thread) [${p.percent}%]`;
							},
							onComplete: () => {
								this.currentSpeedText = 'Selesai!';
								setTimeout(() => {
									this.isTransferring = false;
									this.transferDirection = 'idle';
									this.currentSpeedText = 'Idle';
								}, 2500);
							},
							onError: (err) => {
								console.warn('Turbo download fallback to native:', err);
								const a = document.createElement('a');
								a.href = downloadUrl;
								a.download = file.name || '';
								document.body.appendChild(a);
								a.click();
								a.remove();
								setTimeout(() => {
									this.isTransferring = false;
									this.transferDirection = 'idle';
									this.currentSpeedText = 'Idle';
								}, 2000);
							}
						});
						this.selectedFile = null;
						return;
					}

					// Standard single-stream browser download
					this.isTransferring = true;
					this.transferDirection = 'download';
					this.currentSpeedText = 'Mengunduh...';
					const a = document.createElement('a');
					a.href = `/api/files/${file.id}/download`;
					a.download = file.name || '';
					document.body.appendChild(a);
					a.click();
					a.remove();
					this.selectedFile = null;
					setTimeout(() => {
						this.isTransferring = false;
						this.transferDirection = 'idle';
						this.currentSpeedText = 'Idle';
					}, 2500);
				},

				triggerPanicPurge() {
					this.purgePassword = '';
					this.showPurgeConfirmModal = true;
				},

				async executePanicPurge() {
					if (!this.purgePassword) {
						alert("Kata sandi master wajib diisi!");
						return;
					}
					try {
						const res = await fetch("/api/purge", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"X-CSRF-Token": this.getCsrfToken()
							},
							body: JSON.stringify({ password: this.purgePassword })
						});
						if (!res.ok) {
							const errData = await res.json().catch(() => ({}));
							alert("Gagal melakukan panic purge: " + (errData.message || errData.error?.message || "Kata sandi master salah!"));
							return;
						}
						const data = await res.json().catch(() => ({}));
						this.showPurgeConfirmModal = false;
						this.purgePassword = '';
						alert("PANIC PURGE BERHASIL DIEKSEKUSI!\n\n- Status: " + (data.status || 'purged') + "\n- Pesan: " + (data.message || ''));
						this.fetchFiles();
						this.fetchFolders();
						this.fetchStorageStats();
					} catch(err) {
						alert("Gagal melakukan panic purge: " + err.message);
					}
				},

				async emptyTrash() {
					if (!confirm("Apakah Anda yakin ingin MENGOSONGKAN SAMPAH? Semua berkas di sampah akan dimusnahkan secara permanen.")) return;
					try {
						const res = await fetch("/api/files/trash/empty", {
							method: "DELETE",
							headers: {
								"X-CSRF-Token": this.getCsrfToken()
							}
						});
						if (res.ok) {
							this.fetchFiles();
							this.fetchFolders();
							this.fetchStorageStats();
						} else {
							const data = await res.json().catch(() => ({}));
							alert(data.message || data.error?.message || "Gagal mengosongkan sampah");
						}
					} catch(e) {
						alert("Gagal mengosongkan sampah: " + e.message);
					}
				},

				async deleteFolder(folder) {
					if (!folder) return;
					if (!confirm(`Hapus folder "${folder.name}" beserta isinya?`)) return;
					try {
						const res = await fetch(`/api/folders/${folder.id}`, {
							method: "DELETE",
							headers: {
								"X-CSRF-Token": this.getCsrfToken()
							}
						});
						if (res.ok) {
							if (this.currentFolderId === folder.id) {
								this.clearFolder();
							} else {
								this.fetchFolders();
								this.fetchFiles();
								this.fetchStorageStats();
							}
						} else {
							const data = await res.json().catch(() => ({}));
							alert(data.message || data.error?.message || "Gagal menghapus folder");
						}
					} catch(e) {
						alert("Gagal menghapus folder: " + e.message);
					}
				},

				async renameFolder(folder) {
					if (!folder) return;
					const newName = prompt("Nama baru untuk folder:", folder.name);
					if (!newName || !newName.trim() || newName.trim() === folder.name) return;
					try {
						const res = await fetch(`/api/folders/${folder.id}`, {
							method: "PATCH",
							headers: {
								"Content-Type": "application/json",
								"X-CSRF-Token": this.getCsrfToken()
							},
							body: JSON.stringify({ name: newName.trim() })
						});
						if (res.ok) {
							if (this.currentFolderId === folder.id) {
								this.currentFolderName = newName.trim();
								const crumb = this.folderHistory.find(c => c.id === folder.id);
								if (crumb) crumb.name = newName.trim();
							}
							this.fetchFolders();
							this.fetchFiles();
						} else {
							const data = await res.json().catch(() => ({}));
							alert(data.message || data.error?.message || "Gagal mengubah nama folder");
						}
					} catch(e) {
						alert("Gagal mengubah nama folder: " + e.message);
					}
				},

				async renameFile(file) {
					if (!file) return;
					const newName = prompt("Nama baru untuk berkas:", file.name);
					if (!newName || !newName.trim() || newName.trim() === file.name) return;
					try {
						const res = await fetch(`/api/files/${file.id}`, {
							method: "PATCH",
							headers: {
								"Content-Type": "application/json",
								"X-CSRF-Token": this.getCsrfToken()
							},
							body: JSON.stringify({ name: newName.trim() })
						});
						if (res.ok) {
							if (this.selectedFile && this.selectedFile.id === file.id) {
								this.selectedFile.name = newName.trim();
							}
							this.fetchFiles();
						} else {
							const data = await res.json().catch(() => ({}));
							alert(data.message || data.error?.message || "Gagal mengubah nama berkas");
						}
					} catch(e) {
						alert("Gagal mengubah nama berkas: " + e.message);
					}
				},

				getFileIconSvg(icon, extraClass = 'w-6 h-6') {
					const cls = extraClass;
					const icons = {
						'file-text': '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path>',
						'key': '<circle cx="7.5" cy="15.5" r="5.5"></circle><path d="m21 2-9.6 9.6"></path><path d="m15.5 7.5 3 3L22 7l-3-3"></path>',
						'archive': '<rect width="20" height="5" x="2" y="3" rx="1"></rect><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path><path d="M10 12h4"></path>',
						'image': '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>',
						'video': '<path d="m22 8-6 4 6 4V8Z"></path><rect width="14" height="12" x="2" y="6" rx="2" ry="2"></rect>',
						'music': '<path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle>',
						'code': '<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>',
						'bar-chart-2': '<line x1="18" x2="18" y1="20" y2="10"></line><line x1="12" x2="12" y1="20" y2="4"></line><line x1="6" x2="6" y1="20" y2="14"></line>',
						'file': '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path>'
					};
					const body = icons[icon] || icons['file'];
					return `<svg class="${cls}" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
				}
			});
		});
		</script>
	</body>
	</html>
}
